+CEF_LITE_API CefLiteStatus cef_lite_attach_device(
+    CefLite* ui,
+    SDL_GPUDevice* device,
+    SDL_GPUTextureFormat target_format) {
+  if (ui == nullptr || device == nullptr ||
+      target_format == SDL_GPU_TEXTUREFORMAT_INVALID) {
+    return CEF_LITE_STATUS_INVALID_ARGUMENT;
+  }
+  std::lock_guard lock(ui->gpu_mutex);
+  if (ui->device != nullptr) {
+    return CEF_LITE_STATUS_INVALID_ARGUMENT;
+  }
+  ui->device = device;
+  if (!CreatePipeline(*ui, target_format)) {
+    ReleaseGpuResources(*ui);
+    ui->device = nullptr;
+    return CEF_LITE_STATUS_FAILED;
+  }
+  if (!ui->pending_pixels.empty()) {
+    FalconUiFrame frame{};
+    frame.struct_size = sizeof(frame);
+    frame.version = FALCON_UI_FRAME_VERSION;
+    frame.source = FALCON_UI_FRAME_SOURCE_CPU_PIXELS;
+    frame.format = ui->pending_format;
+    frame.width = ui->pending_width;
+    frame.height = ui->pending_height;
+    frame.stride_bytes = ui->pending_stride;
+    frame.payload = ui->pending_pixels.data();
+    frame.payload_size = ui->pending_pixels.size();
+    ui->frame_status.store(
+        EnsureTexture(*ui, frame) ? UploadReadbackFrame(*ui, frame)
+                                  : FALCON_CEF_UI_STATUS_FAILED);
+    std::vector<uint8_t>().swap(ui->pending_pixels);
+  }
+  return CEF_LITE_STATUS_OK;
+}
