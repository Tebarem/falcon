+#pragma once
+
+#include "include/cef_app.h"
+
+#include <string>
+
+namespace cef_lite_internal {
+
+/* The process's arguments for CefExecuteProcess / CefInitialize: the module
+ * handle on Windows, main's argc/argv (cef_lite_set_main_args) elsewhere. */
+CefMainArgs MainArgs();
+void SetMainArgs(int argc, char** argv);
+
+#if defined(__APPLE__)
+/* macOS loads "Chromium Embedded Framework" at run time (never linked). The
+ * main process finds it in cef/ beside its executable; a helper process
+ * (bin/<Name> Helper*.app/Contents/MacOS/<Name> Helper*) three folders up.
+ * Once per process; false when it isn't there. */
+bool LoadFramework(bool helper);
+/* The framework's folder (settings.framework_dir_path). */
+std::string FrameworkDirectory();
+#endif
+
+}  // namespace cef_lite_internal
