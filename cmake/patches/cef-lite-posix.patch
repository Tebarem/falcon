 namespace {
 
@@ -115,8 +126,87 @@ class SubprocessApp final : public CefApp {
 
 /* The host executable doubles as CEF's helper (renderer, GPU, utility):
  * Chromium relaunches it with --type=..., and it calls this first thing. */
+namespace cef_lite_internal {
+
+namespace {
+int g_argc = 0;
+char** g_argv = nullptr;
+}  // namespace
+
+CefMainArgs MainArgs() {
+#if defined(_WIN32)
+  return CefMainArgs(GetModuleHandleW(nullptr));
+#else
+  return CefMainArgs(g_argc, g_argv);
+#endif
+}
+
+void SetMainArgs(int argc, char** argv) {
+  g_argc = argc;
+  g_argv = argv;
+}
+
+#if defined(__APPLE__)
+namespace {
+
+std::string g_framework_dir;
+
+/* The folder of this process's executable, symbolic links resolved. */
+std::string ExecutableDirectory() {
+  char raw[PATH_MAX * 2] = {};
+  uint32_t size = sizeof(raw);
+  if (_NSGetExecutablePath(raw, &size) != 0) {
+    return {};
+  }
+  char resolved[PATH_MAX] = {};
+  if (realpath(raw, resolved) == nullptr) {
+    return {};
+  }
+  std::string path(resolved);
+  const auto slash = path.rfind('/');
+  return slash == std::string::npos ? std::string() : path.substr(0, slash);
+}
+
+}  // namespace
+
+bool LoadFramework(bool helper) {
+  static bool loaded = false;
+  if (loaded) {
+    return true;
+  }
+  std::string base = ExecutableDirectory();
+  // A helper: <bin>/<Name> Helper.app/Contents/MacOS/<Name> Helper.
+  for (int up = helper ? 3 : 0; up > 0 && !base.empty(); --up) {
+    base = base.substr(0, base.rfind('/'));
+  }
+  if (base.empty()) {
+    return false;
+  }
+  g_framework_dir = base + "/cef/Chromium Embedded Framework.framework";
+  const std::string library = g_framework_dir + "/Chromium Embedded Framework";
+  loaded = cef_load_library(library.c_str()) == 1;
+  return loaded;
+}
+
+std::string FrameworkDirectory() {
+  return g_framework_dir;
+}
+#endif
+
+}  // namespace cef_lite_internal
+
+extern "C" CEF_LITE_API void cef_lite_set_main_args(int argc, char** argv) {
+  cef_lite_internal::SetMainArgs(argc, argv);
+}
+
 extern "C" CEF_LITE_API int cef_lite_run_subprocess(void) {
-  CefMainArgs main_args(GetModuleHandleW(nullptr));
+#if defined(__APPLE__)
+  // A helper process (its own small bundle) loads the framework first.
+  if (!cef_lite_internal::LoadFramework(/*helper=*/true)) {
+    return 1;
+  }
+#endif
+  CefMainArgs main_args = cef_lite_internal::MainArgs();
   CefRefPtr<SubprocessApp> app = new SubprocessApp();
   return CefExecuteProcess(main_args, app, nullptr);
 }
