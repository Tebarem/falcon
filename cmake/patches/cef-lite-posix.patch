diff --git a/src/cef_helper_main.cpp b/src/cef_helper_main.cpp
new file mode 100644
index 0000000..f8a56ae
--- /dev/null
+++ b/src/cef_helper_main.cpp
@@ -0,0 +1,11 @@
+// macOS: Chromium's helper processes run from their own small bundles
+// (<Name> Helper.app, <Name> Helper (GPU).app, ...), beside the host
+// executable. Each is this program: it loads the framework and runs CEF's
+// subprocess. (Windows and Linux relaunch the host executable instead.)
+
+#include "cef_lite.h"
+
+int main(int argc, char** argv) {
+  cef_lite_set_main_args(argc, argv);
+  return cef_lite_run_subprocess();
+}
