+/* UTF-8 to UTF-16 (surrogate pairs above U+FFFF); empty when the text is not
+ * valid UTF-8, as MultiByteToWideChar's MB_ERR_INVALID_CHARS did. */
+std::u16string Utf8ToUtf16(const uint8_t* bytes, uint32_t length) {
+  static constexpr char32_t kMin[4] = {0, 0x80, 0x800, 0x10000};
+  std::u16string out;
+  uint32_t i = 0;
+  while (i < length) {
+    const unsigned char lead = bytes[i];
+    uint32_t count = 0;
+    char32_t code = 0;
+    if (lead < 0x80) {
+      code = lead;
+    } else if ((lead & 0xE0) == 0xC0) {
+      count = 1;
+      code = lead & 0x1F;
+    } else if ((lead & 0xF0) == 0xE0) {
+      count = 2;
+      code = lead & 0x0F;
+    } else if ((lead & 0xF8) == 0xF0) {
+      count = 3;
+      code = lead & 0x07;
+    } else {
+      return {};
+    }
+    if (i + count >= length) {
+      return {};
+    }
+    for (uint32_t k = 1; k <= count; ++k) {
+      const unsigned char next = bytes[i + k];
+      if ((next & 0xC0) != 0x80) {
+        return {};
+      }
+      code = (code << 6) | (next & 0x3F);
+    }
+    if (code < kMin[count] || code > 0x10FFFF ||
+        (code >= 0xD800 && code <= 0xDFFF)) {
+      return {};
+    }
+    if (code >= 0x10000) {
+      code -= 0x10000;
+      out.push_back(static_cast<char16_t>(0xD800 + (code >> 10)));
+      out.push_back(static_cast<char16_t>(0xDC00 + (code & 0x3FF)));
+    } else {
+      out.push_back(static_cast<char16_t>(code));
+    }
+    i += count + 1;
+  }
+  return out;
+}
