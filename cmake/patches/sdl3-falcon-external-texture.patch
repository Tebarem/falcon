diff --git a/SDL/src/gpu/SDL_falcon_gpu.c b/SDL/src/gpu/SDL_falcon_gpu.c
new file mode 100644
--- /dev/null
+++ b/SDL/src/gpu/SDL_falcon_gpu.c
@@ -0,0 +1,27 @@
+/* Falcon-specific SDL_GPU bridge for accelerated CEF UI frames. */
+
+#define SDL_FALCON_GPU_BUILD 1
+
+#include "SDL_internal.h"
+#include "SDL_sysgpu.h"
+
+SDL_FALCON_GPU_API bool SDLCALL SDL_FalconCopyExternalTexture(
+    SDL_GPUDevice *device,
+    SDL_GPUCommandBuffer *commandBuffer,
+    const SDL_FalconExternalTexture *source,
+    SDL_GPUTexture *destination)
+{
+    if (device == NULL) {
+        SDL_SetError("Invalid GPU device");
+        return false;
+    }
+    if (source == NULL || device->CopyExternalTexture == NULL) {
+        SDL_SetError("The selected SDL_GPU backend cannot import this external texture");
+        return false;
+    }
+    return device->CopyExternalTexture(
+        device->driverData,
+        commandBuffer,
+        source,
+        destination);
+}
diff --git a/SDL/src/gpu/metal/SDL_gpu_metal.m b/SDL/src/gpu/metal/SDL_gpu_metal.m
index 44a2319..2cfa891 100644
--- a/SDL/src/gpu/metal/SDL_gpu_metal.m
+++ b/SDL/src/gpu/metal/SDL_gpu_metal.m
@@ -27,4 +27,5 @@
 #include <Metal/Metal.h>
 #include <QuartzCore/CoreAnimation.h>
+#include <IOSurface/IOSurface.h>
 
 #include "../SDL_sysgpu.h"

@@ -4506,1 +4506,73 @@
+static bool METAL_CopyExternalTexture(
+    SDL_GPURenderer *driverData,
+    SDL_GPUCommandBuffer *commandBuffer,
+    const SDL_FalconExternalTexture *source,
+    SDL_GPUTexture *destination)
+{
+    @autoreleasepool {
+        MetalRenderer *renderer = (MetalRenderer *)driverData;
+        MetalCommandBuffer *metalCommandBuffer =
+            (MetalCommandBuffer *)commandBuffer;
+        MetalTextureContainer *destinationContainer =
+            (MetalTextureContainer *)destination;
+        MTLTextureDescriptor *descriptor;
+        id<MTLTexture> sourceTexture;
+        MetalTexture *destinationTexture;
+
+        if (source == NULL || destination == NULL ||
+            source->struct_size < sizeof(*source) ||
+            source->version != SDL_FALCON_EXTERNAL_TEXTURE_VERSION ||
+            source->kind != SDL_FALCON_EXTERNAL_TEXTURE_IOSURFACE ||
+            source->native.handle == NULL || source->plane_count != 0 ||
+            source->width == 0 || source->height == 0 ||
+            source->width > destinationContainer->header.info.width ||
+            source->height > destinationContainer->header.info.height ||
+            source->format != destinationContainer->header.info.format) {
+            SDL_SetError("Invalid IOSurface texture import arguments");
+            return false;
+        }
+
+        descriptor = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:
+            SDLToMetal_TextureFormat(source->format)
+            width:source->width
+            height:source->height
+            mipmapped:NO];
+        descriptor.storageMode = MTLStorageModeShared;
+        descriptor.usage = MTLTextureUsageShaderRead;
+        sourceTexture = [renderer->device newTextureWithDescriptor:descriptor
+            iosurface:(IOSurfaceRef)source->native.handle
+            plane:0];
+        if (sourceTexture == nil) {
+            SDL_SetError("Could not wrap CEF IOSurface as a Metal texture");
+            return false;
+        }
+        destinationTexture = METAL_INTERNAL_PrepareTextureForWrite(
+            renderer,
+            destinationContainer,
+            false);
+        if (metalCommandBuffer->blitEncoder == nil) {
+            metalCommandBuffer->blitEncoder =
+                [metalCommandBuffer->handle blitCommandEncoder];
+        }
+        if (destinationTexture == NULL ||
+            metalCommandBuffer->blitEncoder == nil) {
+            SDL_SetError("Could not create the Metal UI texture copy pass");
+            return false;
+        }
+
+        [metalCommandBuffer->blitEncoder
+            copyFromTexture:sourceTexture
+            sourceSlice:0
+            sourceLevel:0
+            sourceOrigin:MTLOriginMake(0, 0, 0)
+            sourceSize:MTLSizeMake(source->width, source->height, 1)
+            toTexture:destinationTexture->handle
+            destinationSlice:0
+            destinationLevel:0
+            destinationOrigin:MTLOriginMake(0, 0, 0)];
+        METAL_INTERNAL_TrackTexture(metalCommandBuffer, destinationTexture);
+        return true;
+    }
+}
+
 static SDL_GPUDevice *METAL_CreateDevice(bool debugMode, bool preferLowPower, SDL_PropertiesID props)

diff --git a/SDL/include/SDL3/SDL_falcon_gpu.h b/SDL/include/SDL3/SDL_falcon_gpu.h
new file mode 100644
--- /dev/null
+++ b/SDL/include/SDL3/SDL_falcon_gpu.h
@@ -0,0 +1,76 @@
+/*
+  Falcon external-texture import for SDL_GPU.
+
+  This private SDL extension normalizes OS-native CEF frame handles at the
+  SDL_GPU boundary. Platform drivers own the import and GPU copy.
+*/
+
+#ifndef SDL_falcon_gpu_h_
+#define SDL_falcon_gpu_h_
+
+#include <SDL3/SDL_gpu.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SDL_FALCON_EXTERNAL_TEXTURE_VERSION 1u
+#define SDL_FALCON_EXTERNAL_TEXTURE_MAX_PLANES 4u
+#define SDL_FALCON_GPU_PATCH_REVISION 2u
+
+#if defined(SDL_FALCON_GPU_BUILD) && defined(_WIN32)
+#define SDL_FALCON_GPU_API __declspec(dllexport)
+#elif defined(_WIN32)
+#define SDL_FALCON_GPU_API __declspec(dllimport)
+#elif defined(__GNUC__)
+#define SDL_FALCON_GPU_API __attribute__((visibility("default")))
+#else
+#define SDL_FALCON_GPU_API
+#endif
+
+typedef enum SDL_FalconExternalTextureKind {
+    SDL_FALCON_EXTERNAL_TEXTURE_D3D12_SHARED_HANDLE = 1,
+    SDL_FALCON_EXTERNAL_TEXTURE_DMA_BUF = 2,
+    SDL_FALCON_EXTERNAL_TEXTURE_IOSURFACE = 3,
+    SDL_FALCON_EXTERNAL_TEXTURE_ANDROID_HARDWARE_BUFFER = 4
+} SDL_FalconExternalTextureKind;
+
+typedef struct SDL_FalconExternalTexturePlane {
+    intptr_t handle; /* DMA-BUF file descriptor */
+    uint64_t size;
+    uint64_t offset;
+    uint32_t stride;
+    uint32_t reserved;
+} SDL_FalconExternalTexturePlane;
+
+typedef struct SDL_FalconExternalTexture {
+    uint32_t struct_size;
+    uint32_t version;
+    uint32_t kind;
+    uint32_t plane_count;
+    uint32_t width;
+    uint32_t height;
+    SDL_GPUTextureFormat format;
+    uint32_t reserved;
+    uint64_t modifier;
+    union {
+        void *handle; /* Win32 shared handle, IOSurfaceRef, or AHardwareBuffer */
+        SDL_FalconExternalTexturePlane planes[SDL_FALCON_EXTERNAL_TEXTURE_MAX_PLANES];
+    } native;
+} SDL_FalconExternalTexture;
+
+/* Records a native-to-SDL_GPU texture copy in command_buffer. The source
+ * handle/FDs are borrowed and must remain valid until the submitted copy has
+ * completed. Unsupported platform imports fail; there is no CPU fallback. */
+extern SDL_FALCON_GPU_API bool SDLCALL SDL_FalconCopyExternalTexture(
+    SDL_GPUDevice *device,
+    SDL_GPUCommandBuffer *command_buffer,
+    const SDL_FalconExternalTexture *source,
+    SDL_GPUTexture *destination);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SDL_falcon_gpu_h_ */
