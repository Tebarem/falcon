+/* Chromium's resources (paks, locales, icudtl, v8 snapshot) sit next to
+ * libcef.dll, which the host may load from a folder of its own (delay-loaded). */
+std::filesystem::path LibcefDirectory() {
+  HMODULE module = GetModuleHandleW(L"libcef.dll");
+  wchar_t buffer[32768] = {};
+  const DWORD length = module ? GetModuleFileNameW(
+      module, buffer, static_cast<DWORD>(std::size(buffer))) : 0;
+  if (length == 0 || length >= std::size(buffer)) {
+    return {};
+  }
+  return std::filesystem::path(buffer, buffer + length).parent_path();
+}
