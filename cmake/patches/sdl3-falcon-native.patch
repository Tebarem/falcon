+// Falcon native D3D12 access (SDL_falcon_native.h): the application records into the command
+// buffer's own command list between passes, then SDL forgets the state it had bound.
+
+static void *D3D12_FalconD3D12Device(SDL_GPURenderer *driverData)
+{
+    return ((D3D12Renderer *)driverData)->device;
+}
+
+static void *D3D12_FalconBeginD3D12Commands(SDL_GPUCommandBuffer *commandBuffer)
+{
+    return ((D3D12CommandBuffer *)commandBuffer)->graphicsCommandList;
+}
+
+static void *D3D12_FalconD3D12Texture(SDL_GPUCommandBuffer *commandBuffer, SDL_GPUTexture *texture, Uint32 *state)
+{
+    D3D12CommandBuffer *d3d12CommandBuffer = (D3D12CommandBuffer *)commandBuffer;
+    D3D12TextureContainer *container = (D3D12TextureContainer *)texture;
+    D3D12Texture *activeTexture = container->activeTexture;
+
+    D3D12_INTERNAL_TrackTexture(d3d12CommandBuffer, activeTexture);
+    if (state) {
+        *state = (Uint32)D3D12_INTERNAL_DefaultTextureResourceState(container->header.info.usage);
+    }
+    return activeTexture->resource;
+}
+
+static void D3D12_FalconEndD3D12Commands(SDL_GPUCommandBuffer *commandBuffer)
+{
+    D3D12CommandBuffer *d3d12CommandBuffer = (D3D12CommandBuffer *)commandBuffer;
+    Uint32 i;
+
+    // Native work may have set its own heaps; SDL only sets them when it acquires new ones.
+    if (d3d12CommandBuffer->gpuDescriptorHeaps[0] != NULL) {
+        ID3D12DescriptorHeap *heaps[2];
+        heaps[0] = d3d12CommandBuffer->gpuDescriptorHeaps[0]->handle;
+        heaps[1] = d3d12CommandBuffer->gpuDescriptorHeaps[1]->handle;
+        ID3D12GraphicsCommandList_SetDescriptorHeaps(d3d12CommandBuffer->graphicsCommandList, 2, heaps);
+    }
+
+    // Binding a pipeline sets its PSO and root signature and rebinds every resource slot.
+    d3d12CommandBuffer->currentGraphicsPipeline = NULL;
+    d3d12CommandBuffer->currentComputePipeline = NULL;
+    d3d12CommandBuffer->needVertexBufferBind = true;
+    d3d12CommandBuffer->needVertexSamplerBind = true;
+    d3d12CommandBuffer->needVertexStorageTextureBind = true;
+    d3d12CommandBuffer->needVertexStorageBufferBind = true;
+    d3d12CommandBuffer->needFragmentSamplerBind = true;
+    d3d12CommandBuffer->needFragmentStorageTextureBind = true;
+    d3d12CommandBuffer->needFragmentStorageBufferBind = true;
+    d3d12CommandBuffer->needComputeSamplerBind = true;
+    d3d12CommandBuffer->needComputeReadOnlyStorageTextureBind = true;
+    d3d12CommandBuffer->needComputeReadOnlyStorageBufferBind = true;
+    for (i = 0; i < MAX_UNIFORM_BUFFERS_PER_STAGE; i += 1) {
+        d3d12CommandBuffer->needVertexUniformBufferBind[i] = true;
+        d3d12CommandBuffer->needFragmentUniformBufferBind[i] = true;
+        d3d12CommandBuffer->needComputeUniformBufferBind[i] = true;
+    }
+}
