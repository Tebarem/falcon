+// Falcon timestamp queries (SDL_falcon_timestamps.h): a timestamp query heap resolved into a
+// readback buffer that stays in COPY_DEST, so no barriers are needed.
+
+typedef struct D3D12FalconTimestamps
+{
+    ID3D12QueryHeap *heap;
+    ID3D12Resource *readback;
+    Uint32 count;
+} D3D12FalconTimestamps;
+
+static double D3D12_FalconTimestampPeriodNs(SDL_GPURenderer *driverData)
+{
+    D3D12Renderer *renderer = (D3D12Renderer *)driverData;
+    UINT64 frequency = 0;
+    if (FAILED(ID3D12CommandQueue_GetTimestampFrequency(renderer->commandQueue, &frequency)) || frequency == 0) {
+        return 0.0;
+    }
+    return 1e9 / (double)frequency;
+}
+
+static void D3D12_FalconReleaseTimestamps(SDL_GPURenderer *driverData, SDL_FalconTimestamps *timestamps)
+{
+    D3D12FalconTimestamps *t = (D3D12FalconTimestamps *)timestamps;
+    (void)driverData;
+    if (t->heap) {
+        ID3D12QueryHeap_Release(t->heap);
+    }
+    if (t->readback) {
+        ID3D12Resource_Release(t->readback);
+    }
+    SDL_free(t);
+}
+
+static SDL_FalconTimestamps *D3D12_FalconCreateTimestamps(SDL_GPURenderer *driverData, Uint32 count)
+{
+    D3D12Renderer *renderer = (D3D12Renderer *)driverData;
+    D3D12FalconTimestamps *t = (D3D12FalconTimestamps *)SDL_calloc(1, sizeof(D3D12FalconTimestamps));
+    D3D12_QUERY_HEAP_DESC heapDesc;
+    D3D12_HEAP_PROPERTIES heapProperties;
+    D3D12_RESOURCE_DESC desc;
+    HRESULT res;
+
+    if (!t) {
+        return NULL;
+    }
+    t->count = count;
+    heapDesc.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+    heapDesc.Count = count;
+    heapDesc.NodeMask = 0;
+    res = ID3D12Device_CreateQueryHeap(renderer->device, &heapDesc, D3D_GUID(D3D_IID_ID3D12QueryHeap), (void **)&t->heap);
+    if (FAILED(res)) {
+        D3D12_INTERNAL_SetError(renderer, "Could not create timestamp query heap!", res);
+        D3D12_FalconReleaseTimestamps(driverData, (SDL_FalconTimestamps *)t);
+        return NULL;
+    }
+
+    heapProperties.Type = D3D12_HEAP_TYPE_READBACK;
+    heapProperties.CPUPageProperty = D3D12_CPU_PAGE_PROPERTY_UNKNOWN;
+    heapProperties.MemoryPoolPreference = D3D12_MEMORY_POOL_UNKNOWN;
+    heapProperties.CreationNodeMask = 0;
+    heapProperties.VisibleNodeMask = 0;
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    desc.Alignment = D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT;
+    desc.Width = (UINT64)count * sizeof(Uint64);
+    desc.Height = 1;
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = 1;
+    desc.Format = DXGI_FORMAT_UNKNOWN;
+    desc.SampleDesc.Count = 1;
+    desc.SampleDesc.Quality = 0;
+    desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    desc.Flags = D3D12_RESOURCE_FLAG_NONE;
+    res = ID3D12Device_CreateCommittedResource(
+        renderer->device,
+        &heapProperties,
+        D3D12_HEAP_FLAG_NONE,
+        &desc,
+        D3D12_RESOURCE_STATE_COPY_DEST,
+        NULL,
+        D3D_GUID(D3D_IID_ID3D12Resource),
+        (void **)&t->readback);
+    if (FAILED(res)) {
+        D3D12_INTERNAL_SetError(renderer, "Could not create timestamp readback buffer!", res);
+        D3D12_FalconReleaseTimestamps(driverData, (SDL_FalconTimestamps *)t);
+        return NULL;
+    }
+    return (SDL_FalconTimestamps *)t;
+}
+
+static void D3D12_FalconResetTimestamps(SDL_GPUCommandBuffer *commandBuffer, SDL_FalconTimestamps *timestamps)
+{
+    (void)commandBuffer; // timestamp heaps need no reset
+    (void)timestamps;
+}
+
+static void D3D12_FalconWriteTimestamp(SDL_GPUCommandBuffer *commandBuffer, SDL_FalconTimestamps *timestamps, Uint32 index)
+{
+    D3D12CommandBuffer *d3d12CommandBuffer = (D3D12CommandBuffer *)commandBuffer;
+    D3D12FalconTimestamps *t = (D3D12FalconTimestamps *)timestamps;
+    if (index < t->count) {
+        ID3D12GraphicsCommandList_EndQuery(d3d12CommandBuffer->graphicsCommandList, t->heap, D3D12_QUERY_TYPE_TIMESTAMP, index);
+    }
+}
+
+static void D3D12_FalconResolveTimestamps(SDL_GPUCommandBuffer *commandBuffer, SDL_FalconTimestamps *timestamps, Uint32 count)
+{
+    D3D12CommandBuffer *d3d12CommandBuffer = (D3D12CommandBuffer *)commandBuffer;
+    D3D12FalconTimestamps *t = (D3D12FalconTimestamps *)timestamps;
+    ID3D12GraphicsCommandList_ResolveQueryData(
+        d3d12CommandBuffer->graphicsCommandList, t->heap, D3D12_QUERY_TYPE_TIMESTAMP, 0, SDL_min(count, t->count), t->readback, 0);
+}
+
+static bool D3D12_FalconReadTimestamps(SDL_GPURenderer *driverData, SDL_FalconTimestamps *timestamps, Uint32 count, Uint64 *ticks)
+{
+    D3D12Renderer *renderer = (D3D12Renderer *)driverData;
+    D3D12FalconTimestamps *t = (D3D12FalconTimestamps *)timestamps;
+    D3D12_RANGE range;
+    D3D12_RANGE written = { 0, 0 };
+    void *data = NULL;
+    HRESULT res;
+
+    count = SDL_min(count, t->count);
+    range.Begin = 0;
+    range.End = (SIZE_T)count * sizeof(Uint64);
+    res = ID3D12Resource_Map(t->readback, 0, &range, &data);
+    if (FAILED(res)) {
+        D3D12_INTERNAL_SetError(renderer, "Could not map timestamp readback buffer!", res);
+        return false;
+    }
+    SDL_memcpy(ticks, data, (size_t)count * sizeof(Uint64));
+    ID3D12Resource_Unmap(t->readback, 0, &written);
+    return true;
+}
+
