+    result->FalconCreateTimestamps = D3D12_FalconCreateTimestamps;
+    result->FalconReleaseTimestamps = D3D12_FalconReleaseTimestamps;
+    result->FalconResetTimestamps = D3D12_FalconResetTimestamps;
+    result->FalconWriteTimestamp = D3D12_FalconWriteTimestamp;
+    result->FalconResolveTimestamps = D3D12_FalconResolveTimestamps;
