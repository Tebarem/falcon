diff --git a/SDL/include/SDL3/SDL_falcon_timestamps.h b/SDL/include/SDL3/SDL_falcon_timestamps.h
new file mode 100644
index 0000000..1e2b505
--- /dev/null
+++ b/SDL/include/SDL3/SDL_falcon_timestamps.h
@@ -0,0 +1,55 @@
+/*
+  Falcon GPU timestamp queries for SDL_GPU (Direct3D 12 and Vulkan).
+
+  SDL_GPU has no query API. This private extension lets an application time GPU
+  work: create a set of timestamps, reset it at the start of a command buffer,
+  write timestamps between passes, resolve it before submitting, and read the
+  ticks once the command buffer's fence has signaled. Other backends report a
+  period of 0 and every call is a no-op.
+*/
+
+#ifndef SDL_falcon_timestamps_h_
+#define SDL_falcon_timestamps_h_
+
+#include <SDL3/SDL_gpu.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SDL_FALCON_TIMESTAMPS_REVISION 1u
+
+#if defined(SDL_FALCON_TIMESTAMPS_BUILD) && defined(_WIN32)
+#define SDL_FALCON_TIMESTAMPS_API __declspec(dllexport)
+#elif defined(_WIN32)
+#define SDL_FALCON_TIMESTAMPS_API __declspec(dllimport)
+#elif defined(__GNUC__)
+#define SDL_FALCON_TIMESTAMPS_API __attribute__((visibility("default")))
+#else
+#define SDL_FALCON_TIMESTAMPS_API
+#endif
+
+typedef struct SDL_FalconTimestamps SDL_FalconTimestamps;
+
+/* Nanoseconds per tick, or 0 when the device cannot write timestamps. */
+extern SDL_FALCON_TIMESTAMPS_API double SDLCALL SDL_FalconTimestampPeriodNs(SDL_GPUDevice *device);
+
+/* A set of `count` timestamps. NULL (with an error) when unsupported. */
+extern SDL_FALCON_TIMESTAMPS_API SDL_FalconTimestamps *SDLCALL SDL_FalconCreateTimestamps(SDL_GPUDevice *device, Uint32 count);
+/* Only once no submitted command buffer uses the set any more. */
+extern SDL_FALCON_TIMESTAMPS_API void SDLCALL SDL_FalconReleaseTimestamps(SDL_GPUDevice *device, SDL_FalconTimestamps *timestamps);
+
+/* Outside passes, before the first write of a command buffer. */
+extern SDL_FALCON_TIMESTAMPS_API void SDLCALL SDL_FalconResetTimestamps(SDL_GPUCommandBuffer *command_buffer, SDL_FalconTimestamps *timestamps);
+/* The time all preceding GPU work in the command buffer finished. */
+extern SDL_FALCON_TIMESTAMPS_API void SDLCALL SDL_FalconWriteTimestamp(SDL_GPUCommandBuffer *command_buffer, SDL_FalconTimestamps *timestamps, Uint32 index);
+/* Outside passes, after the last write: makes timestamps [0, count) readable. */
+extern SDL_FALCON_TIMESTAMPS_API void SDLCALL SDL_FalconResolveTimestamps(SDL_GPUCommandBuffer *command_buffer, SDL_FalconTimestamps *timestamps, Uint32 count);
+/* After the command buffer's fence signaled: ticks of timestamps [0, count), all written. */
+extern SDL_FALCON_TIMESTAMPS_API bool SDLCALL SDL_FalconReadTimestamps(SDL_GPUDevice *device, SDL_FalconTimestamps *timestamps, Uint32 count, Uint64 *ticks);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SDL_falcon_timestamps_h_ */
diff --git a/SDL/src/gpu/SDL_falcon_timestamps.c b/SDL/src/gpu/SDL_falcon_timestamps.c
new file mode 100644
index 0000000..7f8ddea
--- /dev/null
+++ b/SDL/src/gpu/SDL_falcon_timestamps.c
@@ -0,0 +1,91 @@
+/* Falcon GPU timestamp queries (see SDL_falcon_timestamps.h). Local patch for Falcon Engine,
+   not an SDL contribution. */
+
+#define SDL_FALCON_TIMESTAMPS_BUILD 1
+
+#include "SDL_internal.h"
+#include "SDL_sysgpu.h"
+
+#define FALCON_CB_DEVICE(cb) (((CommandBufferCommonHeader *)(cb))->device)
+
+static bool FalconOutsidePasses(SDL_GPUCommandBuffer *cb)
+{
+    const CommandBufferCommonHeader *h = (const CommandBufferCommonHeader *)cb;
+    if (h->render_pass.in_progress || h->compute_pass.in_progress || h->copy_pass.in_progress) {
+        SDL_SetError("Timestamp reset / resolve must be recorded outside passes");
+        return false;
+    }
+    return true;
+}
+
+SDL_FALCON_TIMESTAMPS_API double SDLCALL SDL_FalconTimestampPeriodNs(SDL_GPUDevice *device)
+{
+    if (device == NULL || device->FalconTimestampPeriodNs == NULL) {
+        return 0.0;
+    }
+    return device->FalconTimestampPeriodNs(device->driverData);
+}
+
+SDL_FALCON_TIMESTAMPS_API SDL_FalconTimestamps *SDLCALL SDL_FalconCreateTimestamps(SDL_GPUDevice *device, Uint32 count)
+{
+    if (device == NULL || count == 0) {
+        SDL_InvalidParamError("device / count");
+        return NULL;
+    }
+    if (device->FalconCreateTimestamps == NULL || SDL_FalconTimestampPeriodNs(device) <= 0.0) {
+        SDL_SetError("The selected SDL_GPU backend cannot write timestamps");
+        return NULL;
+    }
+    return device->FalconCreateTimestamps(device->driverData, count);
+}
+
+SDL_FALCON_TIMESTAMPS_API void SDLCALL SDL_FalconReleaseTimestamps(SDL_GPUDevice *device, SDL_FalconTimestamps *timestamps)
+{
+    if (device != NULL && timestamps != NULL && device->FalconReleaseTimestamps != NULL) {
+        device->FalconReleaseTimestamps(device->driverData, timestamps);
+    }
+}
+
+SDL_FALCON_TIMESTAMPS_API void SDLCALL SDL_FalconResetTimestamps(SDL_GPUCommandBuffer *command_buffer, SDL_FalconTimestamps *timestamps)
+{
+    if (command_buffer == NULL || timestamps == NULL || !FalconOutsidePasses(command_buffer)) {
+        return;
+    }
+    SDL_GPUDevice *device = FALCON_CB_DEVICE(command_buffer);
+    if (device->FalconResetTimestamps != NULL) {
+        device->FalconResetTimestamps(command_buffer, timestamps);
+    }
+}
+
+SDL_FALCON_TIMESTAMPS_API void SDLCALL SDL_FalconWriteTimestamp(SDL_GPUCommandBuffer *command_buffer, SDL_FalconTimestamps *timestamps, Uint32 index)
+{
+    if (command_buffer == NULL || timestamps == NULL) {
+        return;
+    }
+    SDL_GPUDevice *device = FALCON_CB_DEVICE(command_buffer);
+    if (device->FalconWriteTimestamp != NULL) {
+        device->FalconWriteTimestamp(command_buffer, timestamps, index);
+    }
+}
+
+SDL_FALCON_TIMESTAMPS_API void SDLCALL SDL_FalconResolveTimestamps(SDL_GPUCommandBuffer *command_buffer, SDL_FalconTimestamps *timestamps, Uint32 count)
+{
+    if (command_buffer == NULL || timestamps == NULL || count == 0 || !FalconOutsidePasses(command_buffer)) {
+        return;
+    }
+    SDL_GPUDevice *device = FALCON_CB_DEVICE(command_buffer);
+    if (device->FalconResolveTimestamps != NULL) {
+        device->FalconResolveTimestamps(command_buffer, timestamps, count);
+    }
+}
+
+SDL_FALCON_TIMESTAMPS_API bool SDLCALL SDL_FalconReadTimestamps(SDL_GPUDevice *device, SDL_FalconTimestamps *timestamps, Uint32 count, Uint64 *ticks)
+{
+    if (device == NULL || timestamps == NULL || ticks == NULL || count == 0) {
+        return SDL_InvalidParamError("device / timestamps / ticks / count");
+    }
+    if (device->FalconReadTimestamps == NULL) {
+        return SDL_SetError("The selected SDL_GPU backend cannot read timestamps");
+    }
+    return device->FalconReadTimestamps(device->driverData, timestamps, count, ticks);
+}
