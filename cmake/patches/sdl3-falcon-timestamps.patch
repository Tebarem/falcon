+// Falcon timestamp queries (SDL_falcon_timestamps.h): a timestamp query pool, reset in the
+// command buffer and read with vkGetQueryPoolResults once its fence signaled.
+
+typedef struct VulkanFalconTimestamps
+{
+    VkQueryPool pool;
+    Uint32 count;
+} VulkanFalconTimestamps;
+
+static double VULKAN_FalconTimestampPeriodNs(SDL_GPURenderer *driverData)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+    Uint32 familyCount = 0;
+    VkQueueFamilyProperties *families;
+    Uint32 validBits = 0;
+
+    renderer->vkGetPhysicalDeviceQueueFamilyProperties(renderer->physicalDevice, &familyCount, NULL);
+    families = (VkQueueFamilyProperties *)SDL_malloc(sizeof(VkQueueFamilyProperties) * familyCount);
+    if (!families) {
+        return 0.0;
+    }
+    renderer->vkGetPhysicalDeviceQueueFamilyProperties(renderer->physicalDevice, &familyCount, families);
+    if (renderer->queueFamilyIndex < familyCount) {
+        validBits = families[renderer->queueFamilyIndex].timestampValidBits;
+    }
+    SDL_free(families);
+    if (validBits == 0) {
+        return 0.0;
+    }
+    return (double)renderer->physicalDeviceProperties.properties.limits.timestampPeriod;
+}
+
+static void VULKAN_FalconReleaseTimestamps(SDL_GPURenderer *driverData, SDL_FalconTimestamps *timestamps)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+    VulkanFalconTimestamps *t = (VulkanFalconTimestamps *)timestamps;
+    if (t->pool != VK_NULL_HANDLE) {
+        renderer->vkDestroyQueryPool(renderer->logicalDevice, t->pool, NULL);
+    }
+    SDL_free(t);
+}
+
+static SDL_FalconTimestamps *VULKAN_FalconCreateTimestamps(SDL_GPURenderer *driverData, Uint32 count)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+    VulkanFalconTimestamps *t = (VulkanFalconTimestamps *)SDL_calloc(1, sizeof(VulkanFalconTimestamps));
+    VkQueryPoolCreateInfo createInfo;
+    VkResult vulkanResult;
+
+    if (!t) {
+        return NULL;
+    }
+    SDL_zero(createInfo);
+    createInfo.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+    createInfo.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    createInfo.queryCount = count;
+    vulkanResult = renderer->vkCreateQueryPool(renderer->logicalDevice, &createInfo, NULL, &t->pool);
+    if (vulkanResult != VK_SUCCESS) {
+        SDL_free(t);
+        CHECK_VULKAN_ERROR_AND_RETURN(vulkanResult, vkCreateQueryPool, NULL);
+    }
+    t->count = count;
+    return (SDL_FalconTimestamps *)t;
+}
+
+static void VULKAN_FalconResetTimestamps(SDL_GPUCommandBuffer *commandBuffer, SDL_FalconTimestamps *timestamps)
+{
+    VulkanCommandBuffer *vulkanCommandBuffer = (VulkanCommandBuffer *)commandBuffer;
+    VulkanFalconTimestamps *t = (VulkanFalconTimestamps *)timestamps;
+    vulkanCommandBuffer->renderer->vkCmdResetQueryPool(vulkanCommandBuffer->commandBuffer, t->pool, 0, t->count);
+}
+
+static void VULKAN_FalconWriteTimestamp(SDL_GPUCommandBuffer *commandBuffer, SDL_FalconTimestamps *timestamps, Uint32 index)
+{
+    VulkanCommandBuffer *vulkanCommandBuffer = (VulkanCommandBuffer *)commandBuffer;
+    VulkanFalconTimestamps *t = (VulkanFalconTimestamps *)timestamps;
+    if (index < t->count) {
+        vulkanCommandBuffer->renderer->vkCmdWriteTimestamp(
+            vulkanCommandBuffer->commandBuffer, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, t->pool, index);
+    }
+}
+
+static void VULKAN_FalconResolveTimestamps(SDL_GPUCommandBuffer *commandBuffer, SDL_FalconTimestamps *timestamps, Uint32 count)
+{
+    (void)commandBuffer; // read straight from the pool
+    (void)timestamps;
+    (void)count;
+}
+
+static bool VULKAN_FalconReadTimestamps(SDL_GPURenderer *driverData, SDL_FalconTimestamps *timestamps, Uint32 count, Uint64 *ticks)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+    VulkanFalconTimestamps *t = (VulkanFalconTimestamps *)timestamps;
+    VkResult vulkanResult;
+
+    count = SDL_min(count, t->count);
+    vulkanResult = renderer->vkGetQueryPoolResults(
+        renderer->logicalDevice, t->pool, 0, count, (size_t)count * sizeof(Uint64), ticks, sizeof(Uint64),
+        VK_QUERY_RESULT_64_BIT);
+    if (vulkanResult == VK_NOT_READY) {
+        return SDL_SetError("Timestamps are not available yet");
+    }
+    CHECK_VULKAN_ERROR_AND_RETURN(vulkanResult, vkGetQueryPoolResults, false);
+    return true;
+}
+
