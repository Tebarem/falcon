# cmake -DDEP=<name> -P scripts/fetch.cmake: fetches a dependency for this OS where the build
# looks for it (Windows has scripts/fetch-*.ps1 for the rest).
#   slang       the Slang release CMakeLists.txt names (FALCON_SLANG_VERSION), into
#               ~/slang-<version>-<os>-<arch> (the default FALCON_SLANG_ROOT)
#   steamaudio  Valve's Steam Audio 4.8.1 (headers, libphonon.so / .dylib, THIRDPARTY.md) into
#               external/steamaudio (Linux, macOS)
#   steamworks  the Steamworks SDK 1.65's headers and libsteam_api.so / .dylib into
#               external/steamworks, from -DZIP=<steamworks_sdk_165.zip> (it needs a partner
#               login: CI takes it from this repository's "deps" release) (Linux, macOS)
#   cef         the CEF minimal distribution cef-lite builds against, into
#               external/cef-lite/vendor/cef (fetch-cef.ps1 does the same on Windows)

cmake_minimum_required(VERSION 3.25)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

if(DEP STREQUAL "slang")
  file(STRINGS "${root}/CMakeLists.txt" line REGEX "^set\\(FALCON_SLANG_VERSION ")
  string(REGEX REPLACE "^set\\(FALCON_SLANG_VERSION ([^)]+)\\).*" "\\1" version "${line}")
  if(CMAKE_HOST_WIN32)
    set(os windows-x86_64)
    set(home "$ENV{USERPROFILE}")
  elseif(CMAKE_HOST_APPLE)
    set(os macos-aarch64)
    set(home "$ENV{HOME}")
  else()
    cmake_host_system_information(RESULT arch QUERY OS_PLATFORM)
    if(arch MATCHES "aarch64|arm64")
      set(os linux-aarch64)
    else()
      set(os linux-x86_64)
    endif()
    set(home "$ENV{HOME}")
  endif()
  set(dir "${home}/slang-${version}-${os}")
  if(EXISTS "${dir}/include/slang.h")
    message(STATUS "Slang ${version}: ${dir}")
    return()
  endif()
  if(CMAKE_HOST_WIN32)
    set(archive "slang-${version}-${os}.zip")
  else()
    set(archive "slang-${version}-${os}.tar.gz")
  endif()
  set(url "https://github.com/shader-slang/slang/releases/download/v${version}/${archive}")
  set(download "${dir}.download/${archive}")
  message(STATUS "Downloading ${url}")
  file(DOWNLOAD "${url}" "${download}" STATUS status SHOW_PROGRESS)
  list(GET status 0 code)
  if(NOT code EQUAL 0)
    file(REMOVE_RECURSE "${dir}.download")
    message(FATAL_ERROR "Slang download failed: ${status}")
  endif()
  file(ARCHIVE_EXTRACT INPUT "${download}" DESTINATION "${dir}")
  file(REMOVE_RECURSE "${dir}.download")
  if(NOT EXISTS "${dir}/include/slang.h")
    message(FATAL_ERROR "Slang: ${archive} has no include/slang.h")
  endif()
  message(STATUS "Slang ${version}: ${dir}")
elseif(DEP STREQUAL "steamaudio")
  set(out "${root}/external/steamaudio")
  if(CMAKE_HOST_APPLE)
    set(lib osx/libphonon.dylib)
  else()
    set(lib linux-x64/libphonon.so)
  endif()
  get_filename_component(libname "${lib}" NAME)
  if(EXISTS "${out}/include/phonon.h" AND EXISTS "${out}/lib/${libname}")
    message(STATUS "Steam Audio: ${out}")
    return()
  endif()
  set(work "${root}/external/.steamaudio-download")
  file(REMOVE_RECURSE "${work}")
  set(zip "${work}/steamaudio_4.8.1.zip")
  message(STATUS "Downloading steamaudio_4.8.1.zip (181 MB)")
  file(DOWNLOAD "https://github.com/ValveSoftware/steam-audio/releases/download/v4.8.1/steamaudio_4.8.1.zip" "${zip}"
    EXPECTED_HASH SHA256=4a0aa5ec1176f38f0b0993a37c2259d9e86f27e22d5e24f83ec4c3cb9a1d5449 STATUS status)
  list(GET status 0 code)
  if(NOT code EQUAL 0)
    file(REMOVE_RECURSE "${work}")
    message(FATAL_ERROR "Steam Audio download failed: ${status}")
  endif()
  file(ARCHIVE_EXTRACT INPUT "${zip}" DESTINATION "${work}"
    PATTERNS "steamaudio/include/*" "steamaudio/lib/${lib}" steamaudio/THIRDPARTY.md)
  file(MAKE_DIRECTORY "${out}/include" "${out}/lib")
  file(GLOB headers "${work}/steamaudio/include/*.h")
  file(COPY ${headers} DESTINATION "${out}/include")
  file(COPY "${work}/steamaudio/lib/${lib}" DESTINATION "${out}/lib")
  file(COPY "${work}/steamaudio/THIRDPARTY.md" DESTINATION "${out}")
  file(REMOVE_RECURSE "${work}")
  if(CMAKE_HOST_APPLE)
    # Linked: found through the executables' rpath (bin/audio), then signed again (ad hoc).
    execute_process(COMMAND install_name_tool -id @rpath/libphonon.dylib "${out}/lib/libphonon.dylib" COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND codesign --force --sign - "${out}/lib/libphonon.dylib" COMMAND_ERROR_IS_FATAL ANY)
  endif()
  message(STATUS "Steam Audio: ${out}")
elseif(DEP STREQUAL "steamworks")
  set(out "${root}/external/steamworks")
  if(CMAKE_HOST_APPLE)
    set(lib osx/libsteam_api.dylib)
  else()
    set(lib linux64/libsteam_api.so)
  endif()
  get_filename_component(libname "${lib}" NAME)
  if(EXISTS "${out}/include/steam/steam_api_flat.h" AND EXISTS "${out}/lib/${libname}")
    message(STATUS "Steamworks: ${out}")
    return()
  endif()
  if(NOT ZIP OR NOT EXISTS "${ZIP}")
    message(FATAL_ERROR "steamworks: -DZIP=<steamworks_sdk_165.zip> (from partner.steamgames.com)")
  endif()
  set(work "${root}/external/.steamworks-extract")
  file(REMOVE_RECURSE "${work}")
  file(ARCHIVE_EXTRACT INPUT "${ZIP}" DESTINATION "${work}"
    PATTERNS "sdk/public/steam/*" "sdk/redistributable_bin/${lib}" sdk/Readme.txt)
  file(MAKE_DIRECTORY "${out}/include" "${out}/lib")
  file(COPY "${work}/sdk/public/steam" DESTINATION "${out}/include")
  file(COPY "${work}/sdk/redistributable_bin/${lib}" DESTINATION "${out}/lib")
  if(EXISTS "${work}/sdk/Readme.txt")
    file(COPY "${work}/sdk/Readme.txt" DESTINATION "${out}")
  endif()
  file(REMOVE_RECURSE "${work}")
  if(NOT EXISTS "${out}/include/steam/steam_api_flat.h")
    message(FATAL_ERROR "steamworks: ${ZIP} is not the Steamworks SDK")
  endif()
  message(STATUS "Steamworks: ${out}")
elseif(DEP STREQUAL "cef")
  # The same CEF build external/cef-lite/scripts/fetch-cef.ps1 fetches on Windows.
  set(out "${root}/external/cef-lite/vendor/cef")
  if(EXISTS "${out}/cmake/FindCEF.cmake")
    message(STATUS "CEF: ${out}")
    return()
  endif()
  set(build "cef_binary_151.3.24+g2384915+chromium-151.0.7922.174")
  if(CMAKE_HOST_APPLE)
    set(os macosarm64)
    set(sha1 82af2c0cadaafc4ad057f54c14cb3791cc139852)
  elseif(CMAKE_HOST_WIN32)
    set(os windows64)
    set(sha1 19ed00643db89ad6d04903b3bd0adec57627db17)
  else()
    set(os linux64)
    set(sha1 b1e99d3e3ff4213f99f7cda0211db89454398811)
  endif()
  set(archive "${build}_${os}_minimal.tar.bz2")
  string(REPLACE "+" "%2B" url_archive "${archive}")
  set(work "${root}/external/cef-lite/vendor/.cef-download")
  file(REMOVE_RECURSE "${work}")
  message(STATUS "Downloading ${archive}")
  file(DOWNLOAD "https://cef-builds.spotifycdn.com/${url_archive}" "${work}/${archive}"
    EXPECTED_HASH SHA1=${sha1} STATUS status)
  list(GET status 0 code)
  if(NOT code EQUAL 0)
    file(REMOVE_RECURSE "${work}")
    message(FATAL_ERROR "CEF download failed: ${status}")
  endif()
  file(ARCHIVE_EXTRACT INPUT "${work}/${archive}" DESTINATION "${work}")
  file(REMOVE_RECURSE "${out}")
  file(RENAME "${work}/${build}_${os}_minimal" "${out}")
  file(REMOVE_RECURSE "${work}")
  message(STATUS "CEF: ${out}")
else()
  message(FATAL_ERROR "fetch.cmake: -DDEP=slang|steamaudio|steamworks|cef")
endif()
