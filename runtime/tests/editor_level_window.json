// The Level window: closed at first (tests have no saved prefs, so it doesn't open by itself on the first
// level mesh), Ctrl+Shift+L opens it beside the tools with the object mode's sections; a shape's ⚙ sets its sides; Roof is greyed until a wall is selected; the face mode greys what needs chosen faces (the
// hover card says why); search finds Extrude first; icon mode narrows it; dragged by its title it stays
// there; Ctrl+Shift+L closes and opens it again where it was.
[
 {"type": "test.wait", "frames": 20, "ms": 800},
 {"type": "test.newScene", "name": "LevelWindow"},
 {"type": "editor.project.openScene", "scene": "Scenes/LevelWindow.fpak"},
 {"type": "test.wait", "frames": 60, "ms": 1500},
 {"type": "test.wait", "frames": 100000, "build": true},
 {"type": "editor.select", "id": 0},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"levelWindowX": -1}},

 {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "Crate"},
 {"type": "editor.transform.set", "id": "Crate", "position": [0, 0, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
 {"type": "editor.frame", "id": "Crate"},
 {"type": "test.wait", "frames": 60, "ms": 1200},
 {"type": "editor.select", "id": "Crate"},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"levelWindowX": -1, "statusText": "Object · Tab modes · Shift+A create · Shift+1–5 menus · F3 find a command"}},
 {"type": "test.key", "key": "l", "ctrl": true, "shift": true},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.probe", "rects": ["#viewport", "[data-gear=\"Create/Cylinder\"]"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"levelWindowX": 48, "levelWindowY": 8, "levelWindowSections": "create,edit,surface,object,world,place", "levelWindowOff": 1}},
 {"type": "test.capture", "path": "level_window_object.png"},

 {"type": "test.mouse", "at": "[data-gear=\"Create/Cylinder\"]", "action": "down"},
 {"type": "test.mouse", "at": "[data-gear=\"Create/Cylinder\"]", "action": "up"},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.probe", "rects": ["[data-options=\"Create/Cylinder\"] [data-option=\"Sides\"]"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.mouse", "at": "[data-options=\"Create/Cylinder\"] [data-option=\"Sides\"]", "fx": 0.3},
 {"type": "test.wait", "frames": 3, "ms": 200},
 {"type": "test.key", "key": "a", "ctrl": true},
 {"type": "test.type", "text": "12"},
 {"type": "test.key", "key": "Return"},
 {"type": "test.wait", "frames": 10, "ms": 400},
 {"type": "test.key", "key": "Escape"},
 {"type": "test.wait", "frames": 3, "ms": 200},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"option:Create/Cylinder/Sides": 12}},

 {"type": "test.key", "key": "4"},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.probe", "rects": ["#viewport", "[data-command=\"Mesh/Extrude\"]"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "elements": {"mode": "face", "count": 0}, "probe": {"levelWindowOff>": 0}},
 {"type": "test.mouse", "at": "[data-command=\"Mesh/Extrude\"]", "action": "move"},
 {"type": "test.wait", "frames": 10, "ms": 700},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"hoverName": "Extrude", "hoverWhy": "Choose some faces first"}},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.5},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.expect", "elements": {"mode": "face", "count": 1}},

 {"type": "test.probe", "rects": ["#level-window .lw-search"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.mouse", "at": "#level-window .lw-search"},
 {"type": "test.wait", "frames": 3, "ms": 200},
 {"type": "test.type", "text": "extr"},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"levelWindowFirst": "Mesh/Extrude", "levelWindowSections": ""}},
 {"type": "test.key", "key": "Escape"},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.probe", "rects": ["#viewport", "#level-window [data-window-icons]"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"levelWindowRows>": 5}},

 {"type": "test.mouse", "at": "#level-window [data-window-icons]"},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.probe", "rects": ["#viewport", "#level-window [data-window-icons]"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"levelWindowIcons": true, "levelWindowWidth<": 120}},
 {"type": "test.capture", "path": "level_window_icons.png"},
 {"type": "test.mouse", "at": "#level-window [data-window-icons]"},
 {"type": "test.wait", "frames": 5, "ms": 300},

 {"type": "test.probe", "rects": ["#viewport", "#level-window .lw-title"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.mouse", "at": "#level-window .lw-title", "action": "down"},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.6, "fy": 0.2, "action": "move"},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.8, "fy": 0.1, "action": "move"},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.8, "fy": 0.1, "action": "up"},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"levelWindowIcons": false, "levelWindowX>": 200}},
 {"type": "test.key", "key": "l", "ctrl": true, "shift": true},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"levelWindowX": -1}},
 {"type": "test.key", "key": "l", "ctrl": true, "shift": true},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"levelWindowX>": 200}},
 {"type": "test.capture", "path": "level_window_face.png"},
 {"type": "test.exit"}
]
