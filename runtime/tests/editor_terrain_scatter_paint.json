// Editor test: scatter painted by hand. A new layer is painted by hand (its own paint bit,
// nothing grows yet, no cells take slots) and the brush is set to paint it; a stroke (real mouse events) paints it
// and cubes grow there (a pick finds one); generated, it covers the terrain; removing the layer
// clears its paint over the terrain, so a new layer taking the same bit starts empty.
[
  {"type": "test.view", "position": [40, 10, 50], "target": [40, 0, 40]},
  {"type": "editor.tool.set", "tool": "move"},
  {"type": "test.wait", "frames": 20},
  {"type": "editor.terrain.scatter.add", "mesh": "cube", "density": 2},
  {"type": "test.wait", "frames": 30},
  {"type": "test.expect", "terrain": {"exists": true, "scatter": {"layers": 1, "subs": 1, "noCells": true}}},
  {"type": "test.pick", "x": 0.5, "y": 0.5},
  {"type": "test.wait", "frames": 10},
  {"type": "test.expect", "terrain": {"scatter": {"picked": false}}},
  {"type": "test.capture", "path": "scatter_paint_empty.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.tool.set", "tool": "brush"},
  {"type": "editor.terrain.brush", "radius": 5, "falloffPreset": "constant", "noiseMask": 0,
   "slopeMin": 0, "slopeMax": 90, "heightMin": -100000, "heightMax": 100000},
  {"type": "test.probe", "rects": ["#viewport"]},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.5, "action": "move"},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.5, "action": "down"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.5, "action": "up"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "canUndo": true, "terrain": {"atStroke": true, "scatterMask": 0}},
  {"type": "editor.tool.set", "tool": "move"},
  {"type": "test.wait", "frames": 30},
  {"type": "test.pick", "x": 0.5, "y": 0.5},
  {"type": "test.wait", "frames": 10},
  {"type": "test.expect", "terrain": {"scatter": {"picked": true, "cells": true}}},
  {"type": "test.capture", "path": "scatter_paint_painted.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.terrain.scatter.set", "index": 0, "paint": 0},
  {"type": "test.wait", "frames": 30},
  {"type": "test.capture", "path": "scatter_paint_generated.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.terrain.scatter.remove", "index": 0},
  {"type": "test.wait", "frames": 30},
  {"type": "test.expect", "terrain": {"atStroke": true, "scatterMaskClear": 0, "scatter": {"layers": 0}}},
  {"type": "editor.terrain.scatter.add", "mesh": "cube", "density": 2},
  {"type": "test.wait", "frames": 30},
  {"type": "test.pick", "x": 0.5, "y": 0.5},
  {"type": "test.wait", "frames": 10},
  {"type": "test.expect", "terrain": {"scatter": {"layers": 1, "picked": false}}},
  {"type": "test.exit"}
]
