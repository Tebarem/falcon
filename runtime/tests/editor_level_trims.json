// Trim sheets: the starter set made, the trim panel (Alt+T) and a click on its first strip putting
// the chosen face on it (the sheet's material, the strip's rows), undo, T again, a sheet saved and
// used by message.
[
 {
  "type": "test.wait",
  "frames": 20,
  "ms": 800
 },
 {
  "type": "test.newScene",
  "name": "Trims"
 },
 {
  "type": "editor.project.openScene",
  "scene": "Scenes/Trims.fpak"
 },
 {
  "type": "test.wait",
  "frames": 60,
  "ms": 1500
 },
 {
  "type": "test.wait",
  "frames": 100000,
  "build": true
 },
 {
  "type": "test.probe",
  "rects": [
   "#viewport"
  ]
 },
 {
  "type": "test.wait",
  "frames": 2,
  "ms": 200
 },
 {
  "type": "test.mouse",
  "at": "#viewport",
  "action": "move"
 },
 {
  "type": "editor.entity.create",
  "kind": "level",
  "shape": "box",
  "name": "A"
 },
 {
  "type": "editor.transform.set",
  "id": "A",
  "position": [
   0,
   0,
   0
  ],
  "rotation": [
   0,
   0,
   0
  ],
  "scale": [
   1,
   1,
   1
  ]
 },
 {
  "type": "editor.frame",
  "id": "A"
 },
 {
  "type": "test.wait",
  "frames": 60,
  "ms": 1200
 },
 {
  "type": "editor.trim.starter"
 },
 {
  "type": "test.wait",
  "frames": 10,
  "ms": 500
 },
 {
  "type": "editor.tool.set",
  "element": "face"
 },
 {
  "type": "test.mouse",
  "at": "#viewport",
  "fx": 0.5,
  "fy": 0.5
 },
 {
  "type": "test.wait",
  "frames": 5,
  "ms": 100
 },
 {
  "type": "test.expect",
  "elements": {
   "mode": "face",
   "count": 1
  }
 },
 {
  "type": "test.key",
  "key": "T",
  "alt": true
 },
 {
  "type": "test.wait",
  "frames": 20,
  "ms": 800
 },
 {
  "type": "test.probe",
  "rects": [
   "#viewport",
   "#trim-panel .trim-band"
  ]
 },
 {
  "type": "test.wait",
  "frames": 2,
  "ms": 200
 },
 {
  "type": "test.mouse",
  "at": "#trim-panel .trim-band",
  "fx": 0.5,
  "fy": 0.5
 },
 {
  "type": "test.wait",
  "frames": 5,
  "ms": 200
 },
 {
  "type": "test.expect",
  "entity": {
   "name": "A",
   "levelFaces": {
    "material": "Assets/Trims/Starter Trims.fmat",
    "mode": "manual",
    "vWithin": [
     0,
     0.125
    ],
    "count": 1
   }
  }
 },
 {
  "type": "test.capture",
  "path": "level_trims.png"
 },
 {
  "type": "test.wait",
  "frames": 3
 },
 {
  "type": "editor.undo"
 },
 {
  "type": "test.wait",
  "frames": 3
 },
 {
  "type": "test.expect",
  "entity": {
   "name": "A",
   "levelFaces": {
    "mode": "manual",
    "count": 0
   }
  }
 },
 {
  "type": "test.key",
  "key": "T"
 },
 {
  "type": "test.wait",
  "frames": 5,
  "ms": 100
 },
 {
  "type": "test.expect",
  "entity": {
   "name": "A",
   "levelFaces": {
    "material": "Assets/Trims/Starter Trims.fmat",
    "mode": "manual",
    "vWithin": [
     0,
     0.125
    ],
    "count": 1
   }
  }
 },
 {
  "type": "editor.trim.save",
  "path": "Assets/Trims/Half.ftrim",
  "sheet": {
   "material": "Assets/Trims/Starter Trims.fmat",
   "aspect": 1,
   "strips": [
    {
     "name": "Lower half",
     "v0": 0.5,
     "v1": 1
    }
   ]
  }
 },
 {
  "type": "test.wait",
  "frames": 5,
  "ms": 200
 },
 {
  "type": "editor.level.trim",
  "path": "Assets/Trims/Half.ftrim",
  "strip": 0
 },
 {
  "type": "test.wait",
  "frames": 5,
  "ms": 100
 },
 {
  "type": "test.expect",
  "entity": {
   "name": "A",
   "levelFaces": {
    "material": "Assets/Trims/Starter Trims.fmat",
    "vWithin": [
     0.5,
     1
    ],
    "count": 1
   }
  }
 },
 {
  "type": "test.exit"
 }
]
