  "type": "test.writeFile",
  "path": "Scripts/Game.cs",
  "text": "using System;\nusing System.Numerics;\nusing System.Runtime.CompilerServices;\nusing Falcon;\n\nnamespace ScriptTest;\n\n// editor_script_stream (API v35): a sine the game writes into an audio stream as it goes (heard at\n// its level, no underruns once it plays), and shapes from scripts: a convex hull (a box of half\n// size 0.2 as 8 points) and a compound of two spheres (radius 0.4) resting on a floor.\npublic sealed class StreamGame : Game\n{\n    [ModuleInitializer]\n    internal static void Register() => Register<StreamGame>();\n\n    private AudioStream? _stream;\n    private double _phase;\n    private readonly float[] _buffer = new float[4096];\n\n    public override void OnStart()\n    {\n        _stream = new AudioStream(1, 0.25f);\n        Fill();\n        _stream.Play2D(0.5f);\n        Span<Vector3> box = stackalloc Vector3[8];\n        for (int i = 0; i < 8; ++i)\n            box[i] = new Vector3((i & 1) != 0 ? 0.2f : -0.2f, (i & 2) != 0 ? 0.2f : -0.2f, (i & 4) != 0 ? 0.2f : -0.2f);\n        Physics.SetConvexHull(Entity.Find(\"Rock\"), box);\n        Entity pair = Entity.Find(\"Pair\");\n        Physics.AddShape(pair, ShapeKind.Sphere, new Vector3(0.4f), new Vector3(-0.5f, 0, 0));\n        Physics.AddShape(pair, ShapeKind.Sphere, new Vector3(0.4f), new Vector3(0.5f, 0, 0));\n    }\n\n    // What there is room for, keeping it full: a 440 Hz sine at 0.8.\n    private void Fill()\n    {\n        int n = Math.Min(_stream!.Free, _buffer.Length);\n        for (int i = 0; i < n; ++i)\n        {\n            _buffer[i] = 0.8f * MathF.Sin((float)(_phase * 2 * Math.PI));\n            _phase = (_phase + 440.0 / AudioStream.SampleRate) % 1.0;\n        }\n        _stream.Write(_buffer.AsSpan(0, n));\n    }\n\n    public override void OnUpdate(float dt)\n    {\n        Fill();\n        if (Input.IsDown(Key.K))\n            _stream!.Dispose();  // (silence after)\n        float rock = Entity.Find(\"Rock\").Position.Y, pair = Entity.Find(\"Pair\").Position.Y;\n        Hud.Show($\"stream {(_stream!.IsValid ? \"on\" : \"off\")} rock {rock:0.0} pair {pair:0.0}\");\n    }\n}\n"
 },
