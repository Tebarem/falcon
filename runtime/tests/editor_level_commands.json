  "type": "test.writeFile",
  "path": "Scripts/Editor/LevelCommands.cs",
  "text": "using System.Collections.Generic;\nusing System.Numerics;\nusing Falcon;\nusing Falcon.Editor;\nusing Falcon.Level;\n\nnamespace ScriptTest;\n\n// editor_level_commands: a command bound to J in face mode (on the level toolbar and the Alt+Q\n// wheel), starting a modal operation that pushes the chosen faces along their normals.\npublic static class LevelCommands\n{\n    [EditorMenu(\"Tools/Level/Push Faces\", Key = \"J\", Modes = \"face\", Icon = \"face\", Wheel = \"ops\",\n                Help = \"Push the chosen faces along their normals\")]\n    public static void Push()\n    {\n        var items = new List<ulong>();\n        ElementMode mode = Elements.Get(out Entity entity, items);\n        PolyMesh? mesh = entity.Id != 0 ? LevelMeshes.Get(entity) : null;\n        if (mesh == null || mode != ElementMode.Face || items.Count == 0)\n            return;\n        ModalOperation.Begin(new PushFaces(entity, mesh, items));\n    }\n}\n\nsealed class PushFaces : ModalOperation\n{\n    private readonly Entity _entity;\n    private readonly PolyMesh _before;\n    private readonly List<ulong> _faces;\n\n    public PushFaces(Entity entity, PolyMesh before, List<ulong> faces)\n    {\n        _entity = entity;\n        _before = before;\n        _faces = faces;\n    }\n\n    public override string Name => \"Push\";\n\n    private PolyMesh Pushed(float amount)\n    {\n        PolyMesh m = _before.Clone();\n        Vector3 normal = Vector3.Zero;\n        foreach (ulong f in _faces)\n            normal += _before.FaceNormal((int)f);\n        Vector3 dir = Direction(Vector3.Normalize(normal));\n        foreach (int v in Elements.Vertices(_before, ElementMode.Face, _faces))\n            m.Positions[v] = _before.Positions[v] + dir * amount;\n        return m;\n    }\n\n    protected override void Apply(float amount) => LevelMeshes.SetLive(_entity, Pushed(amount));\n    protected override void OnConfirm(float amount) => LevelMeshes.Commit(_entity, _before);\n    protected override void OnCancel() => LevelMeshes.SetLive(_entity, _before);\n}\n"
 },
