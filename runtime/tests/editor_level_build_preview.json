// The building tools' previews and right-click: the wall tool's post follows the mouse before the
// first corner (a box mesh), two corners and a right-click make the wall (one undo step); a right drag
// flies the camera and doesn't end it. The door tool's outline over a wall (12 lines), none off it,
// gone when it ends. The box tool's block before the first corner, a right-click at the second
// corner finishing it as tall as it is wide.
[
 {"type": "test.wait", "frames": 20, "ms": 800},
 {"type": "test.newScene", "name": "Build"},
 {"type": "editor.project.openScene", "scene": "Scenes/Build.fpak"},
 {"type": "test.wait", "frames": 60, "ms": 1500},
 {"type": "test.wait", "frames": 100000, "build": true},
 {"type": "test.wait", "frames": 10, "ms": 300},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},

 {"type": "editor.tools.run", "menu": "Create/Wall"},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.expect", "viewport": {"captured": true, "hint": "Wall: click its first corner"}},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.35, "fy": 0.6, "action": "move"},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.expect", "entity": {"name": "Level Mesh 1", "levelTriangles": 12, "levelHeight": 3}},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.35, "fy": 0.6},
 {"type": "test.wait", "frames": 3, "ms": 100},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.65, "fy": 0.6, "action": "move"},
 {"type": "test.wait", "frames": 3, "ms": 100},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.65, "fy": 0.6},
 {"type": "test.wait", "frames": 3, "ms": 100},
 {"type": "test.expect", "viewport": {"captured": true, "hint": "Wall: 2 corners"}},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.65, "fy": 0.6, "button": "right", "action": "down"},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.75, "fy": 0.6, "button": "right", "action": "move"},
 {"type": "test.wait", "frames": 3, "ms": 100},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.75, "fy": 0.6, "button": "right", "action": "up"},
 {"type": "test.wait", "frames": 3, "ms": 100},
 {"type": "test.expect", "viewport": {"captured": true, "hint": "Wall: 2 corners"}},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.65, "fy": 0.6, "action": "move"},
 {"type": "test.wait", "frames": 3, "ms": 100},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.65, "fy": 0.6, "button": "right", "action": "down"},
 {"type": "test.wait", "frames": 2, "ms": 30},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.65, "fy": 0.6, "button": "right", "action": "up"},
 {"type": "test.wait", "frames": 10, "ms": 300},
 {"type": "test.expect", "viewport": {"captured": false}, "entity": {"name": "Wall", "wall": true, "levelTriangles": 12}},

 {"type": "editor.level.wall.create", "points": [[-4, 0], [4, 0]], "height": 3, "thickness": 0.2, "name": "Front"},
 {"type": "test.wait", "frames": 10, "ms": 300},
 {"type": "editor.frame", "id": "Front"},
 {"type": "test.wait", "frames": 60, "ms": 1200},
 {"type": "editor.tools.run", "menu": "Create/Door"},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.expect", "viewport": {"captured": true, "hint": "Door: click a wall"}},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.5, "action": "move"},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.expect", "viewport": {"previewLines": 12}},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.02, "fy": 0.98, "action": "move"},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.expect", "viewport": {"previewLines": 0}},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.5, "action": "move"},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.expect", "viewport": {"previewLines": 12}},
 {"type": "test.key", "key": "Escape"},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.expect", "viewport": {"captured": false, "previewLines": 0}},

 {"type": "editor.tools.run", "menu": "Create/Box"},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.expect", "viewport": {"captured": true, "hint": "Box: click a corner on the ground"}},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.3, "fy": 0.85, "action": "move"},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.expect", "entity": {"name": "Level Mesh 4", "levelTriangles": 12}},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.3, "fy": 0.85},
 {"type": "test.wait", "frames": 3, "ms": 100},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.4, "fy": 0.92, "action": "move"},
 {"type": "test.wait", "frames": 3, "ms": 100},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.4, "fy": 0.92, "button": "right", "action": "down"},
 {"type": "test.wait", "frames": 2, "ms": 30},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.4, "fy": 0.92, "button": "right", "action": "up"},
 {"type": "test.wait", "frames": 10, "ms": 300},
 {"type": "test.expect", "viewport": {"captured": false}, "entity": {"name": "Level Mesh 5", "levelTriangles": 12}},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"lastOp": "Box"}},
 {"type": "test.exit"}
]
