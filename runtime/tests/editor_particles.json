// Editor test (VFX Test project): particle effects. "Sparks" gets a Particle Effect and a Cone
// Emitter (Add Component), set (undo, redo; a bad value refused) and previews in edit mode;
// "Glow", a child with a Sprite Renderer and Noise, works for its parent's effect. Gravity (Force)
// takes them down; in Play, "Rain" falls on a box's collider and rests on it. "Puff", Temporary and not looping, is removed when it is done in Play and back
// at Stop. Saved: editor_particles_reload finds it all.
[
  {"type": "test.wait", "frames": 30, "ms": 1500},
  {"type": "editor.entity.create", "kind": "empty", "name": "Sparks"},
  {"type": "test.wait", "frames": 2},
  {"type": "editor.transform.set", "id": "Sparks", "position": [0, 2, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "editor.component.add", "id": "Sparks", "component": "ParticleEffect"},
  {"type": "editor.component.add", "id": "Sparks", "component": "particleConeEmitter"},
  {"type": "test.expect", "entity": {"name": "Sparks", "has": ["ParticleEffect", "ParticleConeEmitter"], "lacks": ["ParticleNoise"]}},
  {"type": "editor.vfx.set", "id": "Sparks", "component": "particleConeEmitter", "fields": {"burst": 50, "rate": 20, "angle": 15, "velocity": 2}},
  {"type": "editor.vfx.set", "id": "Sparks", "component": "particleEffect", "fields": {"lifetime": {"mode": "range", "a": 1.5, "b": 2.5}, "maxParticles": 500}},
  {"type": "test.wait", "frames": 40, "ms": 600},
  {"type": "test.expect", "entity": {"name": "Sparks", "particles>": 40, "particleMinY>": 1.9,
    "vfx": {"particleConeEmitter": {"burst": 50, "angle": 15}, "particleEffect": {"maxParticles": 500, "lifetime": {"mode": "range", "a": 1.5, "b": 2.5}}}}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 2},
  {"type": "test.expect", "entity": {"name": "Sparks", "vfx": {"particleEffect": {"maxParticles": 1000, "lifetime": 1}}}},
  {"type": "editor.redo"},
  {"type": "test.wait", "frames": 2},
  {"type": "test.expect", "entity": {"name": "Sparks", "vfx": {"particleEffect": {"maxParticles": 500}}}},
  {"type": "editor.vfx.set", "id": "Sparks", "component": "particleEffect", "fields": {"lifetime": "long"}},
  {"type": "test.expect", "entity": {"name": "Sparks", "vfx": {"particleEffect": {"lifetime": {"mode": "range", "a": 1.5, "b": 2.5}}}}},

  {"type": "editor.entity.create", "kind": "empty", "name": "Glow", "parent": "Sparks"},
  {"type": "test.wait", "frames": 2},
  {"type": "editor.component.add", "id": "Glow", "component": "ParticleSpriteRenderer"},
  {"type": "editor.component.add", "id": "Glow", "component": "ParticleNoise"},
  {"type": "editor.vfx.set", "id": "Glow", "component": "particleSprite", "fields": {"blend": "additive", "columns": 4, "rows": 4, "lit": true}},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "entity": {"name": "Glow", "parent": "Sparks", "particles>": 0, "vfx": {"particleSprite": {"blend": "additive", "columns": 4, "lit": true}}}},

  {"type": "editor.vfx.set", "id": "Sparks", "component": "particleConeEmitter", "fields": {"burst": 30, "rate": 0, "velocity": 0, "loop": false, "duration": 0.1}},
  {"type": "editor.vfx.set", "id": "Sparks", "component": "particleEffect", "fields": {"force": true, "lifetime": 3}},
  {"type": "editor.component.remove", "id": "Glow", "component": "ParticleNoise"},
  {"type": "editor.vfx.restart", "id": "Sparks"},
  {"type": "test.wait", "frames": 50, "ms": 900},
  {"type": "test.expect", "entity": {"name": "Sparks", "particles": 30, "particleMaxY<": 1.5}},

  {"type": "editor.entity.create", "kind": "primitive", "primitive": "cube", "name": "Shelf"},
  {"type": "test.wait", "frames": 2},
  {"type": "editor.transform.set", "id": "Shelf", "position": [10, 0, 0], "rotation": [0, 0, 0], "scale": [4, 1, 4]},
  {"type": "editor.component.add", "id": "Shelf", "component": "BoxCollider"},
  {"type": "editor.entity.create", "kind": "empty", "name": "Rain"},
  {"type": "test.wait", "frames": 2},
  {"type": "editor.transform.set", "id": "Rain", "position": [10, 3, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "editor.component.add", "id": "Rain", "component": "ParticleEffect"},
  {"type": "editor.component.add", "id": "Rain", "component": "ParticleSphereEmitter"},
  {"type": "editor.vfx.set", "id": "Rain", "component": "particleEffect", "fields": {"lifetime": 20, "force": true, "collision": true,
    "collisionRadius": 0.05, "bounce": 0, "friction": 1}},
  {"type": "editor.vfx.set", "id": "Rain", "component": "particleSphereEmitter", "fields": {"burst": 20, "radius": 0.5, "loop": false, "duration": 30}},
  {"type": "editor.play"},
  {"type": "test.wait", "frames": 100000, "build": true},
  {"type": "test.wait", "frames": 120, "ms": 2000},
  {"type": "test.expect", "playing": true, "entity": {"name": "Rain", "particles": 20, "particleMinY>": 0.48, "particleMaxY<": 0.7}},
  {"type": "editor.stop"},
  {"type": "test.wait", "frames": 10, "ms": 300},

  {"type": "editor.entity.create", "kind": "empty", "name": "Puff"},
  {"type": "test.wait", "frames": 2},
  {"type": "editor.component.add", "id": "Puff", "component": "ParticleEffect"},
  {"type": "editor.component.add", "id": "Puff", "component": "ParticleSphereEmitter"},
  {"type": "editor.vfx.set", "id": "Puff", "component": "particleEffect", "fields": {"temporary": true, "lifetime": 0.3}},
  {"type": "editor.vfx.set", "id": "Puff", "component": "particleSphereEmitter", "fields": {"loop": false, "duration": 0.1, "burst": 10}},
  {"type": "test.wait", "frames": 60, "ms": 1000},
  {"type": "test.expect", "entity": {"name": "Puff", "alive": true}},
  {"type": "editor.play"},
  {"type": "test.wait", "frames": 100000, "build": true},
  {"type": "test.wait", "frames": 60, "ms": 1000},
  {"type": "test.expect", "playing": true, "entity": {"name": "Puff", "alive": false}},
  {"type": "editor.stop"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "playing": false, "entity": {"name": "Puff", "alive": true, "has": ["ParticleEffect"]}},

  {"type": "editor.scene.save"},
  {"type": "test.wait", "frames": 5, "ms": 300},
  {"type": "test.exit"}
]
