// The Project panel on the project editor_project made (Scenes/Main with its terrain and edits,
// Scenes/Second), with real mouse, keys and typing:
//   a scene is one item (its .fvt, edits and terrain are not listed);
//   Ctrl+Shift+N makes a folder, renamed in place by typing ("Props"); dragged onto Assets, it moves;
//   search finds a scene anywhere in the project;
//   Ctrl+D duplicates a scene (its .fvt too, and it joins project.falcon), F2 renames it in place
//   (companions follow), Delete removes it after the dialog (deleted outright under --no-prefs).
[
  {"type": "test.wait", "frames": 20, "ms": 800},
  {"type": "test.probe", "rects": ["[data-key=\"Scenes\"]"]},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "test.mouse", "at": "[data-key=\"Scenes\"]", "clicks": 1},
  {"type": "test.wait", "ms": 80},
  {"type": "test.mouse", "at": "[data-key=\"Scenes\"]", "clicks": 2},
  {"type": "test.wait", "frames": 3, "ms": 300},
  {"type": "test.probe"},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "test.expect", "probe": {"assetsFolder": "Scenes", "assetsItems": "Main|Second", "assetsFocused": true}},

  {"type": "test.key", "key": "Backspace"},
  {"type": "test.wait", "frames": 3, "ms": 200},
  {"type": "test.key", "key": "n", "ctrl": true, "shift": true},
  {"type": "test.wait", "frames": 5, "ms": 400},
  {"type": "test.probe"},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "test.expect", "fileExists": "New Folder", "probe": {"assetsFolder": "", "assetsRenaming": true}},
  {"type": "test.type", "text": "Props"},
  {"type": "test.wait", "frames": 2, "ms": 100},
  {"type": "test.key", "key": "Return"},
  {"type": "test.wait", "frames": 5, "ms": 400},
  {"type": "test.expect", "fileExists": "Props", "fileMissing": "New Folder"},

  {"type": "test.probe", "rects": ["[data-key=\"Props\"]", "[data-key=\"Assets\"]"]},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "test.mouse", "at": "[data-key=\"Props\"]", "action": "down"},
  {"type": "test.wait", "frames": 2, "ms": 50},
  {"type": "test.mouse", "at": "[data-key=\"Assets\"]", "fx": 0.4, "action": "move"},
  {"type": "test.wait", "frames": 2, "ms": 50},
  {"type": "test.mouse", "at": "[data-key=\"Assets\"]", "action": "move"},
  {"type": "test.wait", "frames": 2, "ms": 50},
  {"type": "test.mouse", "at": "[data-key=\"Assets\"]", "action": "up"},
  {"type": "test.wait", "frames": 5, "ms": 400},
  {"type": "test.expect", "fileExists": "Assets/Props", "fileMissing": "Props"},

  {"type": "test.probe", "rects": [".as-search input"]},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "test.mouse", "at": ".as-search input"},
  {"type": "test.wait", "frames": 2, "ms": 100},
  {"type": "test.type", "text": "seco"},
  {"type": "test.wait", "frames": 3, "ms": 200},
  {"type": "test.probe"},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "test.expect", "probe": {"assetsSearch": "seco", "assetsCount": 1, "assetsItems": "Second"}},
  {"type": "test.key", "key": "Escape"},
  {"type": "test.wait", "frames": 3, "ms": 200},

  {"type": "test.probe", "rects": ["[data-key=\"Scenes\"]"]},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "test.mouse", "at": "[data-key=\"Scenes\"]", "clicks": 1},
  {"type": "test.wait", "ms": 80},
  {"type": "test.mouse", "at": "[data-key=\"Scenes\"]", "clicks": 2},
  {"type": "test.wait", "frames": 3, "ms": 300},
  {"type": "test.probe", "rects": ["[data-key=\"Scenes/Second.fpak\"]"]},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "test.mouse", "at": "[data-key=\"Scenes/Second.fpak\"]"},
  {"type": "test.wait", "frames": 2, "ms": 100},
  {"type": "test.key", "key": "d", "ctrl": true},
  {"type": "test.wait", "frames": 5, "ms": 500},
  {"type": "test.expect", "fileExists": ["Scenes/Second (2).fpak", "Scenes/Second (2).fvt"], "projectScenes": 3},
  {"type": "test.probe"},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "test.expect", "probe": {"assetsSelection": "Scenes/Second (2).fpak"}},
  {"type": "test.key", "key": "F2"},
  {"type": "test.wait", "frames": 3, "ms": 200},
  {"type": "test.type", "text": "Third"},
  {"type": "test.wait", "frames": 2, "ms": 100},
  {"type": "test.key", "key": "Return"},
  {"type": "test.wait", "frames": 5, "ms": 500},
  {"type": "test.expect", "fileExists": ["Scenes/Third.fpak", "Scenes/Third.fvt"], "fileMissing": "Scenes/Second (2).fpak", "projectScenes": 3},
  {"type": "test.capture", "path": "assets.png"},
  {"type": "test.wait", "frames": 3},

  {"type": "test.key", "key": "Delete"},
  {"type": "test.wait", "frames": 3, "ms": 300},
  {"type": "test.probe", "rects": [".modal-actions .primary"]},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "test.mouse", "at": ".modal-actions .primary"},
  {"type": "test.wait", "frames": 5, "ms": 500},
  {"type": "test.expect", "fileMissing": ["Scenes/Third.fpak", "Scenes/Third.fvt"], "projectScenes": 2},
  {"type": "test.exit"}
]
