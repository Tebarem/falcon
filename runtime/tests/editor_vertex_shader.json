  "path": "Shaders/Wave.slang",
  "text": "// A vertex function (V1): the surface lifted by params.x, and waving by params.y (along x, in time).\nimport falcon_surface;\n\nvoid surface(SurfaceIn i, inout SurfaceOut o) {}\n\nvoid vertex(VertexIn i, inout VertexOut o)\n{\n    o.offset = float3(0.0, i.params.x + sin(i.time * 3.0 + i.world.x * 2.0) * i.params.y, 0.0);\n}\n"
 },
