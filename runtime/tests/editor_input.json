// Editor test: real mouse input (SDL events through the UI layer and cef-lite to the page).
// Double-click selects a whole field, the wheel scrolls the hierarchy, right-click opens a row's
// context menu, dragging a Lighting slider keeps tracking the mouse, and the + button's create
// menu opens its 3D Object submenu on hover and creates the shape clicked there, and a click on
// the colour wheel of a light's colour field turns the light red, and the light's Type
// dropdown (the page's menu: native select popups aren't drawn off-screen) makes it a spot.
[
  {"type": "test.wait", "ms": 1000},
  {"type": "editor.select", "id": 3},
  {"type": "test.wait", "ms": 400},
  {"type": "test.probe", "rects": [".name-field"]},
  {"type": "test.wait", "ms": 300},
  {"type": "test.mouse", "at": ".name-field", "fx": 0.3, "action": "click", "clicks": 1},
  {"type": "test.wait", "ms": 80},
  {"type": "test.mouse", "at": ".name-field", "fx": 0.3, "action": "click", "clicks": 2},
  {"type": "test.wait", "ms": 300},
  {"type": "test.probe"},
  {"type": "test.wait", "ms": 300},
  {"type": "test.expect", "probe": {"focus": "input:text", "selectionAll": true}},
  {"type": "test.key", "key": "Escape"},
  {"type": "test.wait", "ms": 200},

  {"type": "test.probe", "rects": ["#tree"]},
  {"type": "test.wait", "ms": 300},
  {"type": "test.wheel", "at": "#tree", "y": -3},
  {"type": "test.wait", "ms": 400},
  {"type": "test.probe", "rects": ["#tree"]},
  {"type": "test.wait", "ms": 300},
  {"type": "test.expect", "probe": {"hierarchyScroll>": 0}},

  {"type": "test.mouse", "at": "#tree", "fy": 0.3, "button": "right", "action": "down"},
  {"type": "test.wait", "ms": 200},
  {"type": "test.mouse", "at": "#tree", "fy": 0.3, "button": "right", "action": "up"},
  {"type": "test.wait", "ms": 300},
  {"type": "test.probe"},
  {"type": "test.wait", "ms": 300},
  {"type": "test.expect", "probe": {"menuOpen": true, "menuItems": 7}},  // create child, frame, rename, duplicate, show/hide, delete, save as prefab
  {"type": "test.key", "key": "Escape"},
  {"type": "test.wait", "ms": 200},

  {"type": "test.probe", "rects": ["[data-tab=\"lighting\"]"]},
  {"type": "test.wait", "ms": 300},
  {"type": "test.mouse", "at": "[data-tab=\"lighting\"]"},
  {"type": "test.wait", "ms": 400},
  {"type": "test.probe", "rects": ["#lighting input[type=range]"]},
  {"type": "test.wait", "ms": 300},
  {"type": "test.mouse", "at": "#lighting input[type=range]", "fx": 0.5, "action": "down"},
  {"type": "test.wait", "ms": 100},
  {"type": "test.mouse", "at": "#lighting input[type=range]", "fx": 0.6, "action": "move"},
  {"type": "test.wait", "ms": 100},
  {"type": "test.mouse", "at": "#lighting input[type=range]", "fx": 0.7, "action": "move"},
  {"type": "test.wait", "ms": 100},
  {"type": "test.mouse", "at": "#lighting input[type=range]", "fx": 0.8, "action": "move"},
  {"type": "test.wait", "ms": 100},
  {"type": "test.mouse", "at": "#lighting input[type=range]", "fx": 0.8, "action": "up"},
  {"type": "test.wait", "ms": 300},
  {"type": "test.probe"},
  {"type": "test.wait", "ms": 300},
  {"type": "test.expect", "probe": {"giIntensity>": 2.8}},
  {"type": "test.probe", "rects": ["#btn-create"]},
  {"type": "test.wait", "ms": 300},
  {"type": "test.mouse", "at": "#btn-create", "action": "down"},
  {"type": "test.mouse", "at": "#btn-create", "action": "up"},
  {"type": "test.wait", "ms": 300},
  {"type": "test.probe", "rects": [".menu .menu-item.has-sub"]},
  {"type": "test.wait", "ms": 300},
  {"type": "test.expect", "probe": {"menuOpen": true, "menuItems": 8}},  // empty, 3D object, level mesh, light, camera, effects, water, terrain
  {"type": "test.mouse", "at": ".menu .menu-item.has-sub", "action": "move"},
  {"type": "test.wait", "ms": 300},
  {"type": "test.probe", "rects": ["body > .menu:last-of-type .menu-item:nth-of-type(3)"]},
  {"type": "test.wait", "ms": 300},
  {"type": "test.expect", "probe": {"submenuItems": 7}},
  {"type": "test.mouse", "at": "body > .menu:last-of-type .menu-item:nth-of-type(3)"},
  {"type": "test.wait", "ms": 400},
  {"type": "test.probe"},
  {"type": "test.wait", "ms": 300},
  {"type": "test.expect", "selectedName": "Capsule 1", "probe": {"menuOpen": false}},
  {"type": "editor.entity.create", "kind": "light", "light": "point", "name": "Picked"},
  {"type": "test.probe", "rects": ["[data-tab=\"inspector\"]"]},
  {"type": "test.wait", "ms": 300},
  {"type": "test.mouse", "at": "[data-tab=\"inspector\"]"},
  {"type": "test.wait", "ms": 400},
  {"type": "test.probe", "rects": [".color-field"]},
  {"type": "test.wait", "ms": 300},
  {"type": "test.mouse", "at": ".color-field"},
  {"type": "test.wait", "ms": 300},
  {"type": "test.probe", "rects": [".cp-wheel-box"]},
  {"type": "test.wait", "ms": 300},
  {"type": "test.mouse", "at": ".cp-wheel-box", "fx": 0.97, "fy": 0.5},
  {"type": "test.wait", "ms": 400},
  {"type": "test.expect", "entity": {"name": "Picked", "lightColor": [1, 0, 0]}},
  {"type": "test.key", "key": "Escape"},
  {"type": "test.wait", "ms": 200},
  {"type": "test.probe", "rects": ["#inspector select"]},
  {"type": "test.wait", "ms": 300},
  {"type": "test.mouse", "at": "#inspector select"},
  {"type": "test.wait", "ms": 300},
  {"type": "test.probe", "rects": [".select-menu .menu-item:nth-of-type(3)"]},
  {"type": "test.wait", "ms": 300},
  {"type": "test.expect", "probe": {"menuOpen": true, "menuItems": 3}},
  {"type": "test.mouse", "at": ".select-menu .menu-item:nth-of-type(3)"},
  {"type": "test.wait", "ms": 400},
  {"type": "test.probe"},
  {"type": "test.wait", "ms": 300},
  {"type": "test.expect", "entity": {"name": "Picked", "lightType": "spot"}, "probe": {"menuOpen": false}},
  {"type": "test.exit"}
]
