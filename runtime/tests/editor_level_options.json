// The level commands' settings (the Level window's ⚙): every command found once with its section and
// icon, and the chord menus' layout's every path a command (none twice on a ring); Bevel's and the cylinder's settings read back, set from the page (editor.tools.option) and
// used: a bevel with 4 segments from the start, the wheel's change heard back; a 6-sided cylinder. Then the
// cylinder as the last operation: 8 sides, then 2 m high, each done again in its place (undo + redo); an
// undo ends it.
[
 {"type": "test.wait", "frames": 20, "ms": 800},
 {"type": "test.newScene", "name": "Options"},
 {"type": "editor.project.openScene", "scene": "Scenes/Options.fpak"},
 {"type": "test.wait", "frames": 60, "ms": 1500},
 {"type": "test.wait", "frames": 100000, "build": true},
 {"type": "test.wait", "frames": 10, "ms": 300},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"commandsCheck": "ok", "chordProblems": "", "option:Mesh/Bevel/Segments": 1, "option:Mesh/Bevel/Curve": 0,
                                   "option:Create/Cylinder/Sides": 16, "option:Create/Wall/Height": 3}},
 {"type": "test.mouse", "at": "#viewport", "action": "move"},

 {"type": "editor.tools.option", "menu": "Mesh/Bevel", "name": "Segments", "value": 4},
 {"type": "editor.tools.option", "menu": "Create/Cylinder", "name": "Sides", "value": 6},
 {"type": "editor.tools.option", "menu": "Create/Cylinder", "name": "Sides", "value": 2.4},
 {"type": "editor.tools.option", "menu": "Create/Cylinder", "name": "Sides", "value": 6},
 {"type": "editor.tools.option", "menu": "Create/Wall", "name": "Height", "value": 99},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"option:Mesh/Bevel/Segments": 4, "option:Create/Cylinder/Sides": 6, "option:Create/Wall/Height": 50}},

 {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "A"},
 {"type": "editor.transform.set", "id": "A", "position": [0, 0, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
 {"type": "editor.frame", "id": "A"},
 {"type": "test.wait", "frames": 60, "ms": 1200},
 {"type": "editor.tool.set", "element": "edge"},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.34, "fy": 0.544},
 {"type": "test.wait", "frames": 5, "ms": 100},
 {"type": "test.expect", "elements": {"mode": "edge", "count": 1}},
 {"type": "test.key", "key": "B"},
 {"type": "test.wait", "frames": 5, "ms": 100},
 {"type": "test.expect", "viewport": {"captured": true, "hint": "4 segments round"}},
 {"type": "test.wheel", "at": "#viewport", "y": 1},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.expect", "viewport": {"hint": "5 segments round"}},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"option:Mesh/Bevel/Segments": 5}},
 {"type": "test.key", "key": "Escape"},
 {"type": "test.wait", "frames": 5, "ms": 100},
 {"type": "test.expect", "viewport": {"captured": false}, "entity": {"name": "A", "levelTriangles": 12}},

 {"type": "editor.tool.set", "element": "object"},
 {"type": "editor.tools.run", "menu": "Create/Cylinder"},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.expect", "viewport": {"captured": true, "hint": "Cylinder"}},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.3, "fy": 0.7, "action": "move"},
 {"type": "test.wait", "frames": 3, "ms": 100},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.3, "fy": 0.7},
 {"type": "test.wait", "frames": 3, "ms": 100},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.45, "fy": 0.78, "action": "move"},
 {"type": "test.wait", "frames": 3, "ms": 100},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.45, "fy": 0.78},
 {"type": "test.wait", "frames": 3, "ms": 100},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.45, "fy": 0.45, "action": "move"},
 {"type": "test.wait", "frames": 3, "ms": 100},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.45, "fy": 0.45},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.expect", "viewport": {"captured": false}},
 {"type": "test.expect", "entity": {"name": "Level Mesh 3", "levelTriangles": 20}},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"lastOp": "Cylinder"}},
 {"type": "editor.tools.option", "menu": "Create/Cylinder", "name": "Sides", "value": 8},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.expect", "entity": {"name": "Level Mesh 4", "levelTriangles": 28}},
 {"type": "editor.tools.option", "menu": "Last", "name": "Height", "value": 2},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.expect", "entity": {"name": "Level Mesh 5", "levelHeight": 2, "levelTriangles": 28}},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"lastOp": "Cylinder"}},
 {"type": "editor.undo"},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"lastOp": ""}},
 {"type": "test.exit"}
]
