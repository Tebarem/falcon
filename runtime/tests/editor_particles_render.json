// Editor test (VFX Test project): particle sprites drawn. A burst of untextured sprites in front of
// the camera, captured; their renderer removed, captured again (editor_particles_drawn compares).
// Then velocity-stretched and lit (editor_particles_aligned), as trails (editor_particles_trail),
// and a Light Renderer lighting a floor (editor_particles_light).
[
  {"type": "test.wait", "frames": 30, "ms": 1500},
  {"type": "test.view", "position": [0, 2, 6], "target": [0, 2, 0]},
  {"type": "editor.entity.create", "kind": "empty", "name": "Burst"},
  {"type": "test.wait", "frames": 2},
  {"type": "editor.transform.set", "id": "Burst", "position": [0, 2, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "editor.component.add", "id": "Burst", "component": "ParticleEffect"},
  {"type": "editor.component.add", "id": "Burst", "component": "ParticleSphereEmitter"},
  {"type": "editor.component.add", "id": "Burst", "component": "ParticleSpriteRenderer"},
  {"type": "editor.vfx.set", "id": "Burst", "component": "particleEffect",
    "fields": {"lifetime": 100, "color": true, "tint": [1, 0.4, 0.1, 1], "brightness": 4, "initialScale": 0.3}},
  {"type": "editor.vfx.set", "id": "Burst", "component": "particleSphereEmitter", "fields": {"burst": 60, "rate": 0, "radius": 1.2, "loop": false, "duration": 100}},
  {"type": "editor.vfx.set", "id": "Burst", "component": "particleSprite", "fields": {"depthFeather": 0}},
  {"type": "editor.vfx.restart", "id": "Burst"},
  {"type": "test.wait", "frames": 20, "ms": 500},
  {"type": "test.expect", "entity": {"name": "Burst", "particles": 60}},
  {"type": "test.capture", "path": "particles_on.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.vfx.set", "id": "Burst", "component": "particleSprite", "fields": {"alignment": "velocity", "lit": true}},
  {"type": "editor.vfx.set", "id": "Burst", "component": "particleSphereEmitter", "fields": {"velocity": 3}},
  {"type": "editor.vfx.restart", "id": "Burst"},
  {"type": "test.wait", "frames": 20, "ms": 500},
  {"type": "test.capture", "path": "particles_aligned.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.vfx.set", "id": "Burst", "component": "particleSphereEmitter", "fields": {"velocity": 2}},
  {"type": "editor.component.remove", "id": "Burst", "component": "ParticleSpriteRenderer"},
  {"type": "editor.component.add", "id": "Burst", "component": "ParticleTrailRenderer"},
  {"type": "editor.vfx.set", "id": "Burst", "component": "particleTrail", "fields": {"points": 16, "spacing": 0.05, "pointLifetime": 0.4, "width": 0.06}},
  {"type": "editor.vfx.restart", "id": "Burst"},
  {"type": "test.wait", "frames": 15, "ms": 300},
  {"type": "test.capture", "path": "particles_trail.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.component.remove", "id": "Burst", "component": "ParticleTrailRenderer"},

  {"type": "editor.entity.create", "kind": "primitive", "primitive": "cube", "name": "Floor"},
  {"type": "test.wait", "frames": 2},
  {"type": "editor.transform.set", "id": "Floor", "position": [0, 0, 0], "rotation": [0, 0, 0], "scale": [8, 1, 8]},
  {"type": "editor.entity.create", "kind": "empty", "name": "Glow"},
  {"type": "test.wait", "frames": 2},
  {"type": "editor.transform.set", "id": "Glow", "position": [0, 1.2, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "editor.component.add", "id": "Glow", "component": "ParticleEffect"},
  {"type": "editor.component.add", "id": "Glow", "component": "ParticleSphereEmitter"},
  {"type": "editor.vfx.set", "id": "Glow", "component": "particleEffect", "fields": {"lifetime": 100, "color": true, "tint": [1, 0.1, 0.05, 1]}},
  {"type": "editor.vfx.set", "id": "Glow", "component": "particleSphereEmitter", "fields": {"burst": 2, "radius": 0, "loop": false, "duration": 100}},
  {"type": "editor.vfx.restart", "id": "Glow"},
  {"type": "test.view", "position": [0, 5, 6], "target": [0, 0.5, 0]},
  {"type": "test.wait", "frames": 20, "ms": 500},
  {"type": "test.capture", "path": "particles_unlit_floor.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.component.add", "id": "Glow", "component": "ParticleLightRenderer"},
  {"type": "editor.vfx.set", "id": "Glow", "component": "particleLight", "fields": {"intensity": 300, "range": 4}},
  {"type": "test.wait", "frames": 20, "ms": 500},
  {"type": "test.capture", "path": "particles_lit_floor.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.entity.delete", "id": "Glow"},
  {"type": "editor.entity.delete", "id": "Floor"},
  {"type": "test.view", "position": [0, 2, 6], "target": [0, 2, 0]},
  {"type": "test.wait", "frames": 20, "ms": 500},
  {"type": "test.capture", "path": "particles_off.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "test.exit"}
]
