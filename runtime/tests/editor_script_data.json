 },
 {
  "type": "editor.project.openScene",
  "scene": "Scenes/Main.fpak",
  "save": true
 },
 {
  "type": "test.wait",
  "frames": 3000,
  "cook": true
 },
 {
  "type": "test.wait",
  "frames": 30,
  "ms": 1000
 },
 {
  "type": "test.expect",
  "sceneOpen": "Scenes/Main.fpak"
 },
 {
  "type": "test.expect",
  "entity": {
   "name": "Crate",
   "data": {
    "ScriptTest.Health": {
     "Value": 42.5,
     "Lives": 7,
     "Alive": true,
     "Spawn": [
      0,
      2,
      0
     ]
    }
   }
  }
 },
 {
  "type": "editor.component.remove",
