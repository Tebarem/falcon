 {
  "type": "test.writeFile",
  "path": "Scripts/Editor/LevelTools.cs",
  "text": "using System.Numerics;\nusing Falcon;\nusing Falcon.Editor;\nusing Falcon.Level;\n\nnamespace ScriptTest;\n\n// editor_level_mesh: editor code changing level meshes (each change an undo step).\npublic static class LevelTools\n{\n    // The selected level mesh's top face (facing +Y) raised 1 m: its sides stretch with it.\n    [EditorMenu(\"Tools/Level/Raise Top\")]\n    public static void RaiseTop()\n    {\n        EditorEntity e = Selection.Entity;\n        PolyMesh? m = e.IsValid ? LevelMeshes.Get(e.Entity) : null;\n        if (m == null)\n            return;\n        for (int f = 0; f < m.Faces.Count; ++f)\n            if (Vector3.Dot(m.FaceNormal(f), Vector3.UnitY) > 0.9f)\n                for (int c = 0; c < m.Faces[f].Count; ++c)\n                {\n                    int v = m.Corner(f, c);\n                    m.Positions[v] += Vector3.UnitY;\n                }\n        LevelMeshes.Set(e.Entity, m);\n    }\n\n    // A new L-shaped floor (one concave 6-corner face) beside it, named Floor.\n    [EditorMenu(\"Tools/Level/Make Floor\")]\n    public static void MakeFloor()\n    {\n        using var _ = Undo.Scope(\"Make floor\");\n        var m = new PolyMesh();\n        foreach (var (x, z) in new[] { (0f, 0f), (0f, 2f), (1f, 2f), (1f, 1f), (2f, 1f), (2f, 0f) })\n            m.Positions.Add(new Vector3(x, 0, z));\n        m.AddFace(stackalloc int[] { 0, 1, 2, 3, 4, 5 });\n        Entity floor = LevelMeshes.Create(m, new Vector3(3, 0, 0));\n        EditorScene.Rename(EditorEntity.Of(floor), \"Floor\");\n    }\n}\n"
 },
 {
  "type": "test.writeFile",
  "path": "Scripts/Game.cs",
  "text": "using System.Numerics;\nusing System.Runtime.CompilerServices;\nusing Falcon;\nusing Falcon.Level;\n\nnamespace ScriptTest;\n\n// editor_level_mesh: the game reads the Block's mesh and makes it a 3 m box while playing (Stop\n// puts the editor's back).\npublic sealed class LevelMeshGame : Game\n{\n    [ModuleInitializer]\n    internal static void Register() => Register<LevelMeshGame>();\n\n    private string _report = \"\";\n\n    public override void OnStart()\n    {\n        Entity block = Entity.Find(\"Block\");\n        PolyMesh? m = LevelMeshes.Get(block);\n        bool set = LevelMeshes.Set(block, PolyMesh.Box(new Vector3(3, 3, 3)));\n        Entity made = LevelMeshes.Create(PolyMesh.Box(Vector3.One), new Vector3(0, 5, 0));\n        _report = $\"level got {m?.TriangleCount ?? -1} set {(set ? \"ok\" : \"BAD\")} made {(made.Id != 0 ? \"ok\" : \"BAD\")}\";\n    }\n\n    public override void OnUpdate(float dt) => Hud.Show(_report);\n}\n"
 },
