// The level components in the Inspector: a door's width and a wall's height typed into their
// sections, a damage cut's seed typed (one undo step each), the cut section's shape list there. A
// wall's own section comes first, then its Surface; its sides and top are material pickers.
[
  {"type": "test.wait", "frames": 20, "ms": 800},
  {"type": "test.newScene", "name": "Inspect"},
  {"type": "editor.project.openScene", "scene": "Scenes/Inspect.fpak"},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.wait", "frames": 100000, "build": true},
  {"type": "editor.level.wall.create", "points": [[0, 0], [4, 0]], "height": 3, "thickness": 0.2, "name": "Wall"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "editor.level.opening", "distance": 2, "width": 1, "height": 2.1, "name": "Door"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "selectedName": "Door", "entity": {"name": "Door", "opening": true, "openingWidth": 1}},

  {"type": "test.probe", "rects": ["[data-component=opening] .prop:nth-child(2) input"], "reveal": true},
  {"type": "test.wait", "ms": 300},
  {"type": "test.mouse", "at": "[data-component=opening] .prop:nth-child(2) input", "action": "click", "clicks": 3},
  {"type": "test.wait", "ms": 200},
  {"type": "test.type", "text": "1.5"},
  {"type": "test.key", "key": "Return"},
  {"type": "test.wait", "frames": 10, "ms": 400},
  {"type": "test.expect", "entity": {"name": "Door", "openingWidth": 1.5}},

  {"type": "editor.select", "id": "Wall"},
  {"type": "test.wait", "frames": 5, "ms": 300},
  {"type": "test.probe", "rects": ["[data-component=wall] .prop:nth-child(1) input"], "reveal": true},
  {"type": "test.wait", "ms": 300},
  {"type": "test.mouse", "at": "[data-component=wall] .prop:nth-child(1) input", "action": "click", "clicks": 3},
  {"type": "test.wait", "ms": 200},
  {"type": "test.type", "text": "2.5"},
  {"type": "test.key", "key": "Return"},
  {"type": "test.wait", "frames": 10, "ms": 400},
  {"type": "test.expect", "entity": {"name": "Wall", "wallHeight": 2.5, "levelDrawnTriangles>": 12}},
  {"type": "test.probe", "rects": ["#viewport"]},
  {"type": "test.wait", "ms": 200},
  {"type": "test.expect", "probe": {"inspectorLevel": "wall,surface", "inspectorMaterialRows": 3}},

  {"type": "editor.level.cut.create", "shape": "damage", "seed": 1, "name": "Break"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "selectedName": "Break", "entity": {"name": "Break", "cutShape": "damage", "cutSeed": 1}},
  {"type": "test.probe", "rects": ["[data-component=cut] select", "[data-component=cut] .prop:nth-child(4) input"], "reveal": true},
  {"type": "test.wait", "ms": 300},
  {"type": "test.mouse", "at": "[data-component=cut] .prop:nth-child(4) input", "action": "click", "clicks": 3},
  {"type": "test.wait", "ms": 200},
  {"type": "test.type", "text": "42"},
  {"type": "test.key", "key": "Return"},
  {"type": "test.wait", "frames": 10, "ms": 400},
  {"type": "test.expect", "entity": {"name": "Break", "cutSeed": 42}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "Break", "cutSeed": 1}},
  {"type": "test.exit"}
]
