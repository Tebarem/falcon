// The mode bar: hidden with nothing selected; a level box selected shows it (Object, the box's name);
// its Face button picks the face mode ("Click faces to choose them"), a click on a face chooses one
// ("1 face"), 2 the vertex mode, 1 objects again; nothing selected hides it. The tools column keeps
// only the transform tools and the terrain brush.
[
 {"type": "test.wait", "frames": 20, "ms": 800},
 {"type": "test.newScene", "name": "ModeBar"},
 {"type": "editor.project.openScene", "scene": "Scenes/ModeBar.fpak"},
 {"type": "test.wait", "frames": 60, "ms": 1500},
 {"type": "test.wait", "frames": 100000, "build": true},
 {"type": "editor.select", "id": 0},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"modeBar": ""}},
 {"type": "test.mouse", "at": "#viewport", "action": "move"},

 {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "Crate"},
 {"type": "editor.transform.set", "id": "Crate", "position": [0, 0, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
 {"type": "editor.frame", "id": "Crate"},
 {"type": "test.wait", "frames": 60, "ms": 1200},
 {"type": "editor.select", "id": "Crate"},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.probe", "rects": ["#viewport", "#mode-bar [data-element=\"face\"]"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"modeBar": "object", "modeCount": "Crate"}},
 {"type": "test.mouse", "at": "#mode-bar [data-element=\"face\"]", "action": "down"},
 {"type": "test.mouse", "at": "#mode-bar [data-element=\"face\"]", "action": "up"},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.expect", "elements": {"mode": "face", "count": 0}},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"modeBar": "face", "modeCount": "Click faces to choose them"}},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.5},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.expect", "elements": {"mode": "face", "count": 1}},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"modeBar": "face", "modeCount": "1 face"}},
 {"type": "test.key", "key": "2"},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"modeBar": "vertex"}},
 {"type": "test.key", "key": "1"},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "editor.select", "id": 0},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"modeBar": ""}},
 {"type": "test.capture", "path": "level_mode_bar.png"},
 {"type": "test.exit"}
]
