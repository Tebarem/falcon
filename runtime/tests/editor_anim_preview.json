// The Animator tab (editor_anim_place's project): the bar's graph opened, the preview shows the
// model of its skeleton, posed by the preview's own graph instance (paused at the start, so the
// captures are of one pose). A parameter and a step bend it; bones; an orbit drag over the pane.
// Back on the Scene tab the view is as it was at once, once the page's layout is back (the scene
// renderer kept its history and shadows while hidden).
[
  {"type": "test.wait", "frames": 20, "ms": 800},
  {"type": "test.view", "position": [2, 1.5, 3], "target": [0, 0.5, 0]},
  {"type": "test.wait", "frames": 90, "ms": 1500},
  {"type": "test.capture", "path": "anim_scene_before.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.anim.open", "path": "Assets/skinned.fgraph"},
  {"type": "test.wait", "frames": 20, "ms": 600},
  {"type": "editor.anim.preview.set", "paused": true},
  {"type": "editor.anim.preview.restart"},
  {"type": "test.wait", "frames": 20, "ms": 400},
  {"type": "test.probe"},
  {"type": "test.wait", "frames": 3, "ms": 100},
  {"type": "test.expect", "probe": {"animatorShown": true, "animatorGraph": "Assets/skinned.fgraph", "animatorModel": "Assets/skinned.gltf",
                                    "animatorParams": 2, "animatorErrors": 0, "animatorState": "Straight"}},
  {"type": "test.capture", "path": "anim_preview_a.png", "view": "anim"},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.anim.param", "name": "Bent", "value": true},
  {"type": "editor.anim.preview.step", "seconds": 0.45},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.probe"},
  {"type": "test.wait", "frames": 3, "ms": 100},
  {"type": "test.expect", "probe": {"animatorState": "Bent"}},
  {"type": "test.capture", "path": "anim_preview_b.png", "view": "anim"},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.anim.preview.set", "bones": true},
  {"type": "test.wait", "frames": 5, "ms": 100},
  {"type": "test.capture", "path": "anim_preview_bones.png", "view": "anim"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.probe", "rects": ["#anim-preview"]},
  {"type": "test.wait", "frames": 3, "ms": 100},
  {"type": "test.mouse", "at": "#anim-preview", "fx": 0.4, "fy": 0.5, "action": "down"},
  {"type": "test.wait", "frames": 2, "ms": 50},
  {"type": "test.mouse", "at": "#anim-preview", "fx": 0.55, "fy": 0.45, "action": "move"},
  {"type": "test.wait", "frames": 2, "ms": 50},
  {"type": "test.mouse", "at": "#anim-preview", "fx": 0.7, "fy": 0.4, "action": "move"},
  {"type": "test.wait", "frames": 2, "ms": 50},
  {"type": "test.mouse", "at": "#anim-preview", "fx": 0.7, "fy": 0.4, "action": "up"},
  {"type": "test.wait", "frames": 5, "ms": 100},
  {"type": "test.capture", "path": "anim_preview_orbit.png", "view": "anim"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.probe", "rects": [".tab[data-tab=\"scene\"]"]},
  {"type": "test.wait", "frames": 3, "ms": 100},
  {"type": "test.mouse", "at": ".tab[data-tab=\"scene\"]"},
  {"type": "test.wait", "frames": 6, "ms": 120},
  {"type": "test.capture", "path": "anim_scene_back_1.png", "viewport": true},
  {"type": "test.wait", "frames": 90, "ms": 1500},
  {"type": "test.capture", "path": "anim_scene_back.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "test.probe"},
  {"type": "test.wait", "frames": 3, "ms": 100},
  {"type": "test.expect", "probe": {"animatorShown": false}},
  {"type": "test.exit"}
]
