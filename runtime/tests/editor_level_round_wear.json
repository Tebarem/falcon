// Wear on round bevels: a level box with edge wear (bare metal) gets a round Bevel modifier (6
// segments): its new faces get mask UVs of their own and wear all across the round; chips along the
// rounds' middles (Damage Selection on the whole mesh, after the bevel is applied into it).
[
  {"type": "test.wait", "frames": 20, "ms": 800},
  {"type": "test.newScene", "name": "RoundWear"},
  {"type": "editor.project.openScene", "scene": "Scenes/RoundWear.fpak"},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.wait", "frames": 100000, "build": true},
  {"type": "editor.assets.newMaterial", "folder": "Assets", "name": "Metal"},
  {"type": "test.wait", "frames": 5, "ms": 300},
  {"type": "test.key", "key": "Escape"},
  {"type": "editor.material.set", "path": "Assets/Metal.fmat", "values": {"baseColor": [0.95, 0.95, 1, 1], "metallic": 1, "roughness": 0.25}},
  {"type": "test.probe", "rects": ["#viewport"]},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "A"},
  {"type": "editor.transform.set", "id": "A", "position": [0, 0.5, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "editor.frame", "id": "A"},
  {"type": "test.wait", "frames": 30, "ms": 600},
  {"type": "editor.level.op", "op": "layers", "args": {"materials": ["Assets/Metal.fmat", "", ""]}},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "editor.level.wear", "op": "add", "kind": "edges", "layer": 0, "width": 0.06},
  {"type": "test.wait", "frames": 600, "wear": true},
  {"type": "test.expect", "entity": {"name": "A", "levelWear": 1, "levelWearMean>": [0, 0.01]}},

  {"type": "editor.level.modifier", "op": "add", "kind": "bevel"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "editor.level.modifier", "op": "set", "index": 0, "width": 0.12, "segments": 6, "curve": 1},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.wait", "frames": 600, "wear": true},
  {"type": "test.expect", "entity": {"name": "A", "levelDrawnTriangles": 300, "levelWearMean>": [0, 0.12]}},
  {"type": "test.capture", "path": "level_round_wear.png", "viewport": true},
  {"type": "test.wait", "frames": 3},

  {"type": "editor.level.modifier", "op": "apply"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "editor.tool.set", "paintRadius": 0.06, "paintRubble": false, "paintDamage": 1},
  {"type": "editor.level.damage"},
  {"type": "test.wait", "frames": 100000, "cuts": true},
  {"type": "test.expect", "damage": 168},
  {"type": "test.capture", "path": "level_round_damage.png", "viewport": true},
  {"type": "test.exit"}
]
