// Openings that slide: an opening's own transform is kept at its foot on its wall (so what is under
// it goes with it). Moved to a point off the wall it slides to the nearest place along it, at that
// height as its sill (kept inside the wall: 1 m up is 0.9, the top of a 2.1 m door in a 3 m wall;
// below the floor is 0), undone;
// made a door prefab with a leaf under it and dropped on the wall, the copy goes into the wall where
// the mouse is; the wall turned, its openings stay on it. A doorway's outline only with it, its wall
// or its leaf selected (none with nothing selected).
[
  {"type": "test.wait", "frames": 20, "ms": 800},
  {"type": "test.newScene", "name": "Openings"},
  {"type": "editor.project.openScene", "scene": "Scenes/Openings.fpak"},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.wait", "frames": 100000, "build": true},
  {"type": "test.probe", "rects": ["#viewport"]},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "editor.level.wall.create", "points": [[0, 0], [8, 0]], "height": 3, "thickness": 0.3, "name": "Long"},
  {"type": "test.wait", "frames": 10, "ms": 200},
  {"type": "editor.select", "id": "Long"},
  {"type": "editor.level.opening", "distance": 2, "width": 1, "height": 2.1, "name": "Gap"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "entity": {"name": "Gap", "opening": true, "parent": "Long", "at": [2, 0, 0], "within": 0.01}},

  {"type": "editor.transform.set", "id": "Gap", "position": [5, 1, 3], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "entity": {"name": "Gap", "openingDistance": 5, "openingSill": 0.9, "at": [5, 0.9, 0], "within": 0.01}},
  {"type": "editor.transform.set", "id": "Gap", "position": [5, 0.4, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "entity": {"name": "Gap", "openingSill": 0.4, "at": [5, 0.4, 0], "within": 0.01}},
  {"type": "editor.transform.set", "id": "Gap", "position": [5, -2, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "entity": {"name": "Gap", "openingSill": 0, "at": [5, 0, 0], "within": 0.01}},
  {"type": "editor.undo"},
  {"type": "editor.undo"},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "entity": {"name": "Gap", "openingDistance": 2, "openingSill": 0, "at": [2, 0, 0], "within": 0.01}},

  {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "Leaf", "parent": "Gap"},
  {"type": "editor.transform.set", "id": "Leaf", "position": [0, 1.05, 0], "rotation": [0, 0, 0], "scale": [0.9, 2.1, 0.05]},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "entity": {"name": "Leaf", "parent": "Gap", "at": [2, 1.05, 0], "within": 0.01}},
  {"type": "editor.select", "id": "Leaf"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.expect", "cutsShown": 1},
  {"type": "editor.select", "id": "Gap"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.expect", "cutsShown": 1},
  {"type": "editor.select", "id": "Long"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.expect", "cutsShown": 1},
  {"type": "editor.select", "ids": []},
  {"type": "test.wait", "frames": 3},
  {"type": "test.expect", "cutsShown": 0},
  {"type": "editor.prefab.create", "id": "Gap", "folder": "Assets"},
  {"type": "test.wait", "frames": 20, "ms": 600},

  {"type": "editor.frame", "id": "Long"},
  {"type": "test.wait", "frames": 30, "ms": 600},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.5, "action": "move"},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.asset.place", "prefab": "Assets/Gap.fprefab", "atMouse": true},
  {"type": "test.wait", "frames": 20, "ms": 400},
  {"type": "test.expect", "entity": {"name": "Gap (1)", "opening": true, "parent": "Long", "openingSill": 0, "at": [4, 0, 0], "within": 0.6, "children>": 0}},
  {"type": "test.expect", "entity": {"name": "Long", "levelDrawnTriangles>": 30}},

  {"type": "editor.select", "id": "Long"},
  {"type": "editor.level.wall", "points": [[0, 0], [0, 8]]},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "entity": {"name": "Gap", "at": [0, 0, 2], "within": 0.01}},
  {"type": "test.expect", "entity": {"name": "Gap (1)", "at": [0, 0, 4], "within": 0.6}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "entity": {"name": "Gap", "at": [2, 0, 0], "within": 0.01}},
  {"type": "test.exit"}
]
