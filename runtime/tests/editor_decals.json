// Editor test (VFX Test project): decals. A crater's colour (its alpha the coverage), normal and
// height maps made a material ("Hole"); a Decal on a floor (Create > Effects > Decal) draws it,
// its box selected. Saved: the material needs a cook for its textures (height into its ORM alpha),
// which editor_decals_reload gets.
[
  {"type": "test.wait", "frames": 20, "ms": 800},
  {"type": "editor.assets.importFiles", "paths": ["samples/decal_color.png", "samples/decal_normal.png", "samples/decal_height.png"], "folder": "Assets"},
  {"type": "test.wait", "frames": 10, "ms": 500},
  {"type": "test.expect", "fileExists": "Assets/decal_height.png"},
  {"type": "editor.assets.newMaterial", "folder": "Assets", "name": "Hole"},
  {"type": "test.wait", "frames": 5, "ms": 300},
  {"type": "test.key", "key": "Escape"},
  {"type": "test.wait", "frames": 3, "ms": 100},
  {"type": "editor.material.set", "path": "Assets/Hole.fmat", "values": {"baseColor": [1, 1, 1, 1], "roughness": 0.9, "alpha": "blend",
   "textures": {"baseColor": "Assets/decal_color.png", "normal": "Assets/decal_normal.png", "height": "Assets/decal_height.png"}}},
  {"type": "test.wait", "frames": 3, "ms": 100},
  {"type": "editor.entity.create", "kind": "primitive", "primitive": "cube", "name": "Floor"},
  {"type": "test.wait", "frames": 2},
  {"type": "editor.transform.set", "id": "Floor", "position": [0, -20, 0], "rotation": [0, 0, 0], "scale": [8, 1, 8]},
  {"type": "editor.entity.create", "kind": "empty", "name": "Hole", "vfx": "decal"},
  {"type": "test.wait", "frames": 2},
  {"type": "test.expect", "entity": {"name": "Hole", "has": ["Decal"]}, "selectedName": "Hole"},
  {"type": "editor.transform.set", "id": "Hole", "position": [0, -19.5, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "editor.vfx.set", "id": "Hole", "component": "decal", "fields": {"material": "Assets/Hole.fmat", "decalSize": [3, 1, 3], "parallaxDepth": 0.4, "parallaxSteps": 32}},
  {"type": "test.expect", "entity": {"name": "Hole", "vfx": {"decal": {"material": "Assets/Hole.fmat", "parallaxDepth": 0.4}}}},
  {"type": "editor.scene.save"},
  {"type": "test.wait", "frames": 10, "ms": 500},
  {"type": "test.exit"}
]
