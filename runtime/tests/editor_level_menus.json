// The level tools' menus: Shift+A opens the create menu where the mouse is (the shapes, then a submenu a
// section); Cuts > Box makes a cut. GameObject > Level has every create command; Help > Level Starter
// Content the five starters. (The Alt+Q wheel is held while it is open: test.key lets go at once.)
[
 {"type": "test.wait", "frames": 20, "ms": 800},
 {"type": "test.newScene", "name": "Menus"},
 {"type": "editor.project.openScene", "scene": "Scenes/Menus.fpak"},
 {"type": "test.wait", "frames": 60, "ms": 1500},
 {"type": "test.wait", "frames": 100000, "build": true},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.4, "action": "move"},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.key", "key": "a", "shift": true},
 {"type": "test.wait", "frames": 10, "ms": 400},
 {"type": "test.probe", "rects": [".menu .menu-item[data-value=\"Cuts\"]"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"menuOpen": true, "menuItems>": 12}},
 {"type": "test.capture", "path": "level_menus_create.png"},
 {"type": "test.mouse", "at": ".menu .menu-item[data-value=\"Cuts\"]", "action": "move"},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.probe", "rects": [".menu .menu-item[data-value=\"Create/Cut Box\"]"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"submenuItems>": 2}},
 {"type": "test.mouse", "at": ".menu .menu-item[data-value=\"Create/Cut Box\"]"},
 {"type": "test.wait", "frames": 10, "ms": 400},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"menuOpen": false}, "entity": {"name": "Cut"}},

 {"type": "test.probe", "rects": ["#menubar [data-menu=\"gameobject\"]"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.mouse", "at": "#menubar [data-menu=\"gameobject\"]", "action": "down"},
 {"type": "test.mouse", "at": "#menubar [data-menu=\"gameobject\"]", "action": "up"},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.probe", "rects": [".menu .menu-item[data-value=\"Level\"]"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.mouse", "at": ".menu .menu-item[data-value=\"Level\"]", "action": "move"},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"menuOpen": true, "submenuItems>": 12}},
 {"type": "test.capture", "path": "level_menus_gameobject.png"},
 {"type": "test.key", "key": "Escape"},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.9, "fy": 0.9, "action": "down"},
 {"type": "test.mouse", "at": "#viewport", "fx": 0.9, "fy": 0.9, "action": "up"},
 {"type": "test.wait", "frames": 5, "ms": 300},

 {"type": "test.probe", "rects": ["#menubar [data-menu=\"help\"]"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.mouse", "at": "#menubar [data-menu=\"help\"]", "action": "down"},
 {"type": "test.mouse", "at": "#menubar [data-menu=\"help\"]", "action": "up"},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.probe", "rects": [".menu .menu-item[data-value=\"Level Starter Content\"]"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.mouse", "at": ".menu .menu-item[data-value=\"Level Starter Content\"]", "action": "move"},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"menuOpen": true, "submenuItems": 5}},
 {"type": "test.exit"}
]
