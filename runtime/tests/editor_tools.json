// Editor test: creation, duplication, GPU picking in the viewport, tools, settings (FXAA and
// MSAA rendering under the editor's overlays), pause/step.
[
  {"type": "editor.entity.create", "primitive": "cube"},
  {"type": "test.expect", "selectedName": "Cube 1"},
  {"type": "editor.entity.duplicate"},
  {"type": "test.expect", "selectedName": "Cube 1 (1)"},
  {"type": "editor.entity.delete"},
  {"type": "editor.entity.create", "primitive": "sphere"},
  {"type": "test.expect", "selectedName": "Sphere 1"},
  {"type": "editor.entity.delete"},
  {"type": "editor.select", "id": 0},
  {"type": "test.wait", "frames": 3},
  {"type": "test.pick", "x": 0.5, "y": 0.5},
  {"type": "test.wait", "frames": 12},
  {"type": "test.expect", "selectedName": "Cube 1"},
  {"type": "editor.frame"},
  {"type": "editor.tool.set", "tool": "rotate", "local": true},
  {"type": "test.expect", "tool": "rotate"},
  {"type": "editor.select", "id": 3},
  {"type": "test.wait", "ms": 1000},
  {"type": "test.ping", "n": 7},
  {"type": "test.wait", "ms": 300},
  {"type": "test.expect", "pong": 7},
  {"type": "editor.transform.set", "id": "Directional Light", "position": [0, 20, 0], "rotation": [-35, 30, 0], "scale": [1, 1, 1]},
  {"type": "test.expect", "entity": {"name": "Directional Light", "position": [0, 20, 0]}},
  {"type": "editor.settings.set", "key": "exposure", "value": 0.5},
  {"type": "editor.settings.set", "key": "giIntensity", "value": 1.5},
  {"type": "editor.settings.set", "key": "skyIntensity", "value": 0.8},
  {"type": "editor.settings.set", "key": "fxaa", "value": true},
  {"type": "editor.settings.set", "key": "msaa", "value": 4},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "settings": {"fxaa": true, "msaa": 4, "exposure": 0.5}},
  {"type": "editor.settings.set", "key": "msaa", "value": 3},
  {"type": "test.expect", "settings": {"msaa": 2}},
  {"type": "editor.settings.set", "key": "msaa", "value": 1},
  {"type": "editor.settings.set", "key": "fxaa", "value": false},
  {"type": "editor.settings.set", "key": "upscaler", "value": 1},
  {"type": "editor.settings.set", "key": "upscaleQuality", "value": 3},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "settings": {"upscaler": 1, "upscaleQuality": 3, "renderScale": 0.5}},
  {"type": "editor.settings.set", "key": "upscaler", "value": 0},
  {"type": "editor.select", "id": 0},
  {"type": "editor.entity.create", "primitive": "cube"},
  {"type": "test.expect", "canUndo": true, "canRedo": false},
  {"type": "test.key", "key": "Z", "ctrl": true},
  {"type": "test.wait", "ms": 300},
  {"type": "test.expect", "canRedo": true},
  {"type": "test.key", "key": "Z", "ctrl": true, "shift": true},
  {"type": "test.wait", "ms": 300},
  {"type": "test.expect", "canRedo": false},
  {"type": "test.key", "key": "Z", "ctrl": true},
  {"type": "test.wait", "ms": 300},
  {"type": "test.key", "key": "Y", "ctrl": true},
  {"type": "test.wait", "ms": 300},
  {"type": "test.expect", "canRedo": false},
  {"type": "editor.play"},
  {"type": "test.expect", "playing": true, "paused": false},
  {"type": "editor.pause"},
  {"type": "editor.step"},
  {"type": "test.expect", "playing": true, "paused": true},
  {"type": "editor.stop"},
  {"type": "test.expect", "playing": false},
  {"type": "test.exit"}
]
