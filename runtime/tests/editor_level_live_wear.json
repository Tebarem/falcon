// Live wear: a worn wall over a floor. Edge wear made as it is asked for, and again when a window
// is cut into the wall (its rim worn too); grime where the floor meets the wall, gone with the floor
// moved away and back with it; streaks below the sill; a rule changed; baked into the mask and
// undone; kept through a save (editor_level_live_wear_drawn: the view changes).
[
  {"type": "test.wait", "frames": 20, "ms": 800},
  {"type": "test.newScene", "name": "LiveWear"},
  {"type": "editor.project.openScene", "scene": "Scenes/LiveWear.fpak"},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.wait", "frames": 100000, "build": true},
  {"type": "editor.assets.newMaterial", "folder": "Assets", "name": "Metal"},
  {"type": "test.wait", "frames": 5, "ms": 300},
  {"type": "test.key", "key": "Escape"},
  {"type": "editor.assets.newMaterial", "folder": "Assets", "name": "Dirt"},
  {"type": "test.wait", "frames": 5, "ms": 300},
  {"type": "test.key", "key": "Escape"},
  {"type": "editor.material.set", "path": "Assets/Metal.fmat", "values": {"baseColor": [0.85, 0.85, 0.9, 1], "metallic": 1, "roughness": 0.3}},
  {"type": "editor.material.set", "path": "Assets/Dirt.fmat", "values": {"baseColor": [0.2, 0.13, 0.07, 1], "roughness": 0.95}},
  {"type": "test.probe", "rects": ["#viewport"]},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "Floor"},
  {"type": "editor.transform.set", "id": "Floor", "position": [0, -0.05, 0], "rotation": [0, 0, 0], "scale": [8, 0.1, 8]},
  {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "Wall"},
  {"type": "editor.transform.set", "id": "Wall", "position": [0, 1.5, 0], "rotation": [0, 0, 0], "scale": [4, 3, 0.3]},
  {"type": "editor.frame", "id": "Wall"},
  {"type": "test.wait", "frames": 30, "ms": 600},
  {"type": "editor.level.op", "op": "layers", "args": {"materials": ["Assets/Metal.fmat", "Assets/Dirt.fmat", "Assets/Dirt.fmat"]}},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.capture", "path": "level_live_wear_before.png", "viewport": true},
  {"type": "test.wait", "frames": 3},

  {"type": "editor.level.wear", "op": "add", "kind": "edges", "layer": 0, "width": 0.06},
  {"type": "test.wait", "frames": 600, "wear": true},
  {"type": "test.expect", "entity": {"name": "Wall", "levelWear": 1, "levelMask": false, "levelWearMean>": [0, 0.064], "levelWearMean<": [0, 0.073]}},

  {"type": "editor.level.cut.create", "shape": "box", "name": "Window"},
  {"type": "editor.transform.set", "id": "Window", "position": [0, 1.6, 0], "rotation": [0, 0, 0], "scale": [1.2, 1, 1]},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.wait", "frames": 600, "wear": true},
  {"type": "test.expect", "entity": {"name": "Wall", "levelDrawnTriangles>": 12, "levelWearMean>": [0, 0.0735]}},

  {"type": "editor.select", "id": "Wall"},
  {"type": "editor.level.wear", "op": "add", "kind": "grime", "layer": 1, "width": 0.25, "foot": 0},
  {"type": "test.wait", "frames": 600, "wear": true},
  {"type": "test.expect", "entity": {"name": "Wall", "levelWear": 2, "levelWearMean>": [1, 0.05]}},
  {"type": "editor.transform.set", "id": "Floor", "position": [0, -20, 0], "rotation": [0, 0, 0], "scale": [8, 0.1, 8]},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.wait", "frames": 600, "wear": true},
  {"type": "test.expect", "entity": {"name": "Wall", "levelWearMean<": [1, 0.001]}},
  {"type": "editor.transform.set", "id": "Floor", "position": [0, -0.05, 0], "rotation": [0, 0, 0], "scale": [8, 0.1, 8]},
  {"type": "test.wait", "frames": 10, "ms": 300},

  {"type": "editor.select", "id": "Wall"},
  {"type": "editor.level.wear", "op": "add", "kind": "streaks", "layer": 2, "width": 1},
  {"type": "test.wait", "frames": 600, "wear": true},
  {"type": "test.expect", "entity": {"name": "Wall", "levelWear": 3, "levelWearMean>": [2, 0.019]}},
  {"type": "test.expect", "entity": {"name": "Wall", "levelWearMean>": [1, 0.05]}},
  {"type": "test.capture", "path": "level_live_wear_after.png", "viewport": true},
  {"type": "test.wait", "frames": 3},

  {"type": "editor.level.wear", "op": "set", "index": 0, "width": 0.15},
  {"type": "test.wait", "frames": 600, "wear": true},
  {"type": "test.expect", "entity": {"name": "Wall", "levelWearMean>": [0, 0.14]}},
  {"type": "test.probe", "rects": ["[data-wear-rules]"], "reveal": true},

  {"type": "editor.level.wear", "op": "bake"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "Wall", "levelWear": 0, "levelMask": true, "levelMaskMean>": [2, 0.019]}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "Wall", "levelWear": 3, "levelMask": false}},

  {"type": "editor.scene.save"},
  {"type": "test.wait", "frames": 30, "ms": 800},
  {"type": "editor.project.openScene", "scene": "Scenes/LiveWear.fpak"},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.wait", "frames": 600, "wear": true},
  {"type": "test.expect", "entity": {"name": "Wall", "levelWear": 3, "levelWearMean>": [2, 0.019]}},
  {"type": "test.exit"}
]
