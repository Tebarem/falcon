// Materials (the project the asset tests left): a new material asset, made red and glossy; a
// sphere placed on the terrain in the middle of the view; the material dropped on it there
// (the frame changes: compared by editor_materials_differs); undo and redo; the material's
// preview renders. Saved for editor_materials_reload.
[
  {"type": "test.wait", "frames": 20, "ms": 800},
  {"type": "editor.assets.newMaterial", "folder": "Assets"},
  {"type": "test.wait", "frames": 5, "ms": 300},
  {"type": "test.key", "key": "Escape"},
  {"type": "test.wait", "frames": 3, "ms": 100},
  {"type": "test.expect", "fileExists": "Assets/New Material.fmat"},
  {"type": "editor.material.set", "path": "Assets/New Material.fmat", "values": {"baseColor": [0.8, 0.04, 0.03, 1], "roughness": 0.3}},
  {"type": "test.view", "position": [-20, 14, 6], "target": [-20, 7.5, 0]},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.asset.place", "mesh": "sphere", "at": {"x": 0.5, "y": 0.5}},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "Sphere 1", "bottom": 7.5, "material": ""}},
  {"type": "editor.select", "id": 0},
  {"type": "test.wait", "frames": 30, "ms": 300},
  {"type": "test.capture", "path": "material_before.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.asset.assign", "material": "Assets/New Material.fmat", "at": {"x": 0.5, "y": 0.5}},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "Sphere 1", "material": "Assets/New Material.fmat"}},
  {"type": "test.key", "key": "z", "ctrl": true},
  {"type": "test.wait", "frames": 3, "ms": 100},
  {"type": "test.expect", "entity": {"name": "Sphere 1", "material": ""}},
  {"type": "test.key", "key": "y", "ctrl": true},
  {"type": "test.wait", "frames": 3, "ms": 100},
  {"type": "test.expect", "entity": {"name": "Sphere 1", "material": "Assets/New Material.fmat"}},
  {"type": "editor.select", "id": 0},
  {"type": "test.wait", "frames": 30, "ms": 300},
  {"type": "test.capture", "path": "material_after.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.scene.save"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.probe", "rects": [".as-search input"]},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "test.mouse", "at": ".as-search input"},
  {"type": "test.wait", "frames": 2, "ms": 100},
  {"type": "test.type", "text": "New Material"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.wait", "frames": 6000, "previews": true, "ms": 500},
  {"type": "test.wait", "frames": 10, "ms": 500},
  {"type": "test.probe"},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "test.expect", "probe": {"assetsCount": 1, "assetsPreviews>": 0}},
  {"type": "test.capture", "path": "materials.png"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.exit"}
]
