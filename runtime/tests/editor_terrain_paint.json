// Editor test: material layers and the paint brushes. A flat terrain with two generated layers;
// a paint stroke (real mouse events) puts layer 2 under the brush, undo takes it back, redo
// restores it; a hole stroke cuts the ground and undo fills it again.
[
  {"type": "editor.terrain.create", "tiles": 1, "spacing": 0.5, "heightMin": -50, "heightMax": 100, "hills": 0, "height": -1.5},
  {"type": "editor.terrain.layer.add", "generated": "grass"},
  {"type": "editor.terrain.layer.add", "generated": "rock"},
  {"type": "test.view", "position": [0, 12, 24], "target": [0, -1.5, 0]},
  {"type": "editor.tool.set", "tool": "brush"},
  {"type": "editor.terrain.brush", "op": "paint", "layer": 1, "radius": 5, "strength": 1, "falloffPreset": "constant", "noiseMask": 0},
  {"type": "test.wait", "frames": 30},
  {"type": "test.probe", "rects": ["#viewport"]},
  {"type": "test.wait", "frames": 2},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.75, "action": "move"},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.75, "action": "down"},
  {"type": "test.wait", "frames": 10},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.75, "action": "up"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "canUndo": true, "terrain": {"atStroke": true, "layer": 1, "hole": false}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.expect", "terrain": {"atStroke": true, "layer": 0}},
  {"type": "editor.redo"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.expect", "terrain": {"atStroke": true, "layer": 1}},
  {"type": "editor.terrain.brush", "op": "hole", "radius": 2},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.75, "action": "down"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.75, "action": "up"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "terrain": {"atStroke": true, "hole": true, "layer": 1}},
  {"type": "test.wait", "frames": 30},
  {"type": "test.capture", "path": "terrain_paint.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.expect", "terrain": {"atStroke": true, "hole": false}},
  {"type": "test.exit"}
]
