// Previews in the Project panel (the project editor_assets left): a search for "rock" shows the
// rocks (and Falcon's Rock 01 material and its textures folder, from the library); the background
// preview runs render them (and the scenes the Scenes folder shows) and the page shows each; the
// cache (Cache/Thumbnails/index.json) is written. Saving the scene retakes its preview from the view.
[
  {"type": "test.wait", "frames": 20, "ms": 800},
  {"type": "test.probe", "rects": [".as-search input"]},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "test.mouse", "at": ".as-search input"},
  {"type": "test.wait", "frames": 2, "ms": 100},
  {"type": "test.type", "text": "rock"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.wait", "frames": 6000, "previews": true, "ms": 500},
  {"type": "test.wait", "frames": 10, "ms": 500},
  {"type": "test.probe"},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "test.expect", "probe": {"assetsCount": 10, "assetsPreviews>": 7}, "fileExists": "Cache/Thumbnails/index.json"},
  {"type": "test.capture", "path": "previews.png"},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.scene.save"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.exit"}
]
