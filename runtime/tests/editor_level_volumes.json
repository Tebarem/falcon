// Gameplay volumes: a trigger volume (not drawn, a box trigger over it; a C# component asks
// Volumes what a point is in); a nav blocker in the gap round a wall (the navigation mesh baked
// again: no way across), made a nav area (a way again, costly); the trigger made a plain mesh
// again (drawn); saved and opened again.
[
  {"type": "test.wait", "frames": 20, "ms": 800},
  {"type": "test.newScene", "name": "Volumes"},
  {"type": "editor.project.openScene", "scene": "Scenes/Volumes.fpak"},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.writeFile", "path": "Scripts/VolumeProbe.cs",
   "text": "using System.Collections.Generic;\nusing System.Numerics;\nusing Falcon;\nusing Falcon.Level;\n\nnamespace ScriptTest;\n\n// editor_level_volumes: what volumes a point is in.\npublic sealed class VolumeProbe : Component\n{\n    [Property] public Vector3 Point;\n    [Property] public bool InTrigger;\n    [Property] public string Kind = \"\";\n    [Property] public string Tag = \"\";\n\n    [Button]\n    public void Probe()\n    {\n        var found = new List<(Entity Entity, VolumeKind Kind)>();\n        Volumes.At(Point, found);\n        InTrigger = Volumes.Inside(Point, VolumeKind.Trigger);\n        Kind = found.Count > 0 ? found[0].Kind.ToString() : \"\";\n        Tag = \"\";\n        if (found.Count > 0)\n            Volumes.KindOf(found[0].Entity, out Tag);\n    }\n}\n"},
  {"type": "test.wait", "frames": 100000, "build": true},
  {"type": "test.probe", "rects": ["#viewport"]},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "VolFloor"},
  {"type": "editor.transform.set", "id": "VolFloor", "position": [0, -0.5, 0], "rotation": [0, 0, 0], "scale": [30, 1, 30]},
  {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "VolWall"},
  {"type": "editor.transform.set", "id": "VolWall", "position": [0, 1.5, -2], "rotation": [0, 0, 0], "scale": [0.4, 3, 26]},
  {"type": "editor.frame", "id": "VolFloor"},
  {"type": "test.wait", "frames": 20, "ms": 400},
  {"type": "editor.nav.bake"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "navPath": {"from": [-5, 0, 0], "to": [5, 0, 0], "found": true, "length>": 25}},

  {"type": "editor.level.volume", "create": true, "kind": "trigger", "name": "Zone", "tag": "checkpoint"},
  {"type": "editor.transform.set", "id": "Zone", "position": [5, 1, 5], "rotation": [0, 0, 0], "scale": [2, 2, 2]},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "selectedName": "Zone", "entity": {"name": "Zone", "volume": "trigger", "collider": "box", "rowHidden": true}},
  {"type": "editor.entity.create", "kind": "empty", "name": "Probe"},
  {"type": "editor.component.add", "id": "Probe", "component": "Script:ScriptTest.VolumeProbe"},
  {"type": "editor.script.set", "id": "Probe", "class": "ScriptTest.VolumeProbe", "values": {"Point": [5.5, 1.2, 4.6]}},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "editor.script.button", "id": "Probe", "class": "ScriptTest.VolumeProbe", "method": "Probe"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "Probe", "scriptProps": {"ScriptTest.VolumeProbe": {"InTrigger": true, "Kind": "Trigger", "Tag": "checkpoint"}}}},

  {"type": "editor.level.volume", "create": true, "kind": "navBlocker", "name": "Block"},
  {"type": "editor.transform.set", "id": "Block", "position": [0, 1, 13], "rotation": [0, 0, 0], "scale": [4, 3, 4]},
  {"type": "test.wait", "frames": 120, "ms": 1500},
  {"type": "test.expect", "entity": {"name": "Block", "volume": "navBlocker"}},
  {"type": "test.expect", "navPath": {"from": [-5, 0, 0], "to": [5, 0, 0], "found": false}},
  {"type": "editor.select", "id": "Block"},
  {"type": "editor.level.volume", "kind": "navArea", "cost": 50},
  {"type": "test.wait", "frames": 120, "ms": 1500},
  {"type": "test.expect", "entity": {"name": "Block", "volume": "navArea"}},
  {"type": "test.expect", "navPath": {"from": [-5, 0, 0], "to": [5, 0, 0], "found": true, "length>": 25}},

  {"type": "test.wait", "frames": 3, "ms": 100},
  {"type": "test.expect", "outlinesShown": 1},
  {"type": "editor.select", "id": ""},
  {"type": "test.wait", "frames": 3, "ms": 100},
  {"type": "test.expect", "outlinesShown": 0},

  {"type": "editor.select", "id": "Zone"},
  {"type": "editor.level.volume", "remove": true},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "Zone", "volume": "", "rowHidden": false}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "Zone", "volume": "trigger", "rowHidden": true}},

  {"type": "editor.scene.save"},
  {"type": "test.wait", "frames": 30, "ms": 800},
  {"type": "editor.project.openScene", "scene": "Scenes/Volumes.fpak"},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.expect", "entity": {"name": "Block", "volume": "navArea"}},
  {"type": "test.expect", "entity": {"name": "Zone", "volume": "trigger", "rowHidden": true}},
  {"type": "test.expect", "navPath": {"from": [-5, 0, 0], "to": [5, 0, 0], "found": true}},
  {"type": "test.writeFile", "path": "Scripts/VolumeProbe.cs", "remove": true},
  {"type": "test.wait", "frames": 100000, "build": true},
  {"type": "test.exit"}
]
