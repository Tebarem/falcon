// Preview in Editor (the Animator's): its graph plays in edit mode (an Animator without it holds its
// start pose), the IK following its entities as they move (the head turning after "Look Target");
// Play starts it again from the start, Stop too, and what hangs below a bone (an Empty on the hand,
// a cube under it) is back where it hangs after Stop (by its local transform: the pose at Play's
// start is not the pose Stop starts again), and a child made before its parent ("Early Child" under
// "Mover", which the test game moves) is put back under it where it was; undoable; the setting saved, never the pose
// (editor_anim_edit_preview_reload).
[
  {"type": "test.wait", "frames": 20, "ms": 800},
  {"type": "test.wait", "frames": 30, "ms": 600},
  {"type": "test.writeFile", "path": "Scripts/Game.cs", "text": "using System.Runtime.CompilerServices;\nusing Falcon;\n\nnamespace AnimTest;\n\n// Test game: moves \"Mover\" up each frame (Stop puts it back, with what hangs under it).\npublic sealed class AnimTestGame : Game\n{\n    [ModuleInitializer]\n    internal static void Register() => Register<AnimTestGame>();\n\n    public override void OnUpdate(float dt)\n    {\n        Entity mover = Entity.Find(\"Mover\");\n        if (!mover.IsValid || !Ecs.Has<WorldTransform>(mover))\n            return;\n        WorldTransform w = Ecs.Get<WorldTransform>(mover);\n        unsafe { w.rows[7] += dt; }\n        Ecs.Set(mover, w);\n    }\n}\n"},
  {"type": "test.wait", "frames": 100000, "build": true},
  {"type": "test.expect", "anim": {"entity": "legs", "editorPreview": false, "played": {"below": 0.01}}},
  {"type": "editor.select", "id": "legs"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.probe", "rects": ["[data-editor-preview]"]},
  {"type": "test.wait", "frames": 2, "ms": 100},
  {"type": "test.mouse", "at": "[data-editor-preview]"},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.expect", "canUndo": true, "anim": {"entity": "legs", "editorPreview": true, "played": {"above": 0.5}, "looking": {"bone": "head", "at": [3.5, 2.2, 2.5], "within": 2}}},
  {"type": "editor.transform.set", "id": "Look Target", "position": [7, 1.8, 3], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "anim": {"entity": "legs", "looking": {"bone": "head", "at": [7, 1.8, 3], "within": 2}}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "anim": {"entity": "legs", "looking": {"bone": "head", "at": [3.5, 2.2, 2.5], "within": 2}}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 30, "ms": 600},
  {"type": "test.expect", "anim": {"entity": "legs", "editorPreview": false}},
  {"type": "test.capture", "path": "anim_edit_preview_off.png", "viewport": true},
  {"type": "editor.redo"},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.expect", "anim": {"entity": "legs", "editorPreview": true, "played": {"above": 1.0}}},
  {"type": "editor.entity.bones", "id": "legs", "expand": true},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "editor.entity.create", "kind": "empty", "parent": "hand_l", "name": "Grip"},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.transform.set", "id": "Grip", "position": [0.1, 0, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "editor.entity.create", "kind": "primitive", "primitive": "cube", "parent": "Grip", "name": "Gem"},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.transform.set", "id": "Gem", "position": [0, 0.1, 0], "rotation": [0, 0, 0], "scale": [0.05, 0.05, 0.05]},
  {"type": "test.wait", "frames": 30, "ms": 600},
  {"type": "test.expect", "entity": {"name": "Grip", "parent": "hand_l", "local": [1, 0, 0, 0.1, 0, 1, 0, 0, 0, 0, 1, 0]}},
  {"type": "test.expect", "entity": {"name": "Gem", "parent": "Grip", "local": [0.05, 0, 0, 0, 0, 0.05, 0, 0.1, 0, 0, 0.05, 0]}},
  {"type": "editor.entity.create", "kind": "empty", "name": "Early Child"},
  {"type": "editor.entity.create", "kind": "empty", "name": "Mover"},
  {"type": "editor.transform.set", "id": "Mover", "position": [2, 1, 2], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "editor.entity.parent", "id": "Early Child", "parent": "Mover"},
  {"type": "editor.transform.set", "id": "Early Child", "position": [0.5, 0, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "Early Child", "parent": "Mover", "local": [1, 0, 0, 0.5, 0, 1, 0, 0, 0, 0, 1, 0]}},
  {"type": "editor.play"},
  {"type": "test.wait", "frames": 2},
  {"type": "test.expect", "playing": true, "anim": {"entity": "legs", "played": {"below": 0.5}}},
  {"type": "test.wait", "frames": 100000, "build": true},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.expect", "anim": {"entity": "legs", "played": {"above": 1.0}}},
  {"type": "editor.stop"},
  {"type": "test.wait", "frames": 2},
  {"type": "test.expect", "playing": false, "anim": {"entity": "legs", "played": {"below": 0.5}}},
  {"type": "test.expect", "entity": {"name": "Grip", "parent": "hand_l", "local": [1, 0, 0, 0.1, 0, 1, 0, 0, 0, 0, 1, 0]}},
  {"type": "test.expect", "entity": {"name": "Gem", "parent": "Grip", "local": [0.05, 0, 0, 0, 0, 0.05, 0, 0.1, 0, 0, 0.05, 0]}},
  {"type": "test.expect", "entity": {"name": "Mover", "position": [2, 1, 2]}},
  {"type": "test.expect", "entity": {"name": "Early Child", "parent": "Mover", "local": [1, 0, 0, 0.5, 0, 1, 0, 0, 0, 0, 1, 0]}},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.expect", "anim": {"entity": "legs", "played": {"above": 1.0}, "looking": {"bone": "head", "at": [3.5, 2.2, 2.5], "within": 2}}},
  {"type": "editor.scene.save"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "fileContains": {"Scenes/Main.edits.json": "\"editorPreview\":true"}},
  {"type": "test.exit"}
]
