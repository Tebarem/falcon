// Views and measuring: orthographic on (Numpad 5: the box the same size on screen) and the top view,
// back to perspective; the measure tool dragged a twentieth of the view across the top of a 4 m box (about 0.83 m), Esc.
[
  {"type": "test.wait", "frames": 20, "ms": 800},
  {"type": "test.newScene", "name": "Views"},
  {"type": "editor.project.openScene", "scene": "Scenes/Views.fpak"},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.wait", "frames": 100000, "build": true},
  {"type": "test.probe", "rects": ["#viewport"]},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "Slab"},
  {"type": "editor.transform.set", "id": "Slab", "position": [0, 0.5, 0], "rotation": [0, 0, 0], "scale": [4, 1, 4]},
  {"type": "editor.frame", "id": "Slab"},
  {"type": "test.wait", "frames": 30, "ms": 600},
  {"type": "test.capture", "path": "level_views_perspective.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.5, "action": "move"},
  {"type": "test.key", "key": "Keypad 5"},
  {"type": "test.wait", "frames": 20, "ms": 400},
  {"type": "test.expect", "orthographic": true},
  {"type": "test.capture", "path": "level_views_orthographic.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.view", "look": "top"},
  {"type": "test.wait", "frames": 30, "ms": 600},
  {"type": "test.capture", "path": "level_views_top.png", "viewport": true},
  {"type": "test.wait", "frames": 3},

  {"type": "editor.tool.set", "tool": "measure"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.5, "action": "move"},
  {"type": "test.wait", "frames": 2},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.5, "action": "down"},
  {"type": "test.wait", "frames": 2},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.55, "fy": 0.5, "action": "move"},
  {"type": "test.wait", "frames": 2},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.55, "fy": 0.5, "action": "up"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "tool": "measure", "measured": [0.83, 0.15]},
  {"type": "test.key", "key": "Escape"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "tool": "move"},
  {"type": "editor.view", "orthographic": false},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "orthographic": false},
  {"type": "test.exit"}
]
