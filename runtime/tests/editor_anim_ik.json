  {"type": "test.writeFile", "path": "Scripts/Game.cs", "text": "using System.Numerics;\nusing System.Runtime.CompilerServices;\nusing Falcon;\n\nnamespace AnimTest;\n\n// Test game: the rig's foot IK (U held: off), its head looking (L held), its left hand reaching\n// (K held), API v12, and aiming its left hand (J held: ahead as posed, the head looking with it; H\n// held: along the arm; G held: held at a point), API v13; a ray down onto the slope, API v14; the\n// graph's LookTarget bound to the Aim Target by the script (E held: else the Animator's), API v16.\npublic sealed class AnimTestGame : Game\n{\n    [ModuleInitializer]\n    internal static void Register() => Register<AnimTestGame>();\n\n    public override void OnUpdate(float dt)\n    {\n        Entity rig = Entity.Find(\"legs\");\n        bool feet = Animation.SetFootIk(rig, Input.IsDown(Key.U) ? 0f : 1f);\n        bool look = Input.IsDown(Key.L) ? Animation.LookAt(rig, new Vector3(7f, 1.8f, 3f)) : Animation.LookAt(rig, Vector3.Zero, 0f);\n        bool reach = Input.IsDown(Key.K) ? Animation.Reach(rig, \"hand_l\", new Vector3(5.35f, 1.2f, 0.35f))\n                                         : Animation.Reach(rig, \"hand_l\", Vector3.Zero, 0f);\n        bool aim = Input.IsDown(Key.J) ? Animation.AimAt(rig, new Vector3(5.8f, 2.2f, 2.5f), 1f, \"hand_l\")\n                                       : Animation.AimAt(rig, Vector3.Zero, 0f, \"hand_l\");\n        if (Input.IsDown(Key.H))\n            aim = Animation.AimAt(rig, new Vector3(8f, 1.5f, 1f), 1f, \"hand_l\", Vector3.UnitX);\n        if (Input.IsDown(Key.G))\n            aim = Animation.AimAt(rig, new Vector3(5.8f, 2.2f, 2.5f), 1f, \"hand_l\", default, new Vector3(5.45f, 1.5f, 0.35f));\n        if (Input.IsDown(Key.J))\n            Animation.LookAt(rig, new Vector3(5.8f, 2.2f, 2.5f));\n        bool bound = Input.IsDown(Key.E) ? Animation.SetEntity(rig, \"LookTarget\", Entity.Find(\"Aim Target\")) : Animation.ResetEntity(rig, \"LookTarget\");\n        Hud.Show($\"ik: feet {feet}, look {look}, reach {reach}, aim {aim}, none {Animation.Reach(rig, \"nope\", Vector3.Zero)}, \" +\n                 $\"no spine {Animation.AimAt(rig, Vector3.Zero, 0f, \"foot_l\")}, \" +\n                 $\"ray {(Physics.Raycast(new Vector3(5f, 3f, 0f), -Vector3.UnitY, out SurfaceHit ray, 10f) ? ray.Distance.ToString(\"F2\") : \"none\")}, \" +\n                 $\"bound {bound} {(Animation.GetEntity(rig, \"LookTarget\") == Entity.Find(\"Look Target\") ? \"look\" : \"aim\")}, no param {Animation.SetEntity(rig, \"Nope\", rig)}\");\n    }\n}\n"},
