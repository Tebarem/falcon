// Editor test (the project fixture, after editor_audio_scripts): baked acoustics. Two concrete rooms joined
// by a doorway, baked (probes, reverb, paths) into Scenes/Main.audio/; the listener's reverb comes from
// the probes in reach (realtime out of it), a sound behind the wall takes the path through the doorway, and
// moving the wall marks the bake out of date until it is put back. audio_bake_cli bakes it again headless;
// editor_audio_bake_reload finds it baked and clears it.
[
  {"type": "test.wait", "frames": 30, "ms": 1500},
  {"type": "editor.settings.set", "key": "audioReflections", "value": 2},
  {"type": "editor.audio.bake.set", "spacing": 1.5, "height": 1.5, "quality": 1, "pathing": true, "autoRegion": false, "center": [300, 201.2, 300], "size": [12, 3.4, 6]},
  {"type": "test.expect", "audio": {"bake": {"state": "none"}}},
  {"type": "editor.entity.create", "kind": "primitive", "primitive": "cube", "name": "BakeFloor"},
  {"type": "editor.transform.set", "id": "BakeFloor", "position": [300, 199.75, 300], "rotation": [0, 0, 0], "scale": [13, 0.5, 7]},
  {"type": "editor.audio.surface.set", "id": "BakeFloor", "mode": "own", "preset": "concrete"},
  {"type": "editor.entity.create", "kind": "primitive", "primitive": "cube", "name": "BakeCeiling"},
  {"type": "editor.transform.set", "id": "BakeCeiling", "position": [300, 203.25, 300], "rotation": [0, 0, 0], "scale": [13, 0.5, 7]},
  {"type": "editor.audio.surface.set", "id": "BakeCeiling", "mode": "own", "preset": "concrete"},
  {"type": "editor.entity.create", "kind": "primitive", "primitive": "cube", "name": "BakeWest"},
  {"type": "editor.transform.set", "id": "BakeWest", "position": [293.75, 201.5, 300], "rotation": [0, 0, 0], "scale": [0.5, 3, 7]},
  {"type": "editor.audio.surface.set", "id": "BakeWest", "mode": "own", "preset": "concrete"},
  {"type": "editor.entity.create", "kind": "primitive", "primitive": "cube", "name": "BakeEast"},
  {"type": "editor.transform.set", "id": "BakeEast", "position": [306.25, 201.5, 300], "rotation": [0, 0, 0], "scale": [0.5, 3, 7]},
  {"type": "editor.audio.surface.set", "id": "BakeEast", "mode": "own", "preset": "concrete"},
  {"type": "editor.entity.create", "kind": "primitive", "primitive": "cube", "name": "BakeNorth"},
  {"type": "editor.transform.set", "id": "BakeNorth", "position": [300, 201.5, 296.75], "rotation": [0, 0, 0], "scale": [13, 3, 0.5]},
  {"type": "editor.audio.surface.set", "id": "BakeNorth", "mode": "own", "preset": "concrete"},
  {"type": "editor.entity.create", "kind": "primitive", "primitive": "cube", "name": "BakeSouth"},
  {"type": "editor.transform.set", "id": "BakeSouth", "position": [300, 201.5, 303.25], "rotation": [0, 0, 0], "scale": [13, 3, 0.5]},
  {"type": "editor.audio.surface.set", "id": "BakeSouth", "mode": "own", "preset": "concrete"},
  {"type": "editor.entity.create", "kind": "primitive", "primitive": "cube", "name": "BakeDivider"},
  {"type": "editor.transform.set", "id": "BakeDivider", "position": [300, 201.5, 299], "rotation": [0, 0, 0], "scale": [0.5, 3, 5]},
  {"type": "editor.audio.surface.set", "id": "BakeDivider", "mode": "own", "preset": "concrete"},
  {"type": "editor.entity.create", "kind": "empty", "name": "BakeRadio"},
  {"type": "editor.transform.set", "id": "BakeRadio", "position": [303, 201.5, 298], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "editor.component.add", "id": "BakeRadio", "component": "AudioSource"},
  {"type": "editor.audio.source.set", "id": "BakeRadio", "sound": "Assets/Beep.fsound"},
  {"type": "editor.scene.save"},
  {"type": "test.view", "position": [297, 201.5, 298], "target": [297, 201.5, 297]},
  {"type": "test.wait", "frames": 30, "ms": 800},
  {"type": "editor.audio.bake.start"},
  {"type": "test.wait", "frames": 100000, "audioBake": true},
  {"type": "test.expect", "audio": {"bake": {"state": "baked", "probesAbove": 10, "pathing": true}}, "fileExists": ["Scenes/Main.audio/bake.json", "Scenes/Main.audio/probes.bin", "Scenes/Main.audio/probes.pos"]},
  {"type": "test.wait", "frames": 30, "ms": 1000},
  {"type": "test.expect", "audio": {"bake": {"listenerBaked": true}, "reverbAbove": 0.3}},
  {"type": "editor.audio.play", "id": "BakeRadio"},
  {"type": "test.wait", "frames": 40, "ms": 1200},
  {"type": "test.expect", "audio": {"previewing": true, "pathsAbove": 0, "bake": {"pathingAbove": 0}, "source": {"name": "BakeRadio", "occlusionBelow": 0.5, "pathAbove": 0.0}}},
  {"type": "editor.audio.stop"},
  {"type": "test.view", "position": [320, 201.5, 320], "target": [320, 201.5, 319]},
  {"type": "test.wait", "frames": 30, "ms": 1000},
  {"type": "test.expect", "audio": {"bake": {"listenerBaked": false}}},
  {"type": "test.view", "position": [297, 201.5, 298], "target": [297, 201.5, 297]},
  {"type": "editor.transform.set", "id": "BakeDivider", "position": [300, 201.5, 298.5], "rotation": [0, 0, 0], "scale": [0.5, 3, 5]},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.expect", "audio": {"bake": {"state": "stale", "staleWhy": "objects moved"}}},
  {"type": "editor.transform.set", "id": "BakeDivider", "position": [300, 201.5, 299], "rotation": [0, 0, 0], "scale": [0.5, 3, 5]},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.expect", "audio": {"bake": {"state": "baked"}}},
  {"type": "editor.settings.set", "key": "audioReflections", "value": 2},
  {"type": "test.exit"}
]
