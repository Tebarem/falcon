// The modifier stack on a level box: a mirror at its +x face (a box twice as long, the seam welded),
// an array of that (drawn: editor_level_modifiers_drawn), moved up and down the stack, switched off,
// removed in the Inspector, a bevel; the mirror applied into the mesh and undone; saved.
[
  {"type": "test.wait", "frames": 20, "ms": 800},
  {"type": "test.newScene", "name": "Modifiers"},
  {"type": "editor.project.openScene", "scene": "Scenes/Modifiers.fpak"},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.wait", "frames": 100000, "build": true},
  {"type": "test.probe", "rects": ["#viewport"]},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "A"},
  {"type": "editor.transform.set", "id": "A", "position": [0, 0.5, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "editor.frame", "id": "A"},
  {"type": "test.wait", "frames": 30, "ms": 600},
  {"type": "test.capture", "path": "level_modifiers_before.png", "viewport": true},
  {"type": "test.wait", "frames": 3},

  {"type": "editor.level.modifier", "op": "add", "kind": "mirror"},
  {"type": "editor.level.modifier", "op": "set", "index": 0, "offset": 0.5},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "A", "modifiers": 1, "modifierTitles": ["Mirror X"], "levelTriangles": 12, "levelDrawnTriangles": 20}},
  {"type": "editor.level.modifier", "op": "add", "kind": "array"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "A", "modifierTitles": ["Mirror X", "Array"], "levelTriangles": 12, "levelDrawnTriangles": 52}},
  {"type": "test.capture", "path": "level_modifiers_after.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.level.modifier", "op": "up", "index": 1},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "A", "modifierTitles": ["Array", "Mirror X"]}},
  {"type": "editor.level.modifier", "op": "down", "index": 0},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "A", "modifierTitles": ["Mirror X", "Array"], "levelDrawnTriangles": 52}},
  {"type": "editor.level.modifier", "op": "set", "index": 1, "enabled": false},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "A", "modifiers": 2, "levelDrawnTriangles": 20}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "A", "levelDrawnTriangles": 52}},

  {"type": "test.probe", "rects": ["[data-modifier=\"1\"] .modifier-buttons > :last-child"], "reveal": true},
  {"type": "test.wait", "ms": 300},
  {"type": "test.mouse", "at": "[data-modifier=\"1\"] .modifier-buttons > :last-child", "action": "click"},
  {"type": "test.wait", "frames": 10, "ms": 400},
  {"type": "test.expect", "entity": {"name": "A", "modifierTitles": ["Mirror X"], "levelDrawnTriangles": 20}},

  {"type": "editor.level.modifier", "op": "add", "kind": "bevel"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "A", "modifierTitles": ["Mirror X", "Bevel"], "levelDrawnTriangles>": 50}},
  {"type": "editor.frame", "id": "A"},
  {"type": "test.wait", "frames": 20, "ms": 400},
  {"type": "test.capture", "path": "level_modifiers_bevel.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  // Round: 6 segments across each edge.
  {"type": "editor.level.modifier", "op": "set", "index": 1, "segments": 6, "curve": 1},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "A", "levelDrawnTriangles>": 300}},
  {"type": "test.capture", "path": "level_modifiers_bevel_round.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.level.modifier", "op": "remove", "index": 1},
  {"type": "test.wait", "frames": 5, "ms": 200},

  {"type": "editor.level.modifier", "op": "apply"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "A", "modifiers": 0, "levelTriangles": 20, "levelDrawnTriangles": 20}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "A", "modifiers": 1, "levelTriangles": 12, "levelDrawnTriangles": 20}},

  {"type": "editor.scene.save"},
  {"type": "test.wait", "frames": 30, "ms": 800},
  {"type": "editor.project.openScene", "scene": "Scenes/Modifiers.fpak"},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.expect", "entity": {"name": "A", "modifierTitles": ["Mirror X"], "levelTriangles": 12, "levelDrawnTriangles": 20}},
  {"type": "test.exit"}
]
