// Editor test: terrain scatter. The engine starts with a flat terrain covered in cubes
// (--terrain-scatter, so their instance slots exist); a click picks one, deleting it adds an
// exclusion and restoring clears it; a Scatter Mask stroke (real mouse events) marks the ground
// in layer 1's mask, the layer then keeps off it, undo clears the mask again,
// a new density lays every cell out again, and a rock preset adds a layer (and the rock look it
// is shaded with to the material layers).
[
  {"type": "test.view", "position": [40, 6, 45], "target": [40, 0, 35]},
  {"type": "editor.tool.set", "tool": "move"},
  {"type": "test.wait", "frames": 40},
  {"type": "test.expect", "terrain": {"exists": true, "scatter": {"cells": true, "picked": false, "deleted": 0}}},
  {"type": "test.probe", "rects": ["#viewport"]},
  {"type": "test.wait", "frames": 2},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.6, "action": "move"},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.6, "action": "down"},
  {"type": "test.wait", "frames": 2},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.6, "action": "up"},
  {"type": "test.wait", "frames": 10},
  {"type": "test.expect", "terrain": {"scatter": {"picked": true}}},
  {"type": "editor.terrain.scatter.exclude"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "terrain": {"scatter": {"picked": false, "deleted": 1}}},
  {"type": "editor.terrain.scatter.restore", "index": 0},
  {"type": "test.wait", "frames": 3},
  {"type": "test.expect", "terrain": {"scatter": {"deleted": 0}}},
  {"type": "editor.terrain.scatter.set", "index": 0, "paint": 1},
  {"type": "editor.tool.set", "tool": "brush"},
  {"type": "editor.terrain.brush", "op": "scatter", "scatterLayer": 0, "radius": 3, "strength": 1, "falloffPreset": "constant", "noiseMask": 0,
   "slopeMin": 0, "slopeMax": 90, "heightMin": -100000, "heightMax": 100000},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.6, "action": "move"},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.6, "action": "down"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.6, "action": "up"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "canUndo": true, "terrain": {"atStroke": true, "scatterMask": 0, "hole": false}},
  {"type": "test.wait", "frames": 20},
  {"type": "test.capture", "path": "terrain_scatter.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.expect", "terrain": {"atStroke": true, "scatterMaskClear": 0}},
  {"type": "editor.terrain.scatter.set", "index": 0, "density": 0.5},
  {"type": "test.wait", "frames": 10},
  {"type": "test.expect", "terrain": {"scatter": {"cells": true}}},
  {"type": "test.capture", "path": "terrain_scatter_density.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.terrain.scatter.add", "preset": "Boulders"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.expect", "terrain": {"scatter": {"layers": 2, "materialLayers": 1}}},
  {"type": "test.exit"}
]
