// Snap points: a kit piece given one (on its +x side, facing out) and made a prefab; another
// instance, near it and turned about, snapped onto it (Arrange/Snap Together: turned to face it,
// moved), undone, and snapped again by a small gizmo drag. A cut volume made a prefab: an instance
// of it cuts a wall (prefabs carry the level components). Saved and opened again: both still work.
[
  {"type": "test.wait", "frames": 20, "ms": 800},
  {"type": "test.newScene", "name": "Snap"},
  {"type": "editor.project.openScene", "scene": "Scenes/Snap.fpak"},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.wait", "frames": 100000, "build": true},
  {"type": "test.probe", "rects": ["#viewport"]},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "KitPiece"},
  {"type": "editor.transform.set", "id": "KitPiece", "position": [0, 0.5, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "editor.select", "id": "KitPiece"},
  {"type": "editor.level.snapPoint"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "selectedName": "Snap Point", "entity": {"name": "Snap Point", "parent": "KitPiece"}},
  {"type": "editor.transform.set", "id": "Snap Point", "position": [0.5, 0.5, 0], "rotation": [0, 90, 0], "scale": [1, 1, 1]},
  {"type": "editor.prefab.create", "id": "KitPiece", "folder": "Assets"},
  {"type": "test.wait", "frames": 10, "ms": 400},
  {"type": "editor.asset.place", "prefab": "Assets/KitPiece.fprefab"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "selectedName": "KitPiece (1)", "entity": {"name": "KitPiece (1)", "children": 1}},
  {"type": "editor.transform.set", "id": "KitPiece (1)", "position": [1.1, 0.5, 0.1], "rotation": [0, 170, 0], "scale": [1, 1, 1]},
  {"type": "editor.frame", "id": "KitPiece"},
  {"type": "test.wait", "frames": 20, "ms": 400},

  {"type": "editor.select", "id": "KitPiece (1)"},
  {"type": "editor.arrange", "op": "snap"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "KitPiece (1)", "at": [1, 0.5, 0]}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "KitPiece (1)", "at": [1.1, 0.5, 0.1]}},
  {"type": "editor.tool.set", "tool": "move"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.mouse", "at": "@gizmo", "action": "move"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.mouse", "at": "@gizmo", "action": "down"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.mouse", "at": "@gizmo", "dx": 2, "dy": 1, "action": "move"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.mouse", "at": "@gizmo", "dx": 2, "dy": 1, "action": "up"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "KitPiece (1)", "at": [1, 0.5, 0]}},

  {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "SnapWall"},
  {"type": "editor.transform.set", "id": "SnapWall", "position": [0, 1.5, 5], "rotation": [0, 0, 0], "scale": [4, 3, 0.2]},
  {"type": "editor.level.cut.create", "shape": "box", "name": "DoorCut"},
  {"type": "editor.transform.set", "id": "DoorCut", "position": [20, 1, 20], "rotation": [0, 0, 0], "scale": [1, 2.2, 1]},
  {"type": "editor.prefab.create", "id": "DoorCut", "folder": "Assets"},
  {"type": "test.wait", "frames": 10, "ms": 400},
  {"type": "editor.asset.place", "prefab": "Assets/DoorCut.fprefab"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "editor.transform.set", "id": "DoorCut (1)", "position": [0, 1, 5], "rotation": [0, 0, 0], "scale": [1, 2.2, 1]},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "DoorCut (1)", "cut": true}},
  {"type": "test.expect", "entity": {"name": "SnapWall", "levelDrawnTriangles>": 12}},

  {"type": "editor.scene.save"},
  {"type": "test.wait", "frames": 30, "ms": 800},
  {"type": "editor.project.openScene", "scene": "Scenes/Snap.fpak"},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.expect", "entity": {"name": "SnapWall", "levelDrawnTriangles>": 12}},
  {"type": "test.expect", "entity": {"name": "KitPiece (1)", "children": 1, "at": [1, 0.5, 0]}},
  {"type": "editor.transform.set", "id": "KitPiece (1)", "position": [1.1, 0.5, -0.1], "rotation": [0, 185, 0], "scale": [1, 1, 1]},
  {"type": "editor.select", "id": "KitPiece (1)"},
  {"type": "editor.arrange", "op": "snap"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "KitPiece (1)", "at": [1, 0.5, 0]}},
  {"type": "test.exit"}
]
