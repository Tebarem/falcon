// Generated wear: a level box with a metal and a dirt layer, edge wear into the first (bare metal along its
// edges), grime into the second (its foot), each one undo step (editor_level_wear_drawn: the view changes);
// a smart material (Chipped Paint) put on it in one step (its wear and grime live), undone.
[
 {
  "type": "test.wait",
  "frames": 20,
  "ms": 800
 },
 {
  "type": "test.newScene",
  "name": "Wear"
 },
 {
  "type": "editor.project.openScene",
  "scene": "Scenes/Wear.fpak"
 },
 {
  "type": "test.wait",
  "frames": 60,
  "ms": 1500
 },
 {
  "type": "test.wait",
  "frames": 100000,
  "build": true
 },
 {
  "type": "editor.assets.newMaterial",
  "folder": "Assets",
  "name": "Metal"
 },
 {
  "type": "test.wait",
  "frames": 5,
  "ms": 300
 },
 {
  "type": "test.key",
  "key": "Escape"
 },
 {
  "type": "editor.assets.newMaterial",
  "folder": "Assets",
  "name": "Dirt"
 },
 {
  "type": "test.wait",
  "frames": 5,
  "ms": 300
 },
 {
  "type": "test.key",
  "key": "Escape"
 },
 {
  "type": "editor.material.set",
  "path": "Assets/Metal.fmat",
  "values": {
   "baseColor": [
    0.85,
    0.85,
    0.9,
    1
   ],
   "metallic": 1,
   "roughness": 0.3
  }
 },
 {
  "type": "editor.material.set",
  "path": "Assets/Dirt.fmat",
  "values": {
   "baseColor": [
    0.25,
    0.17,
    0.1,
    1
   ],
   "roughness": 0.95
  }
 },
 {
  "type": "test.probe",
  "rects": [
   "#viewport"
  ]
 },
 {
  "type": "test.wait",
  "frames": 2,
  "ms": 200
 },
 {
  "type": "editor.entity.create",
  "kind": "level",
  "shape": "box",
  "name": "A"
 },
 {
  "type": "editor.transform.set",
  "id": "A",
  "position": [
   0,
   0.5,
   0
  ],
  "rotation": [
   0,
   0,
   0
  ],
  "scale": [
   1,
   1,
   1
  ]
 },
 {
  "type": "editor.frame",
  "id": "A"
 },
 {
  "type": "test.wait",
  "frames": 30,
  "ms": 600
 },
 {
  "type": "editor.level.op",
  "op": "layers",
  "args": {
   "materials": [
    "Assets/Metal.fmat",
    "Assets/Dirt.fmat",
    ""
   ]
  }
 },
 {
  "type": "test.wait",
  "frames": 10,
  "ms": 300
 },
 {
  "type": "test.capture",
  "path": "level_wear_before.png",
  "viewport": true
 },
 {
  "type": "test.wait",
  "frames": 3
 },
 {
  "type": "editor.level.mask",
  "op": "wear",
  "channel": 0,
  "width": 0.1
 },
 {
  "type": "test.wait",
  "frames": 20,
  "ms": 500
 },
 {
  "type": "test.expect",
  "entity": {
   "name": "A",
   "levelMask": true,
   "levelMaskMean>": [
    0,
    0.02
   ],
   "levelMaskMean<": [
    0,
    0.6
   ]
  }
 },
 {
  "type": "editor.level.mask",
  "op": "grime",
  "channel": 1,
  "foot": 0.25
 },
 {
  "type": "test.wait",
  "frames": 20,
  "ms": 500
 },
 {
  "type": "test.expect",
  "entity": {
   "name": "A",
   "levelMaskMean>": [
    1,
    0.02
   ]
  }
 },
 {
  "type": "test.capture",
  "path": "level_wear_after.png",
  "viewport": true
 },
 {
  "type": "test.wait",
  "frames": 3
 },
 {
  "type": "editor.undo"
 },
 {
  "type": "test.wait",
  "frames": 3
 },
 {
  "type": "test.expect",
  "entity": {
   "name": "A",
   "levelMaskMean<": [
    1,
    0.001
   ]
  }
 },
 {
  "type": "editor.undo"
 },
 {
  "type": "test.wait",
  "frames": 3
 },
 {
  "type": "test.expect",
  "entity": {
   "name": "A",
   "levelMask": false
  }
 },
 {
  "type": "editor.level.smart.starter"
 },
 {
  "type": "test.wait",
  "frames": 10,
  "ms": 500
 },
 {
  "type": "editor.select",
  "id": "A"
 },
 {
  "type": "editor.level.smart",
  "path": "Assets/Smart/Chipped Paint.fsmart"
 },
 {
  "type": "test.wait",
  "frames": 600,
  "wear": true
 },
 {
  "type": "test.expect",
  "entity": {
   "name": "A",
   "levelLayered": true,
   "levelMask": false,
   "levelWear": 2,
   "levelFaces": {
    "material": "Assets/Smart/Paint.fmat",
    "count": 6
   },
   "levelWearMean>": [
    0,
    0.02
   ]
  }
 },
 {
  "type": "test.capture",
  "path": "level_wear_smart.png",
  "viewport": true
 },
 {
  "type": "test.wait",
  "frames": 3
 },
 {
  "type": "editor.undo"
 },
 {
  "type": "test.wait",
  "frames": 3
 },
 {
  "type": "test.expect",
  "entity": {
   "name": "A",
   "levelMask": false,
   "levelWear": 0,
   "levelFaces": {
    "material": "Assets/Smart/Paint.fmat",
    "count": 0
   }
  }
 },
 {
  "type": "test.exit"
 }
]
