# cmake -DDIR=<folder> -P check_freeze_report.cmake: the freeze report a run wrote there (--test-freeze)
# names the frozen function on the main thread, has the log, and has its minidump beside it (Windows).
file(GLOB reports "${DIR}/freeze-*.txt")
list(LENGTH reports count)
if(NOT count EQUAL 1)
  message(FATAL_ERROR "expected one freeze report in ${DIR}, found ${count}")
endif()
file(READ "${reports}" text)
message("${text}")
string(FIND "${text}" "== Main thread" main)
string(FIND "${text}" "freezewatch::testFreeze" frozen)
string(FIND "${text}" "== The last log lines ==" log)
string(FIND "${text}" "the main thread sleeps" logged)
if(main EQUAL -1 OR frozen EQUAL -1 OR log EQUAL -1 OR logged EQUAL -1)
  message(FATAL_ERROR "the report lacks the main thread's stack at testFreeze or the log")
endif()
string(REGEX REPLACE "\\.txt$" ".dmp" dump "${reports}")
# (Linux and macOS write no minidump: the report says so)
if(NOT EXISTS "${dump}")
  string(FIND "${text}" "no minidump here" nodump)
  if(nodump EQUAL -1)
    message(FATAL_ERROR "no minidump beside ${reports}")
  endif()
  message("freeze report ok (no minidump on this OS)")
  return()
endif()
file(SIZE "${dump}" size)
if(size LESS 10000)
  message(FATAL_ERROR "the minidump ${dump} is ${size} bytes")
endif()
message("freeze report ok (dump ${size} bytes)")
