// Several entities selected in the Hierarchy: a right click on one of them keeps them all, its menu
// acts on all of them (Delete 2 deletes both, one undo step), and so does the Delete key.
[
 {"type": "test.wait", "frames": 20, "ms": 800},
 {"type": "test.newScene", "name": "DeleteMany"},
 {"type": "editor.project.openScene", "scene": "Scenes/DeleteMany.fpak"},
 {"type": "test.wait", "frames": 60, "ms": 1500},
 {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "A"},
 {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "B"},
 {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "C"},
 {"type": "test.wait", "frames": 10, "ms": 300},

 {"type": "editor.select", "ids": ["A", "B"]},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.expect", "selection": ["A", "B"]},
 {"type": "test.probe", "rects": ["#tree .row.selected"]},
 {"type": "test.wait", "ms": 300},
 {"type": "test.mouse", "at": "#tree .row.selected", "button": "right", "action": "down"},
 {"type": "test.wait", "ms": 200},
 {"type": "test.mouse", "at": "#tree .row.selected", "button": "right", "action": "up"},
 {"type": "test.wait", "ms": 300},
 {"type": "test.probe", "rects": [".menu-item:last-child"]},
 {"type": "test.wait", "ms": 300},
 {"type": "test.expect", "probe": {"menuOpen": true, "menuItems": 3}},  // frame, duplicate 2, delete 2
 {"type": "test.expect", "selection": ["A", "B"]},
 {"type": "test.mouse", "at": ".menu-item:last-child"},
 {"type": "test.wait", "frames": 10, "ms": 400},
 {"type": "test.expect", "entity": {"name": "A", "alive": false}},
 {"type": "test.expect", "entity": {"name": "B", "alive": false}},
 {"type": "test.expect", "entity": {"name": "C", "alive": true}},
 {"type": "editor.undo"},
 {"type": "test.wait", "frames": 10, "ms": 300},
 {"type": "test.expect", "entity": {"name": "A", "alive": true}},
 {"type": "test.expect", "entity": {"name": "B", "alive": true}},

 {"type": "editor.select", "ids": ["B", "C"]},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.probe", "rects": ["#tree"]},
 {"type": "test.wait", "ms": 300},
 {"type": "test.key", "key": "Delete"},
 {"type": "test.wait", "frames": 10, "ms": 400},
 {"type": "test.expect", "entity": {"name": "A", "alive": true}},
 {"type": "test.expect", "entity": {"name": "B", "alive": false}},
 {"type": "test.expect", "entity": {"name": "C", "alive": false}},
 {"type": "editor.undo"},
 {"type": "test.wait", "frames": 10, "ms": 300},
 {"type": "test.expect", "entity": {"name": "C", "alive": true}},
 {"type": "test.exit"}
]
