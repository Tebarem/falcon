// The asset library (project/asset_library.h) on Script Test (--no-prefs: My Library is its
// Cache/Library): the Project panel's Library section lists Falcon's materials (read-only) and My
// Library; a Falcon material's picture is its colour texture; rename and delete refused in it.
// Used in the project, a Falcon material is copied with its textures into Assets/Falcon (its paths the
// project's) and put on a level box's face at its real-world size (one undo step); used again, the
// copy (edited since) stays. My Library: a folder, a material and an image made there, a project image
// set as its normal (copied beside it), a rename; Add to Library copies a project material with its
// textures; a My Library material used comes into Assets/Library; nothing moves across roots.
[
 {"type": "test.wait", "frames": 20, "ms": 800},
 {"type": "test.newScene", "name": "Library"},
 {"type": "editor.project.openScene", "scene": "Scenes/Library.fpak"},
 {"type": "test.wait", "frames": 60, "ms": 1500},
 {"type": "test.wait", "frames": 100000, "build": true},
 {"type": "test.wait", "frames": 10, "ms": 300},
 {"type": "test.probe", "rects": [".tab[data-tab=\"project\"]"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.mouse", "at": ".tab[data-tab=\"project\"]"},
 {"type": "test.wait", "frames": 10, "ms": 600},
 {"type": "test.probe", "rects": ["[data-section=\"favorites\"]"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.mouse", "at": "[data-section=\"favorites\"]"},
 {"type": "test.wait", "frames": 3, "ms": 200},
 {"type": "test.probe", "rects": ["[data-section=\"project\"]"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.mouse", "at": "[data-section=\"project\"]"},
 {"type": "test.wait", "frames": 3, "ms": 200},
 {"type": "test.probe", "rects": ["[data-tree=\"@falcon\"]"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"assetsLibraries": "@falcon:ro|@library"}},
 {"type": "test.mouse", "at": "[data-tree=\"@falcon\"]"},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.probe"},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"assetsFolder": "@falcon", "assetsItems": "Brick|Concrete|Ground|Metal|Plaster|Roofing|Tiles|Wood|License"}},
 {"type": "test.probe", "rects": ["[data-key=\"@falcon/Wood\"]"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.mouse", "at": "[data-key=\"@falcon/Wood\"]", "clicks": 2},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.probe"},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"assetsFolder": "@falcon/Wood",
  "assetsItems": "Textures|Brown Planks 03|Dark Wood|Laminate Floor 02|Oak Veneer 01|Old Planks 02|Plywood"}},
 {"type": "test.probe", "rects": ["[data-key=\"@falcon/Wood/Plywood.fmat\"]"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.mouse", "at": "[data-key=\"@falcon/Wood/Plywood.fmat\"]"},
 {"type": "test.wait", "frames": 30, "ms": 1500},
 {"type": "test.probe"},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"assetsInspecting": "@falcon/Wood/Plywood.fmat", "assetsPicture": true}},

 {"type": "editor.assets.rename", "path": "@falcon/Wood/Plywood.fmat", "name": "Ply.fmat"},
 {"type": "editor.assets.delete", "paths": ["@falcon/Wood/Dark Wood.fmat"]},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.expect", "fileExists": ["@falcon/Wood/Plywood.fmat", "@falcon/Wood/Dark Wood.fmat"], "fileMissing": "@falcon/Wood/Ply.fmat"},

 {"type": "test.probe", "rects": ["#viewport"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.mouse", "at": "#viewport", "action": "move"},
 {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "A"},
 {"type": "editor.transform.set", "id": "A", "position": [0, 0, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
 {"type": "editor.frame", "id": "A"},
 {"type": "test.wait", "frames": 60, "ms": 1200},
 {"type": "editor.assets.use", "path": "@falcon/Wood/Plywood.fmat", "id": 1},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.expect", "fileExists": ["Assets/Falcon/Wood/Plywood.fmat", "Assets/Falcon/Wood/Textures/Plywood/color.jpg",
  "Assets/Falcon/Wood/Textures/Plywood/normal.jpg", "Assets/Falcon/Wood/Textures/Plywood/arm.jpg"],
  "fileContains": {"Assets/Falcon/Wood/Plywood.fmat": "\"Assets/Falcon/Wood/Textures/Plywood/color.jpg\""}},
 {"type": "test.expect", "fileExists": "Assets/Falcon/Wood/Textures/Plywood/height.jpg",
  "fileContains": {"Assets/Falcon/Wood/Plywood.fmat": "\"Assets/Falcon/Wood/Textures/Plywood/height.jpg\""}},
 {"type": "test.expect", "fileContains": {"Assets/Falcon/Wood/Plywood.fmat": "\"metallic\": 0,"}},
 {"type": "test.expect", "fileContains": {"Assets/Falcon/Wood/Plywood.fmat": "\"parallax\": 0.002,"}},
 {"type": "editor.material.set", "path": "Assets/Falcon/Wood/Plywood.fmat", "values": {"parallax": 2.5, "displacement": 250}},
 {"type": "test.wait", "frames": 3, "ms": 100},
 {"type": "test.expect", "fileContains": {"Assets/Falcon/Wood/Plywood.fmat": "\"parallax\": 2.5,"}},
 {"type": "test.expect", "fileContains": {"Assets/Falcon/Wood/Plywood.fmat": "\"displacement\": 250,"}},
 {"type": "editor.material.set", "path": "Assets/Falcon/Wood/Plywood.fmat", "values": {"parallax": 0.002, "displacement": 0}},
 {"type": "editor.material.set", "path": "Assets/Falcon/Wood/Plywood.fmat", "values": {"roughnessMin": 0.75}},
 {"type": "test.wait", "frames": 3, "ms": 100},
 {"type": "test.expect", "fileContains": {"Assets/Falcon/Wood/Plywood.fmat": "\"roughnessMin\": 0.75"}},
 {"type": "editor.material.set", "path": "Assets/Falcon/Wood/Plywood.fmat", "values": {"roughnessMin": 3}},
 {"type": "test.wait", "frames": 3, "ms": 100},
 {"type": "test.expect", "fileContains": {"Assets/Falcon/Wood/Plywood.fmat": "\"roughnessMin\": 1"}},
 {"type": "editor.material.set", "path": "Assets/Falcon/Wood/Plywood.fmat", "values": {"roughnessMin": 0}},
 {"type": "editor.asset.assign", "material": "Assets/Falcon/Wood/Plywood.fmat", "at": {"x": 0.5, "y": 0.5}},
 {"type": "test.wait", "frames": 5, "ms": 100},
 {"type": "test.expect", "entity": {"name": "A", "levelFaces": {"material": "Assets/Falcon/Wood/Plywood.fmat", "scale": [0.5, 0.5], "count": 1}}},
 {"type": "editor.undo"},
 {"type": "test.wait", "frames": 3},
 {"type": "test.expect", "entity": {"name": "A", "levelFaces": {"material": "", "scale": [1, 1], "count": 6}}},
 {"type": "editor.level.wall.create", "points": [[-4, 3], [4, 3]], "height": 3, "thickness": 0.2, "name": "W"},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "editor.select", "id": "W"},
 {"type": "test.wait", "frames": 3, "ms": 100},
 {"type": "editor.level.op", "op": "material", "args": {"path": "Assets/Falcon/Wood/Plywood.fmat"}},
 {"type": "test.wait", "frames": 5, "ms": 200},
 {"type": "test.expect", "entity": {"name": "W", "wall": true, "levelFaces": {"material": "", "count": 0}}},
 {"type": "editor.material.set", "path": "Assets/Falcon/Wood/Plywood.fmat", "values": {"baseColor": [0.25, 0.5, 0.75, 1]}},
 {"type": "test.wait", "frames": 3, "ms": 200},
 {"type": "editor.assets.use", "path": "@falcon/Wood/Plywood.fmat", "id": 2},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.expect", "fileContains": {"Assets/Falcon/Wood/Plywood.fmat": "0.75"}},

 {"type": "editor.assets.newFolder", "parent": "@library", "name": "Bricks"},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.key", "key": "Escape"},
 {"type": "editor.assets.newMaterial", "folder": "@library/Bricks", "name": "Red"},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.key", "key": "Escape"},
 {"type": "editor.assets.importFiles", "paths": ["projects/Script Test/Assets/Falcon/Wood/Textures/Plywood/color.jpg"], "folder": "@library/Bricks"},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.expect", "fileExists": ["@library/Bricks", "@library/Bricks/Red.fmat", "@library/Bricks/color.jpg"]},
 {"type": "editor.material.set", "path": "@library/Bricks/Red.fmat",
  "values": {"textures": {"baseColor": "@library/Bricks/color.jpg", "normal": "Assets/Falcon/Wood/Textures/Plywood/normal.jpg"}}},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.expect", "fileExists": "@library/Bricks/normal.jpg"},
 {"type": "editor.assets.rename", "path": "@library/Bricks/Red.fmat", "name": "Brick Red.fmat"},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.expect", "fileExists": "@library/Bricks/Brick Red.fmat", "fileMissing": "@library/Bricks/Red.fmat"},

 {"type": "editor.assets.addToLibrary", "paths": ["Assets/Falcon/Wood/Plywood.fmat"]},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.expect", "fileExists": ["@library/Plywood/Plywood.fmat", "@library/Plywood/Textures/color.jpg", "@library/Plywood/Textures/arm.jpg"],
  "fileMissing": "@library/Plywood/Textures/arm (2).jpg"},
 {"type": "editor.assets.use", "path": "@library/Bricks/Brick Red.fmat", "id": 3},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.expect", "fileExists": ["Assets/Library/Bricks/Brick Red.fmat", "Assets/Library/Bricks/color.jpg", "Assets/Library/Bricks/normal.jpg"],
  "fileContains": {"Assets/Library/Bricks/Brick Red.fmat": "\"Assets/Library/Bricks/normal.jpg\""}},
 {"type": "editor.assets.move", "paths": ["@library/Plywood"], "to": ""},
 {"type": "editor.assets.move", "paths": ["Assets/Library"], "to": "@library"},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.expect", "fileExists": ["@library/Plywood", "Assets/Library"], "fileMissing": ["Plywood", "@library/Library"]},

 {"type": "test.probe", "rects": [".as-crumb[data-drop=\"@library\"]"]},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.mouse", "at": ".as-crumb[data-drop=\"@library\"]"},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.probe"},
 {"type": "test.wait", "frames": 2, "ms": 200},
 {"type": "test.expect", "probe": {"assetsFolder": "@library", "assetsItems": "Bricks|Plywood"}},

 {"type": "editor.assets.delete", "paths": ["Assets/Falcon", "Assets/Library"]},
 {"type": "editor.assets.delete", "paths": ["@library/Bricks", "@library/Plywood"]},
 {"type": "test.wait", "frames": 5, "ms": 300},
 {"type": "test.expect", "fileMissing": ["Assets/Falcon", "Assets/Library", "@library/Bricks", "@library/Plywood"]},
 {"type": "test.exit"}
]
