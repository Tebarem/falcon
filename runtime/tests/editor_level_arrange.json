// Arranging: three boxes aligned to the last selected (min x) and undone, spread evenly along x,
// one dropped onto the ground, two grouped under a new empty and ungrouped again; one made a prefab,
// another replaced with it (where it was), and one placed at the mouse (the prefab shelf's way).
[
  {"type": "test.wait", "frames": 20, "ms": 800},
  {"type": "test.newScene", "name": "Arrange"},
  {"type": "editor.project.openScene", "scene": "Scenes/Arrange.fpak"},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.wait", "frames": 100000, "build": true},
  {"type": "test.probe", "rects": ["#viewport"]},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "A"},
  {"type": "editor.transform.set", "id": "A", "position": [0, 0.5, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "B"},
  {"type": "editor.transform.set", "id": "B", "position": [3, 2, 1], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "ArrangePillar"},
  {"type": "editor.transform.set", "id": "ArrangePillar", "position": [6, 1, -2], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "editor.frame", "id": "B"},
  {"type": "test.wait", "frames": 30, "ms": 600},

  {"type": "editor.select", "ids": ["B", "ArrangePillar", "A"]},
  {"type": "editor.arrange", "op": "align", "axis": 0, "edge": -1},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "B", "at": [0, 2, 1]}},
  {"type": "test.expect", "entity": {"name": "ArrangePillar", "at": [0, 1, -2]}},
  {"type": "test.expect", "entity": {"name": "A", "at": [0, 0.5, 0]}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "B", "at": [3, 2, 1]}},

  {"type": "editor.transform.set", "id": "ArrangePillar", "position": [8, 1, -2], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "editor.select", "ids": ["A", "B", "ArrangePillar"]},
  {"type": "editor.arrange", "op": "distribute", "axis": 0},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "B", "at": [4, 2, 1]}},

  {"type": "editor.select", "id": "B"},
  {"type": "editor.arrange", "op": "ground"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "B", "at": [4, 0.5, 1]}},

  {"type": "editor.select", "ids": ["A", "B"]},
  {"type": "editor.group"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "selectedName": "Group", "entity": {"name": "Group", "at": [2, 0, 0.5]}},
  {"type": "test.expect", "entity": {"name": "A", "parent": "Group", "at": [0, 0.5, 0]}},
  {"type": "test.expect", "entity": {"name": "B", "parent": "Group", "at": [4, 0.5, 1]}},
  {"type": "editor.ungroup"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "A", "parent": "", "at": [0, 0.5, 0]}},
  {"type": "test.expect", "entity": {"name": "Group", "alive": false}},

  {"type": "editor.prefab.create", "id": "ArrangePillar", "folder": "Assets"},
  {"type": "test.wait", "frames": 10, "ms": 400},
  {"type": "editor.select", "id": "A"},
  {"type": "editor.replace", "prefab": "Assets/ArrangePillar.fprefab"},
  {"type": "test.wait", "frames": 10, "ms": 400},
  {"type": "test.expect", "selectedName": "ArrangePillar (1)", "entity": {"name": "ArrangePillar (1)", "prefab": "Assets/ArrangePillar.fprefab", "at": [0, 0.5, 0]}},
  {"type": "test.expect", "entity": {"name": "A", "alive": false}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "A", "alive": true, "at": [0, 0.5, 0]}},

  {"type": "test.mouse", "at": "#viewport", "fx": 0.3, "fy": 0.7, "action": "move"},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.asset.place", "prefab": "Assets/ArrangePillar.fprefab", "atMouse": true},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "selectedName": "ArrangePillar (1)", "entity": {"name": "ArrangePillar (1)", "yAbove": 0.4, "yBelow": 0.6}},
  {"type": "test.exit"}
]
