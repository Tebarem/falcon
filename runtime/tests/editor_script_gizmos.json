 {
  "type": "test.writeFile",
  "path": "UI/beacon.html",
  "text": "<!doctype html>\n<meta charset=\"utf-8\">\n<style>body { margin: 6px; font: 12px sans-serif; color: var(--text, #ddd); background: transparent; }</style>\n<div id=\"label\">Beacon</div>\n<script src=\"falcon-panel.js\"></script>\n<script>\n// editor_script_gizmos: the Beacon's Inspector page; it shows the label and, poked (test.drawer),\n// sets it.\nFalconPanel.onMessage = m => {\n  if (m && m.type === 'values') document.getElementById('label').textContent = 'Beacon ' + (m.values.Label || '');\n  if (m && m.type === 'poke') FalconPanel.send({ set: { Label: 'from page' } });\n};\n</script>\n"
 },
 {
  "type": "test.writeFile",
  "path": "UI/falcon-panel.js",
  "text": "// falcon-panel.js: for a library's editor window page (UI/*.html, opened by an [EditorWindow] C#\n// class). Include it with <script src=\"falcon-panel.js\"></script> (a copy beside the page: a new\n// library gets one).\n//\n//   FalconPanel.send(value)          a JSON value to the window's C# side (EditorWindow.OnMessage)\n//   FalconPanel.onMessage = v => {}  what its C# side sends (EditorWindow.Send)\n//\n// The page takes the editor's colours as CSS variables (--app, --panel, --text, --text-dim,\n// --accent, --line, --field, --button, ...), so `background: var(--panel)` matches the editor.\n'use strict';\nconst FalconPanel = (() => {\n  const panel = {\n    send(value) { parent.postMessage({ falcon: 'panel', data: value === undefined ? null : value }, '*'); },\n    onMessage: null,\n  };\n  addEventListener('message', e => {\n    const m = e.data;\n    if (!m || e.source !== parent) return;\n    if (m.falcon === 'theme') {\n      for (const [name, value] of Object.entries(m.vars || {})) document.documentElement.style.setProperty(name, value);\n      document.documentElement.classList.add('falcon-themed');\n    } else if (m.falcon === 'panel' && panel.onMessage) {\n      panel.onMessage(m.data);\n    }\n  });\n  return panel;\n})();\n"
 },
 {
  "type": "test.writeFile",
  "path": "Scripts/Game.cs",
  "text": "using System.Numerics;\nusing System.Runtime.CompilerServices;\nusing Falcon;\n\nnamespace ScriptTest;\n\n// editor_script_gizmos (API v34): a component's gizmos while editing (a sphere; a box too while\n// selected) and playing, its buttons, and its own Inspector page.\n[InspectorPage(\"beacon.html\", Height = 60)]\npublic sealed class Beacon : Component\n{\n    [Property] public float Radius = 1;\n    [Property] public string Label = \"\";\n\n    [Button] public void Grow() => Radius *= 2;\n    [Button(\"Reset It\")] internal void Reset() => Radius = 1;\n\n    public override void OnDrawGizmos()\n    {\n        Gizmos.Color = new Vector4(1, 0.8f, 0.2f, 1);\n        Gizmos.Sphere(Entity.Position, Radius);\n    }\n\n    public override void OnDrawGizmosSelected() => Gizmos.Box(Entity.Position, new Vector3(Radius));\n}\n\npublic sealed class GizmoGame : Game\n{\n    [ModuleInitializer]\n    internal static void Register() => Register<GizmoGame>();\n}\n"
 },
