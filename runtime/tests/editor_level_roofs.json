// Roofs: Create/Roof over a selected room (a gable over its outline, on top of its walls), made hip
// then flat in the Inspector's way (editor.level.roof), undone, converted to a plain mesh and undone,
// saved and opened again.
[
  {"type": "test.wait", "frames": 20, "ms": 800},
  {"type": "test.newScene", "name": "Roofs"},
  {"type": "editor.project.openScene", "scene": "Scenes/Roofs.fpak"},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.wait", "frames": 100000, "build": true},
  {"type": "test.probe", "rects": ["#viewport"]},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "editor.level.wall.create", "points": [[0, 0], [6, 0], [6, 4], [0, 4]], "closed": true, "height": 3, "name": "Hut"},
  {"type": "test.wait", "frames": 10, "ms": 200},
  {"type": "editor.select", "id": "Hut"},
  {"type": "editor.frame", "id": "Hut"},
  {"type": "test.wait", "frames": 20, "ms": 400},
  {"type": "test.capture", "path": "level_roofs_before.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.tools.run", "menu": "Create/Roof"},
  {"type": "test.wait", "frames": 20, "ms": 400},
  {"type": "test.expect", "entity": {"name": "Roof", "roofStyle": "gable", "levelTriangles": 8, "levelDrawnTriangles": 8}},
  {"type": "test.capture", "path": "level_roofs_after.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.select", "id": "Roof"},
  {"type": "editor.level.roof", "style": "hip"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "entity": {"name": "Roof", "roofStyle": "hip", "levelTriangles": 8}},
  {"type": "editor.level.roof", "style": "flat", "thickness": 0.3},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "entity": {"name": "Roof", "roofStyle": "flat", "levelTriangles": 12}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "entity": {"name": "Roof", "roofStyle": "hip"}},
  {"type": "editor.level.convert"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "entity": {"name": "Roof", "roofStyle": "", "levelTriangles": 8}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "entity": {"name": "Roof", "roofStyle": "hip"}},
  {"type": "editor.scene.save"},
  {"type": "test.wait", "frames": 30, "ms": 800},
  {"type": "editor.project.openScene", "scene": "Scenes/Roofs.fpak"},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.expect", "entity": {"name": "Roof", "roofStyle": "hip", "levelDrawnTriangles": 8}},
  {"type": "test.exit"}
]
