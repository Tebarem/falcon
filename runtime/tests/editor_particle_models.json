// Editor test (VFX Test project): Model Renderers and meshes in spawned prefabs (vfx/runtime_meshes.h).
// "Debris" draws its particles as cubes (the editor keeps slots for the built-in shapes): counted,
// captured with them and without (editor_particle_models_drawn), none drawn with a mesh that has no
// slots ("quad"); a prefab with an effect placed in the editor brings it (and its models). A test game spawns a prefab whose root is a cube with a body and a collider: drawn
// (counted), it falls onto a floor with a Box Collider and rests on it; Stop deletes it.
[
  {"type": "test.wait", "frames": 30, "ms": 1500},
  {"type": "test.view", "position": [20, 2.5, 9], "target": [20, 1, 0]},
  {"type": "editor.entity.create", "kind": "primitive", "primitive": "cube", "name": "ModelFloor"},
  {"type": "test.wait", "frames": 2},
  {"type": "editor.transform.set", "id": "ModelFloor", "position": [20, 0, 0], "rotation": [0, 0, 0], "scale": [12, 1, 6]},
  {"type": "editor.component.add", "id": "ModelFloor", "component": "BoxCollider"},
  {"type": "test.wait", "frames": 20, "ms": 500},
  {"type": "test.capture", "path": "models_off.png", "viewport": true},
  {"type": "test.wait", "frames": 3},

  {"type": "editor.entity.create", "kind": "empty", "name": "Debris"},
  {"type": "test.wait", "frames": 2},
  {"type": "editor.transform.set", "id": "Debris", "position": [18, 2, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "editor.component.add", "id": "Debris", "component": "ParticleEffect"},
  {"type": "editor.component.add", "id": "Debris", "component": "ParticleSphereEmitter"},
  {"type": "editor.component.add", "id": "Debris", "component": "ParticleModelRenderer"},
  {"type": "editor.vfx.set", "id": "Debris", "component": "particleEffect",
   "fields": {"lifetime": 100, "initialScale": 0.3, "rotation": true, "initialPitch": 30, "initialYaw": 45, "yaw": 40,
              "color": true, "tint": [1, 0.45, 0.1, 1]}},
  {"type": "editor.vfx.set", "id": "Debris", "component": "particleSphereEmitter", "fields": {"burst": 24, "rate": 0, "radius": 1.4, "loop": false, "duration": 100}},
  {"type": "editor.vfx.set", "id": "Debris", "component": "particleModel", "fields": {"mesh": "cube"}},
  {"type": "editor.vfx.restart", "id": "Debris"},
  {"type": "test.wait", "frames": 20, "ms": 500},
  {"type": "test.expect", "entity": {"name": "Debris", "particles": 24, "vfx": {"particleModel": {"mesh": "cube", "maxModels": 64}}},
   "runtimeMeshes": {"models>": 23, "starved": 0}},
  {"type": "test.capture", "path": "models_on.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  // At most Max models; a mesh without slots this session: none.
  {"type": "editor.vfx.set", "id": "Debris", "component": "particleModel", "fields": {"maxModels": 10}},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "runtimeMeshes": {"models>": 9, "models<": 11}},
  {"type": "editor.vfx.set", "id": "Debris", "component": "particleModel", "fields": {"mesh": "quad", "maxModels": 64}},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "runtimeMeshes": {"models<": 1}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "runtimeMeshes": {"models>": 9, "models<": 11}},
  {"type": "editor.vfx.set", "id": "Debris", "component": "particleModel", "fields": {"maxModels": 64}},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "runtimeMeshes": {"models>": 23}},

  // A prefab with an effect, placed in the editor: its effect and its models come with it.
  {"type": "test.writeFile", "path": "Assets/Pebbles.fprefab",
   "text": "{\n  \"format\": 1,\n  \"name\": \"Pebbles\",\n  \"entities\": [\n    {\n      \"id\": \"0\",\n      \"name\": \"Pebbles\",\n      \"kind\": \"empty\",\n      \"particleEffect\": {\n        \"lifetime\": 100,\n        \"initialScale\": 0.15\n      },\n      \"particleSphereEmitter\": {\n        \"burst\": 6,\n        \"rate\": 0,\n        \"radius\": 0.5,\n        \"loop\": false,\n        \"duration\": 100\n      },\n      \"particleModel\": {\n        \"mesh\": \"sphere\"\n      }\n    }\n  ]\n}\n"},
  {"type": "editor.asset.place", "prefab": "Assets/Pebbles.fprefab"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "Pebbles", "particles": 6, "vfx": {"particleModel": {"mesh": "sphere"}}},
   "runtimeMeshes": {"models>": 29}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "runtimeMeshes": {"models>": 23, "models<": 25}},

  // A prefab with a mesh, spawned by the game: a falling cube.
  {"type": "test.writeFile", "path": "Assets/Crate.fprefab",
   "text": "{\n  \"format\": 1,\n  \"name\": \"Crate\",\n  \"entities\": [\n    {\n      \"id\": \"0\",\n      \"name\": \"Crate\",\n      \"kind\": \"mesh\",\n      \"mesh\": \"cube\",\n      \"body\": {\"mass\": 2},\n      \"collider\": {\"shape\": \"box\"}\n    }\n  ]\n}\n"},
  {"type": "test.writeFile", "path": "Scripts/Game.cs",
   "text": "using System;\nusing System.Numerics;\nusing System.Runtime.CompilerServices;\nusing Falcon;\n\nnamespace VfxTest;\n\n// Test game: a crate prefab (a cube with a body) spawned in OnStart, falling onto the floor; where it is, on the HUD.\npublic sealed class VfxGame : Game\n{\n    [ModuleInitializer]\n    internal static void Register() => Register<VfxGame>();\n\n    private Entity _crate;\n\n    public override void OnStart()\n    {\n        _crate = Prefab.Spawn(\"Assets/Crate.fprefab\", new Vector3(23f, 4f, 0f), Quaternion.Identity);\n    }\n\n    public override void OnUpdate(float dt)\n    {\n        float y = _crate.IsValid && _crate.IsAlive ? Ecs.Get<WorldTransform>(_crate).Position.Y : -100f;\n        Hud.Show($\"crate {(y > 0.9f && y < 1.1f ? \"rests\" : y > 1.1f ? \"above\" : \"below\")} {y:F2}\");\n    }\n}\n"},
  {"type": "editor.play"},
  {"type": "test.wait", "frames": 100000, "build": true},
  {"type": "test.wait", "frames": 150, "ms": 2500},
  {"type": "test.expect", "playing": true, "hud": "crate rests", "runtimeMeshes": {"spawned": 1}},
  {"type": "test.capture", "path": "models_crate.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.stop"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "playing": false, "runtimeMeshes": {"spawned": 0}},
  {"type": "editor.scene.save"},
  {"type": "test.wait", "frames": 5, "ms": 300},
  {"type": "test.exit"}
]
