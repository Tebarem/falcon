// The scatter brush: a rock made a prefab, scattered over a field along one stroke (under a new
// scatter set, one undo step: undone and redone), kept through a save, then erased with Shift.
[
  {"type": "test.wait", "frames": 20, "ms": 800},
  {"type": "test.newScene", "name": "Scatter"},
  {"type": "editor.project.openScene", "scene": "Scenes/Scatter.fpak"},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.wait", "frames": 100000, "build": true},
  {"type": "test.probe", "rects": ["#viewport"]},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "ScatterRock"},
  {"type": "editor.transform.set", "id": "ScatterRock", "position": [0, 0, 0], "rotation": [0, 0, 0], "scale": [0.3, 0.3, 0.3]},
  {"type": "editor.prefab.create", "id": "ScatterRock", "folder": "Assets"},
  {"type": "test.wait", "frames": 10, "ms": 400},
  {"type": "editor.entity.delete", "id": "ScatterRock"},
  {"type": "editor.entity.create", "kind": "level", "shape": "plane", "name": "Field"},
  {"type": "editor.transform.set", "id": "Field", "position": [0, 0, 0], "rotation": [0, 0, 0], "scale": [3, 1, 3]},
  {"type": "editor.frame", "id": "Field"},
  {"type": "test.wait", "frames": 30, "ms": 600},
  {"type": "editor.select", "id": 0},

  {"type": "editor.tool.set", "tool": "paint", "paintMode": 7, "scatterPrefabs": ["Assets/ScatterRock.fprefab"], "paintRadius": 3,
   "scatterDensity": 0.8, "scatterSpacing": 1.3, "scatterScale": [0.3, 0.5]},
  {"type": "test.wait", "frames": 3},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.35, "fy": 0.55, "action": "move"},
  {"type": "test.wait", "frames": 2},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.35, "fy": 0.55, "action": "down"},
  {"type": "test.wait", "frames": 2},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.55, "action": "move"},
  {"type": "test.wait", "frames": 2},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.65, "fy": 0.55, "action": "move"},
  {"type": "test.wait", "frames": 2},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.65, "fy": 0.55, "action": "up"},
  {"type": "test.wait", "frames": 20, "ms": 500},
  {"type": "test.expect", "selectedName": "Scatter", "entity": {"name": "Scatter", "children>": 3}},
  {"type": "test.capture", "path": "level_scatter.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "Scatter", "alive": false}},
  {"type": "editor.redo"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "Scatter", "alive": true, "children>": 3}},

  {"type": "test.key", "key": "Escape"},
  {"type": "editor.scene.save"},
  {"type": "test.wait", "frames": 30, "ms": 800},
  {"type": "editor.project.openScene", "scene": "Scenes/Scatter.fpak"},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.expect", "entity": {"name": "Scatter", "children>": 3}},

  {"type": "editor.select", "id": "Scatter"},
  {"type": "editor.tool.set", "tool": "paint", "paintMode": 7, "paintRadius": 30},
  {"type": "test.wait", "frames": 3},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.55, "action": "down", "mods": ["shift"]},
  {"type": "test.wait", "frames": 2},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.55, "action": "up", "mods": []},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "Scatter", "children": 0}},
  {"type": "test.exit"}
]
