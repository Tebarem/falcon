// Editor test: scatter layers and meshes added while editing show at once (slots from the
// editor's spare ones, no restart); a layer's randomness (turn range, jitter: an even grid);
// brush mode: the Terrain tab's toggle and operation tiles (real clicks) turn the brush on, the
// viewport shows the brush pill, Escape stops it; Add Mesh in the layer's mesh list; a layer's
// shadows off (scatter_live_noshadow.png); a preset with no ground for its rules (Cliff rocks on flat ground).
[
  {"type": "test.view", "position": [40, 14, 52], "target": [40, 0, 35]},
  {"type": "editor.tool.set", "tool": "move"},
  {"type": "test.wait", "frames": 40},
  {"type": "test.expect", "tool": "move", "terrain": {"exists": true, "scatter": {"cells": true, "subs": 1, "unplaced": 0, "meshes": 1}}},
  {"type": "editor.terrain.scatter.set", "index": 0, "assets": [
    {"mesh": "cube", "weight": 1, "scaleMin": 0.8, "scaleMax": 1.2, "budget": 20000},
    {"mesh": "sphere", "weight": 1, "scaleMin": 0.8, "scaleMax": 1.2, "budget": 20000},
    {"mesh": "cone", "weight": 2, "scaleMin": 0.8, "scaleMax": 1.2, "budget": 20000}]},
  {"type": "test.wait", "frames": 20},
  {"type": "test.expect", "terrain": {"scatter": {"cells": true, "subs": 3, "unplaced": 0, "meshes": 3}}},
  {"type": "test.capture", "path": "scatter_live_meshes.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.terrain.scatter.add", "mesh": "sphere", "density": 0.2},
  {"type": "test.wait", "frames": 20},
  {"type": "test.expect", "terrain": {"scatter": {"layers": 2, "subs": 4, "unplaced": 0}}},
  {"type": "editor.terrain.scatter.set", "index": 0, "yawRange": 0, "jitter": 0},
  {"type": "test.wait", "frames": 20},
  {"type": "test.expect", "terrain": {"scatter": {"yawRange": 0, "jitter": 0, "subs": 4}}},
  {"type": "test.capture", "path": "scatter_live_grid.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.terrain.scatter.set", "index": 0, "castShadows": false},
  {"type": "test.wait", "frames": 30},
  {"type": "test.capture", "path": "scatter_live_noshadow.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.terrain.scatter.set", "index": 0, "castShadows": true},
  {"type": "test.wait", "frames": 10},
  {"type": "editor.terrain.scatter.add", "preset": "Cliff rocks"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.expect", "terrain": {"scatter": {"layers": 3, "nowhere": 2}}},
  {"type": "editor.terrain.scatter.remove", "index": 2},
  {"type": "test.wait", "frames": 5},

  {"type": "test.probe", "rects": ["[data-tab=\"terrain\"]"]},
  {"type": "test.wait", "frames": 2},
  {"type": "test.mouse", "at": "[data-tab=\"terrain\"]", "action": "click"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.probe", "rects": ["[data-brush-toggle]"], "reveal": true},
  {"type": "test.wait", "frames": 2},
  {"type": "test.expect", "probe": {"terrainTab": true, "brushOn": false, "brushPill": false, "scatterMeshes": 3}},
  {"type": "test.mouse", "at": "[data-brush-toggle]", "action": "click"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.probe", "rects": []},
  {"type": "test.wait", "frames": 2},
  {"type": "test.expect", "tool": "brush", "probe": {"brushOn": true, "brushPill": true}},
  {"type": "test.capture", "path": "brush_mode_on.png"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.key", "key": "Escape"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.probe", "rects": ["[data-brush-op=\"smooth\"]"], "reveal": true},
  {"type": "test.wait", "frames": 2},
  {"type": "test.expect", "tool": "move", "probe": {"brushOn": false, "brushPill": false}},
  {"type": "test.mouse", "at": "[data-brush-op=\"smooth\"]", "action": "click"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.probe", "rects": ["[data-scatter-drop] .tbtn.wide"], "reveal": true},
  {"type": "test.wait", "frames": 2},
  {"type": "test.expect", "tool": "brush", "probe": {"brushOn": true, "brushPill": true}},
  {"type": "test.mouse", "at": "[data-scatter-drop] .tbtn.wide", "action": "click"},
  {"type": "test.wait", "frames": 20},
  {"type": "test.probe", "rects": []},
  {"type": "test.wait", "frames": 2},
  {"type": "test.expect", "probe": {"scatterMeshes": 4}, "terrain": {"scatter": {"meshes": 4, "subs": 5, "unplaced": 0}}},
  {"type": "test.capture", "path": "scatter_live_panel.png"},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.terrain.scatter.remove", "index": 1},
  {"type": "test.wait", "frames": 10},
  {"type": "test.expect", "terrain": {"scatter": {"layers": 1, "subs": 4, "unplaced": 0}}},
  {"type": "test.exit"}
]
