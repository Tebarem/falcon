// Expand Bones on the placed bar: its Skeleton and bones under it (one undo step); an empty made
// under the Tip bone follows the bar's bend in Play and comes back on Stop; bones are not renamed
// and the skeleton is not collapsed while something hangs under it; Entity.Find(name, under) (API
// v10) finds the bone under the bar only. Saved for _reload.
[
  {"type": "test.wait", "frames": 20, "ms": 800},
  {"type": "editor.animator.set", "id": "skinned", "params": {"Bent": false, "Speed": 1}},
  {"type": "editor.entity.bones", "id": "skinned", "expand": true},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "Skeleton", "parent": "skinned", "alive": true}},
  {"type": "test.expect", "entity": {"name": "root", "parent": "Skeleton"}},
  {"type": "test.expect", "entity": {"name": "Root", "parent": "root"}},
  {"type": "test.expect", "entity": {"name": "Tip", "parent": "Root"}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "Skeleton", "alive": false}},
  {"type": "editor.redo"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "Tip", "alive": true}},
  {"type": "editor.entity.create", "kind": "empty", "parent": "Tip", "name": "On Tip"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "On Tip", "parent": "Tip"}},
  {"type": "editor.transform.set", "id": "On Tip", "position": [0, 0.5, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1]},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "On Tip", "position": [-0.99996, 1.0, -1.50004]}},
  {"type": "editor.entity.rename", "id": "Tip", "name": "Renamed"},
  {"type": "editor.entity.bones", "id": "skinned", "expand": false},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "Tip", "alive": true}},
  {"type": "test.expect", "entity": {"name": "Skeleton", "alive": true}},
  {"type": "test.writeFile", "path": "Scripts/Game.cs", "text": "using System.Runtime.CompilerServices;\nusing Falcon;\n\nnamespace AnimTest;\n\n// Test game: the bar's Tip bone found under the model (API v10) and under an entity that has no\n// such bone; the bar bends half a second in.\npublic sealed class AnimTestGame : Game\n{\n    float _time;\n\n    [ModuleInitializer]\n    internal static void Register() => Register<AnimTestGame>();\n\n    public override void OnUpdate(float dt)\n    {\n        _time += dt;\n        Entity bar = Entity.Find(\"skinned\");\n        Entity tip = Entity.Find(\"Tip\", bar);\n        Animation.SetBool(bar, Animation.Parameter(bar, \"Bent\"), _time > 0.5f);\n        Hud.Show($\"tip {(tip.IsValid && tip.Id == Entity.Find(\"Tip\").Id ? \"found\" : \"missing\")}, elsewhere {Entity.Find(\"Tip\", Entity.Find(\"On Tip\")).Id}\");\n    }\n}\n"},
  {"type": "editor.play"},
  {"type": "test.wait", "frames": 100000, "build": true},
  {"type": "test.wait", "frames": 5, "ms": 150},
  {"type": "test.expect", "playing": true, "hud": "tip found, elsewhere 0"},
  {"type": "test.expect", "entity": {"name": "On Tip", "yAbove": 0.95}},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.expect", "anim": {"entity": "skinned", "state": "Bent"}},
  {"type": "test.expect", "entity": {"name": "On Tip", "yBelow": 0.95}},
  {"type": "editor.stop"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "playing": false, "entity": {"name": "On Tip", "parent": "Tip", "position": [-0.99996, 1.0, -1.50004]}},
  {"type": "editor.scene.save"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.exit"}
]
