// Splines: a road made along three points (drawn: editor_level_splines_drawn); the Spline tool drags a
// point out (longer, one undo step), adds one at the end and one in between (Ctrl+click), takes one
// out (X over it), closes it (C) and opens it again; the Inspector's Loft made a pipe; a post copied
// along it (the curve modifier, the spline selected with it becoming its parent), undone; saved.
[
  {"type": "test.wait", "frames": 20, "ms": 800},
  {"type": "test.newScene", "name": "Splines"},
  {"type": "editor.project.openScene", "scene": "Scenes/Splines.fpak"},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.wait", "frames": 100000, "build": true},
  {"type": "test.probe", "rects": ["#viewport"]},
  {"type": "test.wait", "frames": 2, "ms": 200},
  {"type": "editor.entity.create", "kind": "level", "shape": "plane", "name": "Ground"},
  {"type": "editor.transform.set", "id": "Ground", "position": [4, -0.2, 2], "rotation": [0, 0, 0], "scale": [1.4, 1, 1.4]},
  {"type": "editor.frame", "id": "Ground"},
  {"type": "test.wait", "frames": 30, "ms": 600},
  {"type": "test.capture", "path": "level_splines_before.png", "viewport": true},
  {"type": "test.wait", "frames": 3},

  {"type": "editor.level.spline.create", "points": [[0, 0, 0], [5, 0, 0], [9, 0, 4]], "profile": "road", "name": "Road"},
  {"type": "test.wait", "frames": 10, "ms": 400},
  {"type": "test.expect", "selectedName": "Road", "entity": {"name": "Road", "splinePoints": 3, "splineProfile": "road", "splineClosed": false,
                                                            "levelDrawnTriangles>": 20, "splineLength>": 10, "splineLength<": 11.5}},
  {"type": "test.capture", "path": "level_splines_after.png", "viewport": true},
  {"type": "test.wait", "frames": 3},

  {"type": "editor.tool.set", "tool": "spline"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.mouse", "at": "@splinePoint:2", "action": "move"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.mouse", "at": "@splinePoint:2", "action": "down"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.mouse", "at": "@splinePoint:2", "dx": 60, "dy": 30, "action": "move"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.mouse", "at": "@splinePoint:2", "action": "up"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "Road", "splinePoints": 3, "splineLength>": 11.5}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "Road", "splineLength<": 11.5}},

  {"type": "test.mouse", "at": "@splinePoint:2", "dx": 80, "dy": 10, "action": "click"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "selectedName": "Road", "entity": {"name": "Road", "splinePoints": 4}},
  {"type": "test.mouse", "at": "@splinePoint:0", "dx": 25, "dy": 18, "action": "click", "mods": ["ctrl"]},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.02, "fy": 0.02, "action": "move", "mods": []},
  {"type": "test.expect", "entity": {"name": "Road", "splinePoints": 5}},
  {"type": "test.mouse", "at": "@splinePoint:1", "action": "move"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.key", "key": "X"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "Road", "splinePoints": 4}},
  {"type": "test.key", "key": "C"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "Road", "splineClosed": true}},
  {"type": "test.key", "key": "C"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "Road", "splineClosed": false}},
  {"type": "test.key", "key": "Escape"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "tool": "move"},

  {"type": "editor.select", "id": ""},
  {"type": "test.wait", "frames": 3, "ms": 100},
  {"type": "test.expect", "outlinesShown": 0},
  {"type": "editor.select", "id": "Road"},
  {"type": "editor.level.spline", "profile": "pipe"},
  {"type": "test.wait", "frames": 3, "ms": 100},
  {"type": "test.expect", "outlinesShown": 1},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "Road", "splineProfile": "pipe", "levelDrawnTriangles>": 100}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "test.expect", "entity": {"name": "Road", "splineProfile": "road"}},

  {"type": "editor.entity.create", "kind": "level", "shape": "box", "name": "Post"},
  {"type": "editor.transform.set", "id": "Post", "position": [0, 0, 0], "rotation": [0, 0, 0], "scale": [0.2, 1, 0.2]},
  {"type": "test.wait", "frames": 5, "ms": 200},
  {"type": "editor.select", "ids": ["Road", "Post"]},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.level.modifier", "op": "add", "kind": "curve", "follow": "copies"},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.level.modifier", "op": "set", "index": 0, "spacing": 2},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "Post", "modifierTitles": ["Copies Along Spline"], "parent": "Road", "levelDrawnTriangles>": 60}},
  {"type": "editor.undo"},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 10, "ms": 300},
  {"type": "test.expect", "entity": {"name": "Post", "modifiers": 0, "levelDrawnTriangles": 12}},
  {"type": "editor.redo"},
  {"type": "editor.redo"},
  {"type": "test.wait", "frames": 10, "ms": 300},

  {"type": "editor.scene.save"},
  {"type": "test.wait", "frames": 30, "ms": 800},
  {"type": "editor.project.openScene", "scene": "Scenes/Splines.fpak"},
  {"type": "test.wait", "frames": 60, "ms": 1500},
  {"type": "test.expect", "entity": {"name": "Road", "splinePoints": 4, "splineProfile": "road", "levelDrawnTriangles>": 20}},
  {"type": "test.expect", "entity": {"name": "Post", "modifierTitles": ["Copies Along Spline"], "levelDrawnTriangles>": 60}},
  {"type": "test.exit"}
]
