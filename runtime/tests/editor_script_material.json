  "playing": true,
  "hud": "material found True apart True read True refused True"
 },
 {
  "type": "test.capture",
  "path": "material_playing.png",
  "viewport": true
 },
 {
  "type": "test.wait",
  "frames": 3
 },
 {
  "type": "editor.stop"
 },
 {
  "type": "test.wait",
  "frames": 60,
  "ms": 1000
 },
 {
  "type": "test.expect",
  "playing": false
 },
 {
  "type": "test.capture",
  "path": "material_after.png",
  "viewport": true
 },
 {
  "type": "test.wait",
  "frames": 3
 },
 {
  "type": "test.exit"
 }
]
