  "material": "Assets/New Material.fmat"
 },
 {
  "type": "editor.frame",
  "id": "Painted"
 },
 {
  "type": "test.writeFile",
  "path": "Scripts/Game.cs",
  "text": "using System;\nusing System.Numerics;\nusing System.Runtime.CompilerServices;\nusing Falcon;\n\nnamespace ScriptTest;\n\n// editor_script_material (API v29): the material both cubes share turned red; Plain's own copy\n// (MaterialInstance) turned blue, the shared one left red; values read back.\npublic sealed class MaterialGame : Game\n{\n    [ModuleInitializer]\n    internal static void Register() => Register<MaterialGame>();\n\n    private string _report = \"\";\n\n    public override void OnStart()\n    {\n        Material shared = Material.Find(\"Assets/New Material.fmat\");\n        bool found = shared.IsValid;\n        shared.BaseColor = new Vector4(1f, 0.05f, 0.05f, 1f);\n        shared.Roughness = 0.9f;\n        Material own = Renderer.MaterialInstance(Entity.Find(\"Plain\"));\n        own.BaseColor = new Vector4(0.05f, 0.1f, 1f, 1f);\n        bool apart = own.IsValid && own.Index != shared.Index;\n        bool read = shared.BaseColor.X > 0.99f && shared.BaseColor.Y < 0.06f && MathF.Abs(shared.Roughness - 0.9f) < 1e-5f &&\n                    own.BaseColor.Z > 0.99f && own.Roughness > 0.89f;  // (the copy took the shared one's values)\n        bool refused = !Material.Find(\"Assets/NoSuch.fmat\").IsValid && !shared.Set(\"noSuchParameter\", Vector4.One);\n        _report = $\"material found {found} apart {apart} read {read} refused {refused}\";\n    }\n\n    public override void OnUpdate(float dt) => Hud.Show(_report);\n}\n"
 },
 {
  "type": "test.wait",
  "frames": 100000,
  "build": true
 },
 {
  "type": "test.wait",
  "frames": 60,
  "ms": 1000
