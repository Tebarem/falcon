// Editor test: terrain generation. A flat terrain; the Rolling hills preset runs on the GPU over
// a few frames (one undo step: undo flattens it again, redo brings the hills back); a square region
// where the camera looks is generated again with a terrace step added; an erosion brush stroke
// (real mouse events) erodes under it when released, and undo takes that back.
[
  {"type": "editor.terrain.create", "tiles": 2, "spacing": 0.5, "heightMin": -200, "heightMax": 800, "hills": 0, "height": 0},
  {"type": "editor.terrain.generate.preset", "name": "Rolling hills"},
  {"type": "editor.terrain.generate.run"},
  {"type": "test.wait", "frames": 3000, "generated": true},
  {"type": "test.expect", "canUndo": true, "terrain": {"generating": false}},
  {"type": "test.expect", "terrain": {"x": 20, "z": -30, ">": 0.5}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.expect", "terrain": {"x": 20, "z": -30, "height": 0, "tolerance": 0.02}},
  {"type": "editor.redo"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.expect", "terrain": {"x": 20, "z": -30, ">": 0.5}},
  {"type": "test.view", "position": [0, 120, 160], "target": [0, 20, 0]},
  {"type": "test.wait", "frames": 2},
  {"type": "editor.terrain.generate.region", "atView": true, "size": 160, "falloff": 32},
  {"type": "editor.terrain.generate.step.add", "op": "terrace", "name": "Terrace", "step": 6, "stepSharpness": 0.9},
  {"type": "editor.terrain.generate.run"},
  {"type": "test.wait", "frames": 3000, "generated": true},
  {"type": "test.expect", "canUndo": true, "terrain": {"generating": false}},
  {"type": "test.wait", "frames": 20},
  {"type": "test.capture", "path": "terrain_generate.png", "viewport": true},
  {"type": "test.wait", "frames": 3},
  {"type": "editor.tool.set", "tool": "brush"},
  {"type": "editor.terrain.brush", "op": "erode", "radius": 20, "strength": 0.5, "falloffPreset": "smooth", "noiseMask": 0,
   "slopeMin": 0, "slopeMax": 90, "heightMin": -100000, "heightMax": 100000},
  {"type": "test.probe", "rects": ["#viewport"]},
  {"type": "test.wait", "frames": 20},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.6, "action": "move"},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.5, "fy": 0.6, "action": "down"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.55, "fy": 0.6, "action": "move"},
  {"type": "test.wait", "frames": 5},
  {"type": "test.mouse", "at": "#viewport", "fx": 0.55, "fy": 0.6, "action": "up"},
  {"type": "test.wait", "frames": 3000, "generated": true},
  {"type": "test.expect", "canUndo": true, "terrain": {"generating": false}},
  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 3},
  {"type": "test.exit"}
]
