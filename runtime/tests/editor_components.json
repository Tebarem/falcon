// Editor test (the project fixture): the Inspector's Add Component. A cube "Lamp" gets a Light
// through the page (real clicks: the button opens the list of what it lacks, typing filters it,
// Enter adds the match); undo takes the Light off again, redo puts it back. An empty "Rig" gets a
// camera by message; one added to Lamp is removed (undo / redo); a light's own Light cannot be
// removed. Searching "coll" lists the colliders. Lamp gets a kinematic Rigidbody (5 kg) and a Mesh
// Collider, Rig a Sphere Collider. Saved: editor_components_reload finds them all.
[
  {"type": "test.wait", "frames": 30, "ms": 1500},
  {"type": "editor.entity.create", "kind": "primitive", "primitive": "cube", "name": "Lamp"},
  {"type": "test.wait", "frames": 3, "ms": 300},
  {"type": "test.expect", "selectedName": "Lamp", "entity": {"name": "Lamp", "lacks": ["Light", "CameraComponent"]}},

  {"type": "test.probe", "rects": ["[data-add-component]"], "reveal": true},
  {"type": "test.wait", "ms": 300},
  {"type": "test.mouse", "at": "[data-add-component]", "action": "click", "clicks": 1},
  {"type": "test.wait", "ms": 400},
  {"type": "test.probe"},
  {"type": "test.wait", "ms": 300},
  {"type": "test.expect", "probe": {"menuOpen": true, "addComponents": "Light,CameraComponent,PhysicsBody,BoxCollider,SphereCollider,CapsuleCollider,MeshCollider,AudioSource,AudioListener,ParticleEffect,ParticleSphereEmitter,ParticleBoxEmitter,ParticleConeEmitter,ParticleRingEmitter,ParticleSpriteRenderer,ParticleTrailRenderer,ParticleLightRenderer,ParticleAttractor,ParticleNoise,ParticleScript,Decal,ParticleModelRenderer", "focus": "input:text"}},
  {"type": "test.type", "text": "lig"},
  {"type": "test.wait", "ms": 300},
  {"type": "test.probe"},
  {"type": "test.wait", "ms": 300},
  {"type": "test.expect", "probe": {"addComponents": "Light,ParticleLightRenderer"}},
  {"type": "test.key", "key": "Return"},
  {"type": "test.wait", "frames": 3, "ms": 400},
  {"type": "test.expect", "canUndo": true, "entity": {"name": "Lamp", "has": ["Light"], "lightType": "point", "lightColor": [1, 1, 1]}},
  {"type": "test.probe"},
  {"type": "test.wait", "ms": 300},
  {"type": "test.expect", "probe": {"menuOpen": false}},

  {"type": "test.probe", "rects": ["[data-add-component]"], "reveal": true},
  {"type": "test.wait", "ms": 300},
  {"type": "test.mouse", "at": "[data-add-component]", "action": "click", "clicks": 1},
  {"type": "test.wait", "ms": 400},
  {"type": "test.probe"},
  {"type": "test.wait", "ms": 300},
  {"type": "test.expect", "probe": {"menuOpen": true, "addComponents": "CameraComponent,PhysicsBody,BoxCollider,SphereCollider,CapsuleCollider,MeshCollider,AudioSource,AudioListener,ParticleEffect,ParticleSphereEmitter,ParticleBoxEmitter,ParticleConeEmitter,ParticleRingEmitter,ParticleSpriteRenderer,ParticleTrailRenderer,ParticleLightRenderer,ParticleAttractor,ParticleNoise,ParticleScript,Decal,ParticleModelRenderer"}},
  {"type": "test.type", "text": "coll"},
  {"type": "test.wait", "ms": 300},
  {"type": "test.probe"},
  {"type": "test.wait", "ms": 300},
  {"type": "test.expect", "probe": {"addComponents": "BoxCollider,SphereCollider,CapsuleCollider,MeshCollider"}},
  {"type": "test.key", "key": "Escape"},
  {"type": "test.wait", "ms": 200},

  {"type": "editor.undo"},
  {"type": "test.wait", "frames": 2},
  {"type": "test.expect", "entity": {"name": "Lamp", "alive": true, "lacks": ["Light"]}},
  {"type": "editor.redo"},
  {"type": "test.wait", "frames": 2},
  {"type": "test.expect", "entity": {"name": "Lamp", "has": ["Light"]}},
  {"type": "editor.light.set", "id": "Lamp", "lightType": "spot", "color": [1, 0.5, 0.2], "intensity": 25},
  {"type": "test.expect", "entity": {"name": "Lamp", "lightType": "spot", "lightColor": [1, 0.5, 0.2]}},

  {"type": "editor.entity.create", "kind": "empty", "name": "Rig"},
  {"type": "editor.component.add", "id": "Rig", "component": "Camera"},
  {"type": "test.expect", "entity": {"name": "Rig", "has": ["CameraComponent"], "lacks": ["Light"]}},
  {"type": "editor.component.add", "id": "Lamp", "component": "Camera"},
  {"type": "test.expect", "entity": {"name": "Lamp", "has": ["Light", "CameraComponent"]}},
  {"type": "editor.component.remove", "id": "Lamp", "component": "Camera"},
  {"type": "test.expect", "entity": {"name": "Lamp", "has": ["Light"], "lacks": ["CameraComponent"]}},
  {"type": "editor.undo"},
  {"type": "test.expect", "entity": {"name": "Lamp", "has": ["Light", "CameraComponent"]}},
  {"type": "editor.redo"},
  {"type": "test.expect", "entity": {"name": "Lamp", "lacks": ["CameraComponent"]}},

  {"type": "editor.component.add", "id": "Lamp", "component": "PhysicsBody"},
  {"type": "editor.body.set", "id": "Lamp", "mass": 5, "kinematic": true},
  {"type": "editor.component.add", "id": "Lamp", "component": "MeshCollider"},
  {"type": "editor.collider.set", "id": "Lamp", "friction": 0.2},
  {"type": "editor.component.add", "id": "Rig", "component": "SphereCollider"},
  {"type": "test.expect", "entity": {"name": "Lamp", "has": ["PhysicsBody", "Collider"], "mass": 5, "collider": "mesh"}},
  {"type": "test.expect", "entity": {"name": "Rig", "lacks": ["PhysicsBody"], "collider": "sphere"}},
  {"type": "editor.entity.create", "kind": "light", "light": "point", "name": "Bulb"},
  {"type": "editor.component.remove", "id": "Bulb", "component": "Light"},
  {"type": "test.expect", "entity": {"name": "Bulb", "has": ["Light"]}},
  {"type": "editor.entity.delete", "id": "Bulb"},

  {"type": "editor.scene.save"},
  {"type": "test.wait", "frames": 5, "ms": 300},
  {"type": "test.exit"}
]
